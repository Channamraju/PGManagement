@model PGManagement.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Login";
}

<link rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<style>

    body {
        background: linear-gradient(135deg, #eef2ff, #f5f3ff);
        min-height: 100vh;
    }

    .login-wrapper {
        min-height: 85vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 30px 15px;
    }

    .login-card {
        width: 100%;
        max-width: 450px;
        background: white;
        border: none;
        border-radius: 24px;
        overflow: hidden;
        box-shadow: 0 20px 50px rgba(0, 0, 0, 0.10);
    }

    .login-header {
        background: linear-gradient(135deg, #4f46e5, #7c3aed);
        color: white;
        text-align: center;
        padding: 35px 25px;
    }

    .login-logo {
        width: 70px;
        height: 70px;
        margin: 0 auto 15px;
        border-radius: 20px;
        background: rgba(255,255,255,.18);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 32px;
        border: 1px solid rgba(255,255,255,.25);
    }

    .login-header h2 {
        font-weight: 700;
        margin-bottom: 5px;
    }

    .login-header p {
        margin: 0;
        opacity: .85;
        font-size: 14px;
    }

    .login-body {
        padding: 30px;
    }

    .form-label {
        font-weight: 600;
        color: #374151;
        margin-bottom: 8px;
    }

    .input-group-text {
        background: #f9fafb;
        border-right: none;
        color: #6b7280;
    }

    .form-control,
    .form-select {
        height: 48px;
        border-color: #e5e7eb;
    }

    .input-group .form-control {
        border-left: none;
    }

    .form-control:focus,
    .form-select:focus {
        border-color: #6366f1;
        box-shadow: 0 0 0 .2rem rgba(99,102,241,.12);
    }

    .password-toggle {
        cursor: pointer;
        background: white;
        border-left: none;
    }

    .login-btn {
        height: 50px;
        border: none;
        border-radius: 12px;
        background: linear-gradient(135deg, #4f46e5, #7c3aed);
        font-weight: 600;
        font-size: 16px;
        transition: .2s;
    }

        .login-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(79,70,229,.25);
        }

    .register-link {
        color: #4f46e5;
        font-weight: 600;
        text-decoration: none;
    }

        .register-link:hover {
            color: #4338ca;
        }

    .validation-summary-errors ul {
        margin-bottom: 0;
        padding-left: 20px;
    }

</style>


<div class="login-wrapper">

    <div class="login-card">

        <!-- HEADER -->

        <div class="login-header">

            <div class="login-logo">
                <i class="bi bi-house-heart-fill"></i>
            </div>

            <h2>PG Management</h2>

            <p>Manage your PG stay easily</p>

        </div>


        <!-- BODY -->

        <div class="login-body">

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success d-flex align-items-center">

                    <i class="bi bi-check-circle-fill me-2"></i>

                    <span>
                        @TempData["Success"]
                    </span>

                </div>
            }


            <form asp-action="Login"
                  method="post">

                @Html.AntiForgeryToken()


                <!-- VALIDATION -->

                <div asp-validation-summary="All"
                     class="text-danger mb-3 validation-summary-errors">
                </div>


                <!-- EMAIL -->

                <div class="mb-3">

                    <label asp-for="Email"
                           class="form-label">

                        Email

                    </label>

                    <div class="input-group">

                        <span class="input-group-text">

                            <i class="bi bi-envelope"></i>

                        </span>

                        <input asp-for="Email"
                               class="form-control"
                               placeholder="Enter your email"
                               autocomplete="email" />

                    </div>

                    <span asp-validation-for="Email"
                          class="text-danger">
                    </span>

                </div>


                <!-- PASSWORD -->

                <div class="mb-3">

                    <label asp-for="Password"
                           class="form-label">

                        Password

                    </label>

                    <div class="input-group">

                        <span class="input-group-text">

                            <i class="bi bi-lock"></i>

                        </span>

                        <input asp-for="Password"
                               type="password"
                               id="password"
                               class="form-control"
                               placeholder="Enter your password"
                               autocomplete="current-password" />

                        <span class="input-group-text password-toggle"
                              onclick="togglePassword()">

                            <i class="bi bi-eye"
                               id="passwordIcon"></i>

                        </span>

                    </div>

                    <span asp-validation-for="Password"
                          class="text-danger">
                    </span>

                </div>


                <!-- LOGIN TYPE -->

                <div class="mb-4">

                    <label asp-for="UserType"
                           class="form-label">

                        Login As

                    </label>

                    <div class="input-group">

                        <span class="input-group-text">

                            <i class="bi bi-person-badge"></i>

                        </span>

                        <select asp-for="UserType"
                                class="form-select">

                            <option value="">
                                -- Select Login Type --
                            </option>

                            <option value="USER">
                                User
                            </option>

                            <option value="OWNER">
                                Owner
                            </option>

                            <option value="ADMIN">
                                Admin
                            </option>

                        </select>

                    </div>

                    <span asp-validation-for="UserType"
                          class="text-danger">
                    </span>

                </div>


                <!-- LOGIN BUTTON -->

                <button type="submit"
                        class="btn btn-primary w-100 login-btn">

                    <i class="bi bi-box-arrow-in-right me-2"></i>

                    Login

                </button>

            </form>


            <!-- REGISTER -->

            <div class="text-center mt-4">

                <span class="text-muted">
                    Don't have an account?
                </span>

                <a asp-action="Register"
                   class="register-link">

                    Register

                </a>

            </div>

        </div>

    </div>

</div>


<script>

    function togglePassword() {

        const password =
            document.getElementById("password");

        const icon =
            document.getElementById("passwordIcon");

        if (password.type === "password") {

            password.type = "text";

            icon.classList.remove("bi-eye");

            icon.classList.add("bi-eye-slash");

        }
        else {

            password.type = "password";

            icon.classList.remove("bi-eye-slash");

            icon.classList.add("bi-eye");

        }

    }

</script>


@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}
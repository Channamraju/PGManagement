@model PGManagement.ViewModels.AdminDashboardViewModel

@{
    ViewData["Title"] = "Admin Dashboard";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Admin Dashboard - PG Management</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <style>

            body {
                background-color: #f5f6fa;
            }

            .sidebar {
                min-height: 100vh;
                background: #212529;
            }

            .sidebar .brand {
                font-size: 22px;
                font-weight: bold;
                padding: 20px;
                color: white;
                border-bottom: 1px solid #343a40;
            }

            .sidebar a {
                display: block;
                color: #adb5bd;
                text-decoration: none;
                padding: 13px 20px;
                transition: 0.2s;
            }

            .sidebar a:hover {
                background-color: #343a40;
                color: white;
            }

            .sidebar a.active {
                background-color: #0d6efd;
                color: white;
            }

            .main-content {
                padding: 25px;
            }

            .dashboard-card {
                border: none;
                border-radius: 12px;
                transition: 0.2s;
            }

            .dashboard-card:hover {
                transform: translateY(-3px);
            }

            .card-icon {
                width: 55px;
                height: 55px;
                border-radius: 10px;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 25px;
            }

            .top-header {
                background: white;
                padding: 15px 25px;
                border-radius: 10px;
                margin-bottom: 25px;
            }

            .stat-number {
                font-size: 30px;
                font-weight: bold;
            }

            .status-card {
                border: none;
                border-radius: 12px;
            }

            @@media (max-width: 768px) {

                .sidebar {
                    min-height: auto;
                }

                .main-content {
                    padding: 15px;
                }
            }

    </style>
</head>

<body>

    <div class="container-fluid">

        <div class="row">

            <!-- SIDEBAR -->
            <div class="col-md-3 col-lg-2 px-0 sidebar">

                <div class="brand text-center">
                    <i class="bi bi-building"></i>
                    PG Management
                </div>

                <div class="mt-3">

                    <a asp-controller="Admin"
                       asp-action="Dashboard"
                       class="active">
                        <i class="bi bi-speedometer2 me-2"></i>
                        Dashboard
                    </a>

                    <a href="#">
                        <i class="bi bi-people me-2"></i>
                        Users
                    </a>

                    <a href="#">
                        <i class="bi bi-person-badge me-2"></i>
                        Owners
                    </a>

                    <a asp-controller="Admin"
                       asp-action="PendingPGs">

                        <i class="bi bi-house-door me-2"></i>
                        PG Management

                    </a>

                    <a href="#">
                        <i class="bi bi-door-open me-2"></i>
                        Rooms
                    </a>

                    <a href="#">
                        <i class="bi bi-credit-card me-2"></i>
                        Payments
                    </a>

                    <a href="#">
                        <i class="bi bi-person-gear me-2"></i>
                        Administrators
                    </a>

                    <hr class="text-secondary mx-3" />

                    <a asp-controller="Account"
                       asp-action="Logout">
                        <i class="bi bi-box-arrow-right me-2"></i>
                        Logout
                    </a>

                </div>

            </div>


            <!-- MAIN CONTENT -->
            <div class="col-md-9 col-lg-10 main-content">

                <!-- HEADER -->
                <div class="top-header d-flex justify-content-between align-items-center">

                    <div>
                        <h3 class="mb-1">
                            Admin Dashboard
                        </h3>

                        <p class="text-muted mb-0">
                            PG Management System
                        </p>
                    </div>

                    <div class="text-end">

                        <span class="badge bg-dark">
                            <i class="bi bi-shield-check"></i>
                            Administrator
                        </span>

                    </div>

                </div>


                <!-- STATISTICS -->
                <div class="row g-4 mb-4">

                    <!-- USERS -->
                    <div class="col-md-6 col-xl-4">

                        <div class="card dashboard-card shadow-sm">

                            <div class="card-body">

                                <div class="d-flex justify-content-between align-items-center">

                                    <div>
                                        <p class="text-muted mb-1">
                                            Total Users
                                        </p>

                                        <div class="stat-number">
                                            @Model.TotalUsers
                                        </div>

                                        <small class="text-success">
                                            <i class="bi bi-person-check"></i>
                                            @Model.ActiveUsers Active
                                        </small>
                                    </div>

                                    <div class="card-icon bg-primary text-white">
                                        <i class="bi bi-people"></i>
                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>


                    <!-- OWNERS -->
                    <div class="col-md-6 col-xl-4">

                        <div class="card dashboard-card shadow-sm">

                            <div class="card-body">

                                <div class="d-flex justify-content-between align-items-center">

                                    <div>

                                        <p class="text-muted mb-1">
                                            Total Owners
                                        </p>

                                        <div class="stat-number">
                                            @Model.TotalOwners
                                        </div>

                                        <small class="text-success">
                                            <i class="bi bi-person-check"></i>
                                            @Model.ActiveOwners Active
                                        </small>

                                    </div>

                                    <div class="card-icon bg-success text-white">
                                        <i class="bi bi-person-badge"></i>
                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>


                    <!-- ADMINS -->
                    <div class="col-md-6 col-xl-4">

                        <div class="card dashboard-card shadow-sm">

                            <div class="card-body">

                                <div class="d-flex justify-content-between align-items-center">

                                    <div>

                                        <p class="text-muted mb-1">
                                            Total Admins
                                        </p>

                                        <div class="stat-number">
                                            @Model.TotalAdmins
                                        </div>

                                        <small class="text-success">
                                            <i class="bi bi-person-check"></i>
                                            @Model.ActiveAdmins Active
                                        </small>

                                    </div>

                                    <div class="card-icon bg-danger text-white">
                                        <i class="bi bi-person-gear"></i>
                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>


                <!-- SYSTEM OVERVIEW -->
                <div class="row g-4">

                    <div class="col-lg-8">

                        <div class="card status-card shadow-sm">

                            <div class="card-header bg-white">

                                <h5 class="mb-0">
                                    <i class="bi bi-bar-chart"></i>
                                    System Overview
                                </h5>

                            </div>

                            <div class="card-body">

                                <!-- USERS -->
                                <div class="mb-4">

                                    <div class="d-flex justify-content-between mb-1">

                                        <span>
                                            <i class="bi bi-people"></i>
                                            Users
                                        </span>

                                        <strong>
                                            @Model.TotalUsers
                                        </strong>

                                    </div>

                                    <div class="progress"
                                         style="height: 10px;">

                                        <div class="progress-bar"
                                             role="progressbar"
                                             style="width: @(Model.TotalUsers > 0 ? 100 : 0)%">
                                        </div>

                                    </div>

                                </div>


                                <!-- OWNERS -->
                                <div class="mb-4">

                                    <div class="d-flex justify-content-between mb-1">

                                        <span>
                                            <i class="bi bi-person-badge"></i>
                                            Owners
                                        </span>

                                        <strong>
                                            @Model.TotalOwners
                                        </strong>

                                    </div>

                                    <div class="progress"
                                         style="height: 10px;">

                                        <div class="progress-bar bg-success"
                                             role="progressbar"
                                             style="width: @(Model.TotalOwners > 0 ? 100 : 0)%">
                                        </div>

                                    </div>

                                </div>


                                <!-- ADMINS -->
                                <div>

                                    <div class="d-flex justify-content-between mb-1">

                                        <span>
                                            <i class="bi bi-person-gear"></i>
                                            Administrators
                                        </span>

                                        <strong>
                                            @Model.TotalAdmins
                                        </strong>

                                    </div>

                                    <div class="progress"
                                         style="height: 10px;">

                                        <div class="progress-bar bg-danger"
                                             role="progressbar"
                                             style="width: @(Model.TotalAdmins > 0 ? 100 : 0)%">
                                        </div>

                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>


                    <!-- QUICK ACTIONS -->
                    <div class="col-lg-4">

                        <div class="card status-card shadow-sm">

                            <div class="card-header bg-white">

                                <h5 class="mb-0">
                                    <i class="bi bi-lightning"></i>
                                    Quick Actions
                                </h5>

                            </div>

                            <div class="card-body">

                                <div class="d-grid gap-2">

                                    <a href="#"
                                       class="btn btn-primary">

                                        <i class="bi bi-people"></i>
                                        Manage Users

                                    </a>

                                    <a href="#"
                                       class="btn btn-success">

                                        <i class="bi bi-person-badge"></i>
                                        Manage Owners

                                    </a>

                                    <a href="#"
                                       class="btn btn-dark">

                                        <i class="bi bi-person-gear"></i>
                                        Manage Admins

                                    </a>

                                    <a href="#"
                                       class="btn btn-outline-danger">

                                        <i class="bi bi-box-arrow-right"></i>
                                        Logout

                                    </a>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>


                <!-- FOOTER -->
                <div class="text-center text-muted mt-4">

                    <small>
                        © @DateTime.Now.Year PG Management System
                    </small>

                </div>

            </div>

        </div>

    </div>


    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
    </script>

</body>
</html>
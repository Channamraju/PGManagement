@model IEnumerable<PGManagement.Models.Booking>

@{
    ViewData["Title"] = "My Bookings";
}

<link rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<div class="container py-4">

    <!-- ================= HEADER ================= -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-calendar-check text-primary"></i>
                My Bookings
            </h2>

            <p class="text-muted mb-0">
                Manage your PG bookings, stay details and payments
            </p>
        </div>

        <a asp-controller="UserPG"
           asp-action="Index"
           class="btn btn-primary">

            <i class="bi bi-search"></i>
            Search PG

        </a>

    </div>


    <!-- ================= SUCCESS MESSAGE ================= -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">

            <i class="bi bi-check-circle-fill"></i>

            @TempData["Success"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    <!-- ================= ERROR MESSAGE ================= -->
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">

            <i class="bi bi-exclamation-triangle-fill"></i>

            @TempData["Error"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    <!-- ================= EMPTY STATE ================= -->
    @if (Model == null || !Model.Any())
    {
        <div class="card border-0 shadow-sm empty-card">

            <div class="card-body text-center py-5">

                <div class="empty-icon mb-3">
                    <i class="bi bi-calendar-x"></i>
                </div>

                <h4 class="fw-bold">
                    No bookings yet
                </h4>

                <p class="text-muted">
                    You haven't booked a bed yet.
                    Find a PG and book your preferred bed.
                </p>

                <a asp-controller="UserPG"
                   asp-action="Index"
                   class="btn btn-primary px-4">

                    <i class="bi bi-search"></i>
                    Find a PG

                </a>

            </div>

        </div>
    }
    else
    {

        <!-- ================= BOOKINGS ================= -->

        <div class="row g-4">

            @foreach (var booking in Model)
            {

                var successfulPayments = booking.Payments?
                    .Where(p => p.Status == "Success")
                    .OrderByDescending(p => p.PaymentDate)
                    .ToList()
                    ?? new List<PGManagement.Models.Payment>();


                var latestPayment = successfulPayments.FirstOrDefault();


                var monthlyPayments = successfulPayments
                    .Where(p => p.PaymentType == "Monthly")
                    .ToList();


                string statusClass = "bg-secondary";

                string statusIcon = "bi-info-circle";


                if (booking.Status == "Pending")
                {
                    statusClass = "bg-warning text-dark";
                    statusIcon = "bi-hourglass-split";
                }
                else if (booking.Status == "Confirmed")
                {
                    statusClass = "bg-success";
                    statusIcon = "bi-check-circle";
                }
                else if (booking.Status == "Cancelled")
                {
                    statusClass = "bg-danger";
                    statusIcon = "bi-x-circle";
                }
                else if (booking.Status == "Completed")
                {
                    statusClass = "bg-primary";
                    statusIcon = "bi-check2-all";
                }


                <div class="col-12">

                    <div class="booking-card">


                        <!-- ================= BOOKING HEADER ================= -->

                        <div class="booking-header">

                            <div>

                                <h4 class="fw-bold mb-1">

                                    @(booking.PG?.PGName ?? "PG")

                                </h4>

                                <div class="text-muted">

                                    <i class="bi bi-geo-alt"></i>

                                    @(booking.PG?.City ?? "Location unavailable")

                                </div>

                            </div>


                            <span class="badge @statusClass status-badge">

                                <i class="bi @statusIcon"></i>

                                @booking.Status

                            </span>

                        </div>


                        <!-- ================= STAY TYPE ================= -->

                        <div class="stay-type-box mt-3">

                            <div class="stay-type-left">

                                @if (booking.StayType == "Daily")
                                {

                                    <div class="stay-icon daily">

                                        <i class="bi bi-calendar-day"></i>

                                    </div>

                                    <div>

                                        <small>
                                            Stay Type
                                        </small>

                                        <strong>
                                            Daily Stay
                                        </strong>

                                    </div>

                                }
                                else
                                {

                                    <div class="stay-icon monthly">

                                        <i class="bi bi-calendar-month"></i>

                                    </div>

                                    <div>

                                        <small>
                                            Stay Type
                                        </small>

                                        <strong>
                                            Monthly Stay
                                        </strong>

                                    </div>

                                }

                            </div>


                            <div class="stay-dates">

                                <div>

                                    <small>
                                        Start Date
                                    </small>

                                    <strong>
                                        @booking.StartDate.ToString("dd MMM yyyy")
                                    </strong>

                                </div>


                                @if (booking.StayType == "Daily" &&
                                     booking.EndDate.HasValue)
                                {

                                    <div>

                                        <small>
                                            End Date
                                        </small>

                                        <strong>
                                            @booking.EndDate.Value.ToString("dd MMM yyyy")
                                        </strong>

                                    </div>

                                }
                                else
                                {

                                    <div>

                                        <small>
                                            End Date
                                        </small>

                                        <strong>
                                            Monthly
                                        </strong>

                                    </div>

                                }

                            </div>

                        </div>


                        <!-- ================= BOOKING DETAILS ================= -->

                        <div class="row g-3 mt-2">


                            <!-- ROOM -->

                            <div class="col-md-3 col-sm-6">

                                <div class="detail-box">

                                    <i class="bi bi-door-open"></i>

                                    <div>

                                        <small>
                                            Room
                                        </small>

                                        <strong>
                                            @(booking.Room?.RoomNumber ?? "-")
                                        </strong>

                                    </div>

                                </div>

                            </div>


                            <!-- BED -->

                            <div class="col-md-3 col-sm-6">

                                <div class="detail-box">

                                    <i class="bi bi-bed"></i>

                                    <div>

                                        <small>
                                            Bed
                                        </small>

                                        <strong>
                                            @(booking.Bed?.BedNumber ?? "-")
                                        </strong>

                                    </div>

                                </div>

                            </div>


                            <!-- RENT -->

                            <div class="col-md-3 col-sm-6">

                                <div class="detail-box">

                                    <i class="bi bi-currency-rupee"></i>

                                    <div>

                                        @if (booking.StayType == "Daily")
                                        {

                                            <small>
                                                Daily Rent
                                            </small>

                                            <strong>
                                                ₹@(booking.Room != null
                                                                                                    ? booking.Room.DailyRent.ToString("N0")
                                                                                                    : "0")
                                            </strong>

                                        }
                                        else
                                        {

                                            <small>
                                                Monthly Rent
                                            </small>

                                            <strong>
                                                ₹@(booking.Room != null
                                                                                                    ? booking.Room.MonthlyRent.ToString("N0")
                                                                                                    : "0")
                                            </strong>

                                        }

                                    </div>

                                </div>

                            </div>


                            <!-- TOTAL -->

                            <div class="col-md-3 col-sm-6">

                                <div class="detail-box total-box">

                                    <i class="bi bi-wallet2"></i>

                                    <div>

                                        <small>
                                            Booking Amount
                                        </small>

                                        <strong>
                                            ₹@booking.TotalAmount.ToString("N0")
                                        </strong>

                                    </div>

                                </div>

                            </div>

                        </div>


                        <!-- ================= BOOKING DATE ================= -->

                        <div class="booking-date mt-3">

                            <i class="bi bi-calendar3"></i>

                            <span>

                                Booking requested on

                                <strong>
                                    @booking.BookingDate.ToString("dd MMM yyyy hh:mm tt")
                                </strong>

                            </span>

                        </div>


                        <!-- ================= PAYMENT HISTORY ================= -->
                        @if (successfulPayments.Any())
                        {

                            <div class="payment-history mt-4">


                                <div class="payment-history-header">

                                    <div>

                                        <h5 class="fw-bold mb-1">

                                            <i class="bi bi-credit-card text-success"></i>

                                            Payment History

                                        </h5>

                                        <small class="text-muted">

                                            @successfulPayments.Count
                                            payment(s) completed

                                        </small>

                                    </div>

                                </div>


                                <div class="table-responsive">

                                    <table class="table payment-table mb-0">

                                        <thead>

                                            <tr>

                                                <th>
                                                    Type
                                                </th>

                                                <th>
                                                    Payment Period
                                                </th>

                                                <th>
                                                    Amount
                                                </th>

                                                <th>
                                                    Transaction
                                                </th>

                                                <th>
                                                    Payment Date
                                                </th>

                                                <th>
                                                </th>

                                            </tr>

                                        </thead>


                                        <tbody>

                                            @foreach (var payment in successfulPayments)
                                            {

                                                <tr>


                                                    <!-- PAYMENT TYPE -->

                                                    <td>

                                                        @if (payment.PaymentType == "Daily")
                                                        {

                                                            <span class="payment-type daily-type">

                                                                <i class="bi bi-calendar-day"></i>

                                                                Daily

                                                            </span>

                                                        }
                                                        else
                                                        {

                                                            <span class="payment-type monthly-type">

                                                                <i class="bi bi-calendar-month"></i>

                                                                Monthly

                                                            </span>

                                                        }

                                                    </td>


                                                    <!-- PERIOD -->

                                                    <td>

                                                        @if (payment.FromDate.HasValue &&
                                                             payment.ToDate.HasValue)
                                                        {

                                                            <span>

                                                                @payment.FromDate.Value.ToString("dd MMM yyyy")

                                                                -

                                                                @payment.ToDate.Value.ToString("dd MMM yyyy")

                                                            </span>

                                                        }
                                                        else if (payment.BillingMonth.HasValue)
                                                        {

                                                            <span>

                                                                @payment.BillingMonth.Value.ToString("MMM yyyy")

                                                            </span>

                                                        }
                                                        else
                                                        {

                                                            <span>
                                                                -
                                                            </span>

                                                        }

                                                    </td>


                                                    <!-- AMOUNT -->

                                                    <td>

                                                        <strong>

                                                            ₹@payment.Amount.ToString("N0")

                                                        </strong>

                                                    </td>


                                                    <!-- TRANSACTION -->

                                                    <td>

                                                        <small class="transaction-id">

                                                            @payment.TransactionId

                                                        </small>

                                                    </td>


                                                    <!-- PAYMENT DATE -->

                                                    <td>

                                                        @payment.PaymentDate.ToString("dd MMM yyyy")

                                                    </td>


                                                    <!-- DETAILS -->

                                                    <td class="text-end">

                                                        <a asp-controller="Payment"
                                                           asp-action="Details"
                                                           asp-route-id="@payment.PaymentId"
                                                           class="btn btn-outline-primary btn-sm">

                                                            <i class="bi bi-receipt"></i>

                                                        </a>

                                                    </td>

                                                </tr>

                                            }

                                        </tbody>

                                    </table>

                                </div>

                            </div>

                        }


                        <!-- ================= PENDING ================= -->
                        @if (booking.Status == "Pending")
                        {

                            <div class="pending-box mt-4">

                                <div>

                                    <i class="bi bi-hourglass-split"></i>

                                    <div>

                                        <strong>
                                            Waiting for Approval
                                        </strong>

                                        <small>

                                            Your booking request is waiting
                                            for owner approval.

                                        </small>

                                    </div>

                                </div>

                            </div>

                        }


                        <!-- ================= CONFIRMED ================= -->
                        @if (booking.Status == "Confirmed")
                        {

                            <div class="payment-box mt-4">

                                <div>

                                    <i class="bi bi-credit-card-fill"></i>

                                    <div>


                                        <!-- MONTHLY -->
                                        @if (booking.StayType == "Monthly")
                                        {

                                            @if (latestPayment == null)
                                            {

                                                <strong>
                                                    First Month Payment Required
                                                </strong>

                                                <small>

                                                    Your booking has been approved.
                                                    Complete the payment for your first month.

                                                </small>

                                            }
                                            else
                                            {

                                                var paidMonths = monthlyPayments.Count;

                                                var nextPaymentDate =
                                                    booking.StartDate.AddMonths(paidMonths);


                                                @if (DateTime.Today >= nextPaymentDate)
                                                {

                                                    <strong>
                                                        Next Month Payment Due
                                                    </strong>

                                                    <small>

                                                        Your next monthly payment is now due.

                                                    </small>

                                                }
                                                else
                                                {

                                                    <strong>
                                                        Monthly Payment Active
                                                    </strong>

                                                    <small>

                                                        Latest payment:
                                                        ₹@latestPayment.Amount.ToString("N0").

                                                        Next payment due on

                                                        <strong>
                                                            @nextPaymentDate.ToString("dd MMM yyyy")
                                                        </strong>

                                                    </small>

                                                }

                                            }

                                        }
                                        else
                                        {

                                            <!-- DAILY -->
                                            @if (latestPayment == null)
                                            {

                                                <strong>
                                                    Payment Required
                                                </strong>

                                                <small>

                                                    Your daily stay has been approved.
                                                    Complete your payment now.

                                                </small>

                                            }
                                            else
                                            {

                                                <strong>
                                                    Payment Completed
                                                </strong>

                                                <small>

                                                    Your daily booking payment has been completed.

                                                </small>

                                            }

                                        }

                                    </div>

                                </div>


                                <!-- ================= PAYMENT BUTTON ================= -->
                                @if (booking.StayType == "Monthly")
                                {

                                    @if (latestPayment == null)
                                    {

                                        <a asp-controller="Payment"
                                           asp-action="Create"
                                           asp-route-bookingId="@booking.BookingId"
                                           class="btn btn-success">

                                            <i class="bi bi-credit-card"></i>

                                            Pay First Month

                                        </a>

                                    }
                                    else
                                    {

                                        var paidMonths = monthlyPayments.Count;

                                        var nextPaymentDate =
                                            booking.StartDate.AddMonths(paidMonths);


                                        @if (DateTime.Today >= nextPaymentDate)
                                        {

                                            <a asp-controller="Payment"
                                               asp-action="Create"
                                               asp-route-bookingId="@booking.BookingId"
                                               class="btn btn-success">

                                                <i class="bi bi-credit-card"></i>

                                                Pay Next Month

                                            </a>

                                        }
                                        else
                                        {

                                            <span class="next-payment-date">

                                                <i class="bi bi-calendar-check"></i>

                                                Next payment:

                                                <strong>
                                                    @nextPaymentDate.ToString("dd MMM yyyy")
                                                </strong>

                                            </span>

                                        }

                                    }

                                }
                                else if (latestPayment == null)
                                {

                                    <a asp-controller="Payment"
                                       asp-action="Create"
                                       asp-route-bookingId="@booking.BookingId"
                                       class="btn btn-success">

                                        <i class="bi bi-credit-card"></i>

                                        Pay Now

                                    </a>

                                }

                            </div>

                        }


                        <!-- ================= COMPLETED ================= -->
                        @if (booking.Status == "Completed")
                        {

                            <div class="completed-box mt-4">

                                <div>

                                    <i class="bi bi-check-circle-fill"></i>

                                    <div>

                                        <strong>
                                            Booking Completed
                                        </strong>

                                        <small>
                                            This booking has been completed.
                                        </small>

                                    </div>

                                </div>

                            </div>

                        }


                        <!-- ================= CANCELLED ================= -->
                        @if (booking.Status == "Cancelled")
                        {

                            <div class="cancelled-box mt-4">

                                <div>

                                    <i class="bi bi-x-circle-fill"></i>

                                    <div>

                                        <strong>
                                            Booking Cancelled
                                        </strong>

                                        <small>
                                            This booking is no longer active.
                                        </small>

                                    </div>

                                </div>

                            </div>

                        }


                        <!-- ================= ACTIONS ================= -->

                        <div class="booking-actions mt-4">


                            @if (booking.Status == "Pending" ||
                                 booking.Status == "Confirmed")
                            {

                                <form asp-controller="Booking"
                                      asp-action="Cancel"
                                      asp-route-id="@booking.BookingId"
                                      method="post"
                                      class="d-inline"
                                      onsubmit="return confirm('Are you sure you want to cancel this booking?');">

                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="btn btn-outline-danger">

                                        <i class="bi bi-x-circle"></i>

                                        Cancel Booking

                                    </button>

                                </form>

                            }


                            @if (booking.Status == "Cancelled")
                            {

                                <form asp-controller="Booking"
                                      asp-action="Delete"
                                      asp-route-id="@booking.BookingId"
                                      method="post"
                                      class="d-inline"
                                      onsubmit="return confirm('Delete this cancelled booking?');">

                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="btn btn-outline-danger">

                                        <i class="bi bi-trash"></i>

                                        Delete

                                    </button>

                                </form>

                            }

                        </div>


                    </div>

                </div>

            }

        </div>

    }

</div>


<style>

    /* ================= BOOKING CARD ================= */

    .booking-card {
        background: #ffffff;
        border-radius: 20px;
        padding: 24px;
        border: 1px solid #e9ecef;
        box-shadow: 0 5px 20px rgba(0,0,0,.06);
        transition: .25s ease;
    }


        .booking-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 30px rgba(0,0,0,.10);
        }


    /* ================= HEADER ================= */

    .booking-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
        padding-bottom: 18px;
        border-bottom: 1px solid #eee;
    }


    .status-badge {
        padding: 9px 14px;
        border-radius: 30px;
        font-size: 13px;
    }


    /* ================= STAY TYPE ================= */

    .stay-type-box {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        padding: 15px 18px;
        background: #f8f9fa;
        border-radius: 14px;
    }


    .stay-type-left {
        display: flex;
        align-items: center;
        gap: 12px;
    }


    .stay-icon {
        width: 45px;
        height: 45px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 21px;
    }


        .stay-icon.monthly {
            background: #e7f1ff;
            color: #0d6efd;
        }


        .stay-icon.daily {
            background: #fff3cd;
            color: #997404;
        }


    .stay-type-left small,
    .stay-dates small {
        display: block;
        color: #6c757d;
        font-size: 12px;
    }


    .stay-type-left strong {
        display: block;
        margin-top: 2px;
    }


    .stay-dates {
        display: flex;
        gap: 35px;
    }


        .stay-dates strong {
            display: block;
            margin-top: 2px;
        }


    /* ================= DETAILS ================= */

    .detail-box {
        display: flex;
        align-items: center;
        gap: 12px;
        background: #f8f9fa;
        border-radius: 12px;
        padding: 13px;
        height: 100%;
    }


        .detail-box > i {
            font-size: 22px;
            color: #0d6efd;
        }


        .detail-box small {
            display: block;
            color: #6c757d;
            font-size: 12px;
        }


        .detail-box strong {
            display: block;
            margin-top: 2px;
        }


    .total-box {
        background: #eef7ff;
    }


    /* ================= BOOKING DATE ================= */

    .booking-date {
        display: flex;
        align-items: center;
        gap: 8px;
        color: #6c757d;
        font-size: 14px;
    }


    /* ================= PAYMENT HISTORY ================= */

    .payment-history {
        border: 1px solid #e5e7eb;
        border-radius: 15px;
        overflow: hidden;
    }


    .payment-history-header {
        padding: 15px 18px;
        background: #f8f9fa;
        border-bottom: 1px solid #e5e7eb;
    }


    .payment-table {
        vertical-align: middle;
    }


        .payment-table th {
            background: #fafafa;
            font-size: 13px;
            color: #6c757d;
            white-space: nowrap;
        }


        .payment-table td {
            font-size: 14px;
            white-space: nowrap;
        }


    .payment-type {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 5px 9px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
    }


    .monthly-type {
        background: #e7f1ff;
        color: #0d6efd;
    }


    .daily-type {
        background: #fff3cd;
        color: #856404;
    }


    .transaction-id {
        max-width: 150px;
        display: inline-block;
        overflow: hidden;
        text-overflow: ellipsis;
    }


    /* ================= PAYMENT BOX ================= */

    .payment-box {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
        padding: 16px 18px;
        border-radius: 14px;
        background: #f0fff4;
        border: 1px solid #b7ebc6;
    }


        .payment-box > div {
            display: flex;
            align-items: center;
            gap: 12px;
        }


            .payment-box > div > i {
                font-size: 25px;
                color: #198754;
            }


        .payment-box small {
            display: block;
            color: #6c757d;
            margin-top: 2px;
        }


    /* ================= NEXT PAYMENT ================= */

    .next-payment-date {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 9px 14px;
        border-radius: 10px;
        background: #e7f1ff;
        color: #0d6efd;
        font-size: 14px;
        white-space: nowrap;
    }


        .next-payment-date i {
            color: #0d6efd;
        }


    /* ================= PENDING ================= */

    .pending-box {
        padding: 16px 18px;
        border-radius: 14px;
        background: #fff8e1;
        border: 1px solid #ffe69c;
    }


        .pending-box > div {
            display: flex;
            align-items: center;
            gap: 12px;
        }


        .pending-box i {
            color: #997404;
            font-size: 23px;
        }


        .pending-box small,
        .completed-box small,
        .cancelled-box small {
            display: block;
            color: #6c757d;
            margin-top: 2px;
        }


    /* ================= COMPLETED ================= */

    .completed-box {
        padding: 16px 18px;
        border-radius: 14px;
        background: #eef7ff;
        border: 1px solid #b6d9ff;
    }


        .completed-box > div {
            display: flex;
            align-items: center;
            gap: 12px;
        }


        .completed-box i {
            color: #0d6efd;
            font-size: 23px;
        }


    /* ================= CANCELLED ================= */

    .cancelled-box {
        padding: 16px 18px;
        border-radius: 14px;
        background: #fff5f5;
        border: 1px solid #f5c2c7;
    }


        .cancelled-box > div {
            display: flex;
            align-items: center;
            gap: 12px;
        }


        .cancelled-box i {
            color: #dc3545;
            font-size: 23px;
        }


    /* ================= ACTIONS ================= */


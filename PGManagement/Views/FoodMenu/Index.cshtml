@model IEnumerable<PGManagement.Models.FoodMenu>

@{
    ViewData["Title"] = "Food Menu";
}

<div class="container py-4">

    <!-- Header -->
    <div class="menu-header">

        <div class="menu-title-area">

            <div class="menu-icon">
                <i class="bi bi-egg-fried"></i>
            </div>

            <div>
                <h2>Food Menu</h2>
                <p>Check the available food menu for each day</p>
            </div>

        </div>

        <a asp-controller="Booking"
           asp-action="MyBookings"
           class="btn btn-primary">
            <i class="bi bi-calendar-check"></i>
            My Bookings
        </a>

    </div>


    <!-- Messages -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="bi bi-check-circle-fill"></i>
            @TempData["Success"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="bi bi-exclamation-triangle-fill"></i>
            @TempData["Error"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>
        </div>
    }


    @if (!Model.Any())
    {
        <!-- Empty State -->

        <div class="empty-card">

            <div class="empty-icon">
                <i class="bi bi-egg-fried"></i>
            </div>

            <h3>No Food Menu Available</h3>

            <p>
                There are currently no food items available.
                Please check again later.
            </p>

            <a asp-controller="UserPG"
               asp-action="Index"
               class="btn btn-primary">
                <i class="bi bi-search"></i>
                Search PGs
            </a>

        </div>
    }
    else
    {
        <!-- Food Menu -->

        <div class="menu-grid">

            @foreach (var item in Model)
            {
                <div class="food-card">

                    <!-- Food Icon -->

                    <div class="food-image">

                        @if (item.MealType == "Breakfast")
                        {
                            <i class="bi bi-cup-hot-fill"></i>
                        }
                        else if (item.MealType == "Lunch")
                        {
                            <i class="bi bi-egg-fried"></i>
                        }
                        else if (item.MealType == "Dinner")
                        {
                            <i class="bi bi-bowl-hot-fill"></i>
                        }
                        else
                        {
                            <i class="bi bi-cookie"></i>
                        }

                    </div>


                    <!-- Content -->

                    <div class="food-content">

                        <!-- Day + Meal -->

                        <div class="food-top">

                            <span class="day-badge">
                                <i class="bi bi-calendar-week"></i>
                                @item.DayOfWeek
                            </span>

                            <span class="meal-badge">
                                @item.MealType
                            </span>

                        </div>


                        <!-- Availability -->

                        <div class="availability">

                            @if (item.IsAvailable)
                            {
                                <span class="available">
                                    <i class="bi bi-check-circle-fill"></i>
                                    Available
                                </span>
                            }
                            else
                            {
                                <span class="unavailable">
                                    <i class="bi bi-x-circle-fill"></i>
                                    Unavailable
                                </span>
                            }

                        </div>


                        <!-- Food Name -->

                        <h4>
                            @item.ItemName
                        </h4>


                        <!-- Description -->
                        @if (!string.IsNullOrWhiteSpace(item.Description))
                        {
                            <p class="description">
                                @item.Description
                            </p>
                        }
                        else
                        {
                            <p class="description empty-description">
                                No description available.
                            </p>
                        }


                        <!-- Footer -->

                        <div class="food-footer">

                            @if (item.PG != null)
                            {
                                <div class="pg-name">

                                    <i class="bi bi-building"></i>

                                    @item.PG.PGName

                                </div>
                            }

                        </div>

                    </div>

                </div>
            }

        </div>
    }

</div>


<style>

    body {
        background: #f5f7fb;
    }


    /* =========================
           HEADER
        ========================= */

    .menu-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 30px;
        gap: 20px;
    }

    .menu-title-area {
        display: flex;
        align-items: center;
        gap: 15px;
    }

    .menu-icon {
        width: 58px;
        height: 58px;
        border-radius: 15px;
        background: #0d6efd;
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 27px;
        flex-shrink: 0;
    }

    .menu-header h2 {
        margin: 0;
        font-weight: 700;
        color: #212529;
    }

    .menu-header p {
        margin: 4px 0 0;
        color: #6c757d;
    }

    .menu-header .btn {
        padding: 11px 18px;
        border-radius: 10px;
        font-weight: 600;
    }


    /* =========================
           FOOD GRID
        ========================= */

    .menu-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 22px;
    }


    /* =========================
           FOOD CARD
        ========================= */

    .food-card {
        background: white;
        border-radius: 18px;
        overflow: hidden;
        border: 1px solid #e9ecef;
        box-shadow: 0 5px 25px rgba(0, 0, 0, .05);
        transition: all .25s ease;
    }

        .food-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 12px 35px rgba(0, 0, 0, .10);
        }


    /* =========================
           FOOD IMAGE
        ========================= */

    .food-image {
        height: 150px;
        background: #eef4ff;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #0d6efd;
        font-size: 60px;
    }


    /* =========================
           CONTENT
        ========================= */

    .food-content {
        padding: 20px;
    }


    /* =========================
           TOP SECTION
        ========================= */

    .food-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 8px;
        margin-bottom: 10px;
        flex-wrap: wrap;
    }


    /* =========================
           DAY BADGE
        ========================= */

    .day-badge {
        background: #fff3cd;
        color: #997404;
        padding: 6px 11px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 700;
    }

        .day-badge i {
            margin-right: 3px;
        }


    /* =========================
           MEAL BADGE
        ========================= */

    .meal-badge {
        background: #e7f1ff;
        color: #0d6efd;
        padding: 6px 11px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 700;
    }


    /* =========================
           AVAILABILITY
        ========================= */

    .availability {
        margin-bottom: 10px;
    }

    .available {
        color: #198754;
        font-size: 12px;
        font-weight: 600;
    }

    .unavailable {
        color: #dc3545;
        font-size: 12px;
        font-weight: 600;
    }

        .available i,
        .unavailable i {
            margin-right: 3px;
        }


    /* =========================
           ITEM NAME
        ========================= */

    .food-content h4 {
        margin: 0 0 8px;
        font-size: 19px;
        font-weight: 700;
        color: #212529;
    }


    /* =========================
           DESCRIPTION
        ========================= */

    .description {
        color: #6c757d;
        font-size: 13px;
        line-height: 1.6;
        min-height: 42px;
        margin-bottom: 18px;
    }

    .empty-description {
        font-style: italic;
        opacity: .7;
    }


    /* =========================
           FOOTER
        ========================= */

    .food-footer {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        gap: 10px;
        padding-top: 15px;
        border-top: 1px solid #eee;
    }

    .pg-name {
        color: #6c757d;
        font-size: 12px;
        text-align: right;
        font-weight: 600;
    }

        .pg-name i {
            margin-right: 3px;
        }


    /* =========================
           EMPTY STATE
        ========================= */

    .empty-card {
        background: white;
        border-radius: 18px;
        padding: 70px 25px;
        text-align: center;
        border: 1px solid #e9ecef;
        box-shadow: 0 5px 25px rgba(0, 0, 0, .05);
    }

    .empty-icon {
        width: 85px;
        height: 85px;
        margin: 0 auto 20px;
        border-radius: 50%;
        background: #eef4ff;
        color: #0d6efd;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 38px;
    }

    .empty-card h3 {
        font-weight: 700;
        margin-bottom: 8px;
    }

    .empty-card p {
        color: #6c757d;
        max-width: 500px;
        margin: 0 auto 22px;
    }


    /* =========================
           TABLET
        ========================= */

    @@media (max-width: 992px) {

        .menu-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }


    /* =========================
           MOBILE
        ========================= */

    @@media (max-width: 650px) {

        .menu-header {
            flex-direction: column;
            align-items: stretch;
        }

        .menu-title-area {
            align-items: flex-start;
        }

        .menu-header .btn {
            width: 100%;
        }

        .menu-grid {
            grid-template-columns: 1fr;
        }
    }

</style>
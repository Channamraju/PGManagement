@using PGManagement.Models

@{
    ViewData["Title"] = "Owner Dashboard";

    var ownerName = Context.Session.GetString("UserName") ?? "Owner";
    var ownerImage = Context.Session.GetString("UserImage");

    int pgCount = ViewBag.PGCount ?? 0;
    int roomCount = ViewBag.RoomCount ?? 0;
    int totalBeds = ViewBag.TotalBeds ?? 0;
    int availableBeds = ViewBag.AvailableBeds ?? 0;
    int occupiedBeds = ViewBag.OccupiedBeds ?? 0;

    int totalBookings = ViewBag.TotalBookings ?? 0;
    int pendingBookings = ViewBag.PendingBookings ?? 0;
    int confirmedBookings = ViewBag.ConfirmedBookings ?? 0;
    int completedBookings = ViewBag.CompletedBookings ?? 0;
    int cancelledBookings = ViewBag.CancelledBookings ?? 0;

    int monthlyBookings = ViewBag.MonthlyBookings ?? 0;
    int dailyBookings = ViewBag.DailyBookings ?? 0;

    decimal totalPayments = ViewBag.TotalPayments ?? 0m;
    decimal monthlyPayments = ViewBag.MonthlyPayments ?? 0m;
    decimal dailyPayments = ViewBag.DailyPayments ?? 0m;
    decimal pendingPaymentAmount = ViewBag.PendingPaymentAmount ?? 0m;
    decimal todayPayments = ViewBag.TodayPayments ?? 0m;
    decimal currentMonthPayments = ViewBag.CurrentMonthPayments ?? 0m;

    int paymentCount = ViewBag.PaymentCount ?? 0;

    var recentBookings =
        ViewBag.RecentBookings as IEnumerable<Booking>
        ?? new List<Booking>();

    var firstName =
        ownerName
            .Split(' ', StringSplitOptions.RemoveEmptyEntries)
            .FirstOrDefault()
        ?? "Owner";

    var nameParts =
        ownerName.Split(
            ' ',
            StringSplitOptions.RemoveEmptyEntries);

    var initials = nameParts.Length >= 2
        ? $"{nameParts[0].Substring(0, 1)}{nameParts[1].Substring(0, 1)}".ToUpper()
        : ownerName.Substring(0, 1).ToUpper();

    double occupancyPercentage =
        totalBeds > 0
            ? ((double)occupiedBeds / totalBeds) * 100
            : 0;

    string occupancyText =
        occupancyPercentage.ToString("0");

    int pendingApprovalCount =
        recentBookings.Count(x => x.Status == "Pending");
}

<link rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<div class="owner-dashboard">

    <!-- ===================================================== -->
    <!-- SIDEBAR -->
    <!-- ===================================================== -->

    <aside class="sidebar">

        <div class="brand">

            <div class="brand-icon">
                <i class="bi bi-buildings-fill"></i>
            </div>

            <div class="brand-text">
                <strong>PG Manager</strong>
                <small>Owner Panel</small>
            </div>

        </div>

        <nav class="sidebar-menu">

            <a asp-controller="Owner"
               asp-action="Dashboard"
               class="menu-item active">
                <i class="bi bi-grid-1x2-fill"></i>
                <span>Dashboard</span>
            </a>

            <a asp-controller="PG"
               asp-action="MyPGs"
               class="menu-item">
                <i class="bi bi-buildings"></i>
                <span>My PGs</span>
            </a>

            <a asp-controller="PG"
               asp-action="Create"
               class="menu-item">
                <i class="bi bi-building-add"></i>
                <span>Add PG</span>
            </a>

            <a asp-controller="Room"
               asp-action="Index"
               class="menu-item">
                <i class="bi bi-door-open"></i>
                <span>Rooms & Beds</span>
            </a>

            <a asp-controller="OwnerTenant"
               asp-action="Index"
               class="menu-item">
                <i class="bi bi-people"></i>
                <span>Tenants</span>
            </a>

            <a asp-controller="OwnerBooking"
               asp-action="Index"
               class="menu-item">
                <i class="bi bi-calendar-check"></i>
                <span>Bookings</span>

                @if (pendingBookings > 0)
                {
                    <span class="menu-count">
                        @pendingBookings
                    </span>
                }
            </a>

            <a asp-controller="FoodMenu"
               asp-action="Manage"
               class="menu-item">
                <i class="bi bi-egg-fried"></i>
                <span>Food Menu</span>
            </a>

            <a asp-controller="OwnerPayment"
               asp-action="Index"
               class="menu-item">
                <i class="bi bi-credit-card"></i>
                <span>Payments</span>
            </a>

            <div class="menu-divider"></div>

            <a asp-controller="Owner"
               asp-action="Profile"
               class="menu-item">
                <i class="bi bi-person-circle"></i>
                <span>My Profile</span>
            </a>

            <a asp-controller="Account"
               asp-action="Logout"
               class="menu-item logout">
                <i class="bi bi-box-arrow-right"></i>
                <span>Logout</span>
            </a>

        </nav>

    </aside>


    <!-- ===================================================== -->
    <!-- MAIN CONTENT -->
    <!-- ===================================================== -->

    <main class="main-content">

        <!-- TOPBAR -->

        <header class="topbar">

            <div class="mobile-brand">
                <i class="bi bi-buildings-fill"></i>
                PG Manager
            </div>

            <div class="topbar-right">

                <!-- Notification -->

                <a asp-controller="OwnerBooking"
                   asp-action="Index"
                   class="notification-btn">

                    <i class="bi bi-bell"></i>

                    @if (pendingBookings > 0 || pendingPaymentAmount > 0)
                    {
                        <span class="notification-dot"></span>
                    }

                </a>


                <!-- PROFILE -->

                <div class="top-profile">

                    @if (!string.IsNullOrEmpty(ownerImage))
                    {
                        <img src="@ownerImage"
                             alt="Profile"
                             class="top-profile-image" />
                    }
                    else
                    {
                        <div class="top-profile-placeholder">
                            @initials
                        </div>
                    }

                    <div class="top-profile-info">

                        <strong>
                            @ownerName
                        </strong>

                        <small>
                            PG Owner
                        </small>

                    </div>

                    <div class="dropdown">

                        <button class="profile-menu-btn"
                                data-bs-toggle="dropdown">

                            <i class="bi bi-chevron-down"></i>

                        </button>

                        <ul class="dropdown-menu dropdown-menu-end">

                            <li>
                                <a class="dropdown-item"
                                   asp-controller="Owner"
                                   asp-action="Profile">
                                    <i class="bi bi-person"></i>
                                    My Profile
                                </a>
                            </li>

                            <li>
                                <a class="dropdown-item"
                                   asp-controller="Owner"
                                   asp-action="EditProfile">
                                    <i class="bi bi-pencil"></i>
                                    Edit Profile
                                </a>
                            </li>

                            <li>
                                <hr class="dropdown-divider" />
                            </li>

                            <li>
                                <a class="dropdown-item text-danger"
                                   asp-controller="Account"
                                   asp-action="Logout">
                                    <i class="bi bi-box-arrow-right"></i>
                                    Logout
                                </a>
                            </li>

                        </ul>

                    </div>

                </div>

            </div>

        </header>


        <!-- ===================================================== -->
        <!-- DASHBOARD CONTENT -->
        <!-- ===================================================== -->

        <div class="dashboard-content">


            <!-- ================================================= -->
            <!-- WELCOME -->
            <!-- ================================================= -->

            <section class="welcome-section">

                <div>

                    <span class="welcome-label">
                        OWNER DASHBOARD
                    </span>

                    <h1>
                        Welcome back, @firstName! 👋
                    </h1>

                    <p>
                        Manage your PGs, rooms, tenants,
                        bookings and payments from one place.
                    </p>

                </div>

                <div class="welcome-actions">

                    <a asp-controller="Owner"
                       asp-action="Profile"
                       class="profile-action">

                        <i class="bi bi-person-circle"></i>
                        My Profile

                    </a>

                    <a asp-controller="PG"
                       asp-action="Create"
                       class="add-pg-action">

                        <i class="bi bi-plus-lg"></i>
                        Add New PG

                    </a>

                </div>

            </section>


            <!-- ================================================= -->
            <!-- PENDING APPROVAL ALERT -->
            <!-- ================================================= -->
            @if (pendingBookings > 0)
            {
                <section class="approval-alert">

                    <div class="approval-alert-left">

                        <div class="approval-alert-icon">
                            <i class="bi bi-hourglass-split"></i>
                        </div>

                        <div>

                            <strong>
                                @pendingBookings booking
                                @(pendingBookings == 1 ? "" : "s") waiting for approval
                            </strong>

                            <span>
                                Review tenant booking requests and approve or reject them.
                            </span>

                        </div>

                    </div>

                    <a asp-controller="OwnerBooking"
                       asp-action="Index"
                       class="approval-btn">

                        <i class="bi bi-check-circle"></i>
                        Review Bookings

                    </a>

                </section>
            }


            <!-- ================================================= -->
            <!-- STAT CARDS -->
            <!-- ================================================= -->

            <section class="stats-grid">

                <!-- PG -->

                <a asp-controller="PG"
                   asp-action="MyPGs"
                   class="stat-card stat-link">

                    <div class="stat-icon pg-icon">
                        <i class="bi bi-buildings-fill"></i>
                    </div>

                    <div class="stat-content">

                        <span>Total PGs</span>

                        <strong>
                            @pgCount
                        </strong>

                        <small>
                            Properties managed
                        </small>

                    </div>

                    <i class="bi bi-chevron-right stat-arrow"></i>

                </a>


                <!-- ROOMS -->

                <a asp-controller="Room"
                   asp-action="Index"
                   class="stat-card stat-link">

                    <div class="stat-icon room-icon">
                        <i class="bi bi-door-open-fill"></i>
                    </div>

                    <div class="stat-content">

                        <span>Total Rooms</span>

                        <strong>
                            @roomCount
                        </strong>

                        <small>
                            Active rooms
                        </small>

                    </div>

                    <i class="bi bi-chevron-right stat-arrow"></i>

                </a>


                <!-- BEDS -->

                <a asp-controller="Room"
                   asp-action="Index"
                   class="stat-card stat-link">

                    <div class="stat-icon bed-icon">
                        <i class="bi bi-grid-3x3-gap-fill"></i>
                    </div>

                    <div class="stat-content">

                        <span>Available Beds</span>

                        <strong>
                            @availableBeds
                        </strong>

                        <small>
                            @occupiedBeds occupied /
                            @totalBeds total
                        </small>

                    </div>

                    <i class="bi bi-chevron-right stat-arrow"></i>

                </a>


                <!-- BOOKINGS -->

                <a asp-controller="OwnerBooking"
                   asp-action="Index"
                   class="stat-card stat-link">

                    <div class="stat-icon booking-icon">
                        <i class="bi bi-calendar-check-fill"></i>
                    </div>

                    <div class="stat-content">

                        <span>Total Bookings</span>

                        <strong>
                            @totalBookings
                        </strong>

                        <small>
                            @pendingBookings pending approval
                        </small>

                    </div>

                    <i class="bi bi-chevron-right stat-arrow"></i>

                </a>

            </section>


            <!-- ================================================= -->
            <!-- OCCUPANCY + BOOKING -->
            <!-- ================================================= -->

            <section class="main-grid">


                <!-- OCCUPANCY -->

                <div class="dashboard-card">

                    <div class="card-header">

                        <div>

                            <h3>
                                Bed Occupancy
                            </h3>

                            <p>
                                Current room utilization
                            </p>

                        </div>

                        <a asp-controller="Room"
                           asp-action="Index"
                           class="view-link">

                            Manage
                            <i class="bi bi-arrow-right"></i>

                        </a>

                    </div>


                    <div class="occupancy-body">

                        <div class="occupancy-circle"
                             style="--percentage:@occupancyPercentage">

                            <div class="circle-inner">

                                <strong>
                                    @occupancyText%
                                </strong>

                                <span>
                                    Occupied
                                </span>

                            </div>

                        </div>


                        <div class="occupancy-details">

                            <div class="occupancy-item">

                                <span>
                                    <i class="bi bi-circle-fill available-dot"></i>
                                    Available
                                </span>

                                <strong>
                                    @availableBeds
                                </strong>

                            </div>

                            <div class="occupancy-item">

                                <span>
                                    <i class="bi bi-circle-fill occupied-dot"></i>
                                    Occupied
                                </span>

                                <strong>
                                    @occupiedBeds
                                </strong>

                            </div>

                            <div class="occupancy-item">

                                <span>
                                    <i class="bi bi-circle-fill total-dot"></i>
                                    Total Beds
                                </span>

                                <strong>
                                    @totalBeds
                                </strong>

                            </div>

                        </div>

                    </div>

                </div>


                <!-- BOOKING OVERVIEW -->

                <div class="dashboard-card">

                    <div class="card-header">

                        <div>

                            <h3>
                                Booking Overview
                            </h3>

                            <p>
                                Current booking status
                            </p>

                        </div>

                        <a asp-controller="OwnerBooking"
                           asp-action="Index"
                           class="view-link">

                            View All
                            <i class="bi bi-arrow-right"></i>

                        </a>

                    </div>


                    <div class="booking-status-list">

                        <a asp-controller="OwnerBooking"
                           asp-action="Index"
                           class="booking-status-item">

                            <div class="status-left">
                                <span class="status-dot pending"></span>
                                Pending Approval
                            </div>

                            <strong>
                                @pendingBookings
                            </strong>

                        </a>


                        <a asp-controller="OwnerBooking"
                           asp-action="Index"
                           class="booking-status-item">

                            <div class="status-left">
                                <span class="status-dot confirmed"></span>
                                Confirmed
                            </div>

                            <strong>
                                @confirmedBookings
                            </strong>

                        </a>


                        <a asp-controller="OwnerBooking"
                           asp-action="Index"
                           class="booking-status-item">

                            <div class="status-left">
                                <span class="status-dot completed"></span>
                                Completed
                            </div>

                            <strong>
                                @completedBookings
                            </strong>

                        </a>


                        <a asp-controller="OwnerBooking"
                           asp-action="Index"
                           class="booking-status-item">

                            <div class="status-left">
                                <span class="status-dot cancelled"></span>
                                Cancelled
                            </div>

                            <strong>
                                @cancelledBookings
                            </strong>

                        </a>

                    </div>


                    <div class="stay-summary">

                        <div>

                            <i class="bi bi-calendar-month"></i>

                            <span>
                                Monthly
                            </span>

                            <strong>
                                @monthlyBookings
                            </strong>

                        </div>


                        <div>

                            <i class="bi bi-calendar-day"></i>

                            <span>
                                Daily
                            </span>

                            <strong>
                                @dailyBookings
                            </strong>

                        </div>

                    </div>

                </div>

            </section>


            <!-- ================================================= -->
            <!-- REVENUE -->
            <!-- ================================================= -->

            <section class="payment-grid">


                <a asp-controller="OwnerPayment"
                   asp-action="Index"
                   class="payment-card">

                    <div class="payment-card-icon">
                        <i class="bi bi-wallet2"></i>
                    </div>

                    <div>

                        <span>
                            Total Revenue
                        </span>

                        <strong>
                            ₹@totalPayments.ToString("N2")
                        </strong>

                        <small>
                            @paymentCount successful transactions
                        </small>

                    </div>

                </a>


                <a asp-controller="OwnerPayment"
                   asp-action="Index"
                   class="payment-card">

                    <div class="payment-card-icon monthly">
                        <i class="bi bi-calendar-month"></i>
                    </div>

                    <div>

                        <span>
                            Monthly Revenue
                        </span>

                        <strong>
                            ₹@monthlyPayments.ToString("N2")
                        </strong>

                        <small>
                            Monthly payments
                        </small>

                    </div>

                </a>


                <a asp-controller="OwnerPayment"
                   asp-action="Index"
                   class="payment-card">

                    <div class="payment-card-icon daily">
                        <i class="bi bi-calendar-day"></i>
                    </div>

                    <div>

                        <span>
                            Daily Revenue
                        </span>

                        <strong>
                            ₹@dailyPayments.ToString("N2")
                        </strong>

                        <small>
                            Daily payments
                        </small>

                    </div>

                </a>


                <a asp-controller="OwnerPayment"
                   asp-action="Index"
                   class="payment-card pending-payment">

                    <div class="payment-card-icon pending">
                        <i class="bi bi-hourglass-split"></i>
                    </div>

                    <div>

                        <span>
                            Pending Collection
                        </span>

                        <strong>
                            ₹@pendingPaymentAmount.ToString("N2")
                        </strong>

                        <small>
                            Payment due
                        </small>

                    </div>

                </a>

            </section>


            <!-- ================================================= -->
            <!-- PAYMENT SUMMARY -->
            <!-- ================================================= -->

            <section class="dashboard-card payment-summary-card">

                <div class="card-header">

                    <div>

                        <h3>
                            Payment Summary
                        </h3>

                        <p>
                            Your payment collection overview
                        </p>

                    </div>

                    <a asp-controller="OwnerPayment"
                       asp-action="Index"
                       class="view-link">

                        View Payments
                        <i class="bi bi-arrow-right"></i>

                    </a>

                </div>


                <div class="payment-summary-grid">

                    <div class="summary-box">

                        <span>
                            <i class="bi bi-calendar-event"></i>
                            Today
                        </span>

                        <strong>
                            ₹@todayPayments.ToString("N2")
                        </strong>

                    </div>


                    <div class="summary-box">

                        <span>
                            <i class="bi bi-calendar3"></i>
                            This Month
                        </span>

                        <strong>
                            ₹@currentMonthPayments.ToString("N2")
                        </strong>

                    </div>


                    <div class="summary-box">

                        <span>
                            <i class="bi bi-arrow-repeat"></i>
                            Monthly
                        </span>

                        <strong>
                            ₹@monthlyPayments.ToString("N2")
                        </strong>

                    </div>


                    <div class="summary-box">

                        <span>
                            <i class="bi bi-sun"></i>
                            Daily
                        </span>

                        <strong>
                            ₹@dailyPayments.ToString("N2")
                        </strong>

                    </div>

                </div>

            </section>


            <!-- ================================================= -->
            <!-- RECENT BOOKINGS -->
            <!-- ================================================= -->

            <section class="dashboard-card recent-card">

                <div class="card-header">

                    <div>

                        <h3>
                            Recent Bookings
                        </h3>

                        <p>
                            Latest tenant booking activity
                        </p>

                    </div>

                    <a asp-controller="OwnerBooking"
                       asp-action="Index"
                       class="view-link">

                        View All
                        <i class="bi bi-arrow-right"></i>

                    </a>

                </div>


                @if (recentBookings.Any())
                {

                    <div class="table-responsive">

                        <table class="recent-table">

                            <thead>

                                <tr>

                                    <th>Tenant</th>
                                    <th>PG</th>
                                    <th>Room / Bed</th>
                                    <th>Stay</th>
                                    <th>Amount</th>
                                    <th>Status</th>
                                    <th>Action</th>

                                </tr>

                            </thead>


                            <tbody>

                                @foreach (var booking in recentBookings)
                                {

                                    var tenant =
                                        booking.User?.FullName
                                        ?? "Unknown";

                                    var bookingStatus =
                                        booking.Status
                                        ?? "Pending";

                                    var statusClass =
                                        bookingStatus
                                            .ToLower()
                                            .Replace(" ", "-");

                                    var tenantInitial =
                                        !string.IsNullOrWhiteSpace(tenant)
                                            ? tenant.Substring(0, 1).ToUpper()
                                            : "U";


                                    <tr>

                                        <!-- TENANT -->

                                        <td>

                                            <div class="tenant-cell">

                                                <div class="tenant-avatar">
                                                    @tenantInitial
                                                </div>

                                                <div>

                                                    <strong>
                                                        @tenant
                                                    </strong>

                                                    <small>
                                                        @booking.BookingDate.ToString("dd MMM yyyy")
                                                    </small>

                                                </div>

                                            </div>

                                        </td>


                                        <!-- PG -->

                                        <td>

                                            <strong>
                                                @(booking.PG?.PGName ?? "-")
                                            </strong>

                                        </td>


                                        <!-- ROOM -->

                                        <td>

                                            <div class="room-cell">

                                                <span>
                                                    Room
                                                    @(booking.Room?.RoomNumber ?? "-")
                                                </span>

                                                <small>
                                                    Bed
                                                    @(booking.Bed?.BedNumber ?? "-")
                                                </small>

                                            </div>

                                        </td>


                                        <!-- STAY -->

                                        <td>

                                            @if (booking.StayType == "Monthly")
                                            {

                                                <span class="stay-badge monthly-badge">

                                                    <i class="bi bi-calendar-month"></i>

                                                    Monthly

                                                </span>

                                            }
                                            else
                                            {

                                                <span class="stay-badge daily-badge">

                                                    <i class="bi bi-calendar-day"></i>

                                                    Daily

                                                </span>

                                            }

                                        </td>


                                        <!-- AMOUNT -->

                                        <td>

                                            <strong class="amount">

                                                ₹@booking.TotalAmount.ToString("N2")

                                            </strong>

                                        </td>


                                        <!-- STATUS -->

                                        <td>

                                            <span class="booking-badge @statusClass">

                                                @bookingStatus

                                            </span>

                                        </td>


                                        <!-- ACTION -->

                                        <td>

                                            <div class="booking-actions">

                                                <a asp-controller="OwnerBooking"
                                                   asp-action="Details"
                                                   asp-route-id="@booking.BookingId"
                                                   class="action-view"
                                                   title="View Details">

                                                    <i class="bi bi-eye"></i>

                                                </a>


                                                @if (booking.Status == "Pending")
                                                {

                                                    <form asp-controller="OwnerBooking"
                                                          asp-action="Approve"
                                                          method="post"
                                                          onsubmit="return confirm('Approve this booking?');">

                                                        @Html.AntiForgeryToken()

                                                        <input type="hidden"
                                                               name="id"
                                                               value="@booking.BookingId" />

                                                        <button type="submit"
                                                                class="action-approve"
                                                                title="Approve">

                                                            <i class="bi bi-check-lg"></i>

                                                        </button>

                                                    </form>


                                                    <form asp-controller="OwnerBooking"
                                                          asp-action="Reject"
                                                          method="post"
                                                          onsubmit="return confirm('Reject this booking?');">

                                                        @Html.AntiForgeryToken()

                                                        <input type="hidden"
                                                               name="id"
                                                               value="@booking.BookingId" />

                                                        <button type="submit"
                                                                class="action-reject"
                                                                title="Reject">

                                                            <i class="bi bi-x-lg"></i>

                                                        </button>

                                                    </form>

                                                }


                                                @if (booking.Status == "Confirmed")
                                                {

                                                    <form asp-controller="OwnerBooking"
                                                          asp-action="Checkout"
                                                          method="post"
                                                          onsubmit="return confirm('Complete this booking and release the bed?');">

                                                        @Html.AntiForgeryToken()

                                                        <input type="hidden"
                                                               name="id"
                                                               value="@booking.BookingId" />

                                                        <button type="submit"
                                                                class="action-checkout"
                                                                title="Checkout">

                                                            <i class="bi bi-box-arrow-right"></i>

                                                        </button>

                                                    </form>

                                                }

                                            </div>

                                        </td>

                                    </tr>

                                }

                            </tbody>

                        </table>

                    </div>

                }
                else
                {

                    <div class="empty-bookings">

                        <div class="empty-icon">
                            <i class="bi bi-calendar-x"></i>
                        </div>

                        <h4>
                            No bookings yet
                        </h4>

                        <p>
                            New tenant bookings will appear here.
                        </p>

                    </div>

                }

            </section>


            <!-- ================================================= -->
            <!-- QUICK MANAGEMENT -->
            <!-- ================================================= -->

            <section>

                <h3 class="section-title">
                    Quick Management
                </h3>


                <div class="quick-grid">


                    <a asp-controller="PG"
                       asp-action="MyPGs"
                       class="quick-card">

                        <div class="quick-icon blue">
                            <i class="bi bi-buildings"></i>
                        </div>

                        <div>

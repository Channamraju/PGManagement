@model PGManagement.Models.Owner

@{
    ViewData["Title"] = "My Profile";

    var image = Model.ProfileImagePath;

    var initials = !string.IsNullOrWhiteSpace(Model.FullName)
        ? string.Join("",
            Model.FullName
                .Split(' ', StringSplitOptions.RemoveEmptyEntries)
                .Take(2)
                .Select(x => x.Substring(0, 1).ToUpper()))
        : "O";
}

<link rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<div class="profile-page">

    <!-- TOP BAR -->
    <div class="profile-topbar">

        <a asp-controller="Owner"
           asp-action="Dashboard"
           class="back-btn">

            <i class="bi bi-arrow-left"></i>

            Dashboard

        </a>

        <a asp-controller="Owner"
           asp-action="EditProfile"
           class="edit-btn">

            <i class="bi bi-pencil-square"></i>

            Edit Profile

        </a>

    </div>


    <!-- PROFILE COVER -->
    <div class="profile-cover">

        <div class="cover-pattern"></div>

    </div>


    <!-- PROFILE CARD -->
    <div class="profile-card">

        <!-- PROFILE IMAGE -->

        <div class="profile-image-wrapper">

            @if (!string.IsNullOrEmpty(image))
            {
                <img src="@image"
                     alt="@Model.FullName"
                     class="profile-image" />
            }
            else
            {
                <div class="profile-placeholder">

                    @initials

                </div>
            }

        </div>


        <!-- NAME -->

        <div class="profile-heading">

            <h1>
                @Model.FullName
            </h1>

            <p>
                <i class="bi bi-person-badge"></i>

                PG Owner
            </p>

        </div>


        <!-- STATUS -->

        <span class="status-badge">

            <i class="bi bi-check-circle-fill"></i>

            @Model.Status

        </span>


        <!-- INFORMATION -->

        <div class="profile-info">

            <div class="info-item">

                <div class="info-icon">

                    <i class="bi bi-envelope-fill"></i>

                </div>

                <div>

                    <small>Email</small>

                    <strong>
                        @Model.Email
                    </strong>

                </div>

            </div>


            <div class="info-item">

                <div class="info-icon">

                    <i class="bi bi-telephone-fill"></i>

                </div>

                <div>

                    <small>Phone</small>

                    <strong>
                        @Model.Phone
                    </strong>

                </div>

            </div>


            <div class="info-item">

                <div class="info-icon">

                    <i class="bi bi-geo-alt-fill"></i>

                </div>

                <div>

                    <small>Address</small>

                    <strong>
                        @Model.Address
                    </strong>

                </div>

            </div>


            <div class="info-item">

                <div class="info-icon">

                    <i class="bi bi-calendar-event-fill"></i>

                </div>

                <div>

                    <small>Member Since</small>

                    <strong>
                        @Model.CreatedDate.ToString("dd MMM yyyy")
                    </strong>

                </div>

            </div>

        </div>


        <!-- ACTIONS -->

        <div class="profile-actions">

            <a asp-controller="Owner"
               asp-action="EditProfile"
               class="primary-action">

                <i class="bi bi-pencil-square"></i>

                Edit Profile

            </a>

            <a asp-controller="Owner"
               asp-action="Dashboard"
               class="secondary-action">

                <i class="bi bi-speedometer2"></i>

                Dashboard

            </a>

        </div>

    </div>

</div>


<style>

    * {
        box-sizing: border-box;
    }

    body {
        background: #f4f6fb;
    }

    .profile-page {
        min-height: 100vh;
        padding-bottom: 50px;
    }

    /* TOP BAR */

    .profile-topbar {
        height: 70px;
        background: #ffffff;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 40px;
        border-bottom: 1px solid #e8eaf0;
    }

    .back-btn,
    .edit-btn {
        text-decoration: none;
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .back-btn {
        color: #555;
    }

    .edit-btn {
        background: #2563eb;
        color: white;
        padding: 10px 18px;
        border-radius: 10px;
    }

        .edit-btn:hover {
            background: #1d4ed8;
            color: white;
        }

    /* COVER */

    .profile-cover {
        height: 220px;
        position: relative;
        overflow: hidden;
        background: linear-gradient( 135deg, #2563eb, #4f46e5, #7c3aed );
    }

    .cover-pattern {
        position: absolute;
        width: 100%;
        height: 100%;
        opacity: .12;
        background-image: radial-gradient( circle at 20% 30%, white 0, transparent 120px ), radial-gradient( circle at 80% 60%, white 0, transparent 160px );
    }

    /* CARD */

    .profile-card {
        max-width: 900px;
        margin: -80px auto 0;
        position: relative;
        background: white;
        border-radius: 24px;
        padding: 0 45px 40px;
        box-shadow: 0 15px 50px rgba(0,0,0,.12);
    }

    /* IMAGE */

    .profile-image-wrapper {
        width: 150px;
        height: 150px;
        border-radius: 50%;
        padding: 6px;
        background: white;
        position: relative;
        top: -75px;
        margin: 0 auto -60px;
    }

    .profile-image,
    .profile-placeholder {
        width: 100%;
        height: 100%;
        border-radius: 50%;
    }

    .profile-image {
        object-fit: cover;
    }

    .profile-placeholder {
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient( 135deg, #2563eb, #7c3aed );
        color: white;
        font-size: 42px;
        font-weight: 700;
    }

    /* HEADING */

    .profile-heading {
        text-align: center;
        margin-top: 25px;
    }

        .profile-heading h1 {
            margin: 0;
            font-size: 30px;
            font-weight: 700;
            color: #111827;
        }

        .profile-heading p {
            margin-top: 8px;
            color: #6b7280;
        }

    /* STATUS */

    .status-badge {
        display: table;
        margin: 15px auto 35px;
        padding: 7px 15px;
        border-radius: 30px;
        background: #dcfce7;
        color: #15803d;
        font-size: 13px;
        font-weight: 700;
    }

    /* INFORMATION */

    .profile-info {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 18px;
    }

    .info-item {
        display: flex;
        gap: 15px;
        align-items: center;
        padding: 20px;
        border: 1px solid #edf0f5;
        border-radius: 15px;
        background: #fafbfc;
    }

    .info-icon {
        width: 45px;
        height: 45px;
        min-width: 45px;
        border-radius: 12px;
        background: #eef2ff;
        color: #4f46e5;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 18px;
    }

    .info-item small {
        display: block;
        color: #9ca3af;
        margin-bottom: 4px;
    }

    .info-item strong {
        color: #1f2937;
        word-break: break-word;
    }

    /* ACTIONS */

    .profile-actions {
        display: flex;
        justify-content: center;
        gap: 15px;
        margin-top: 35px;
    }

    .primary-action,
    .secondary-action {
        padding: 12px 22px;
        border-radius: 10px;
        text-decoration: none;
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .primary-action {
        background: #2563eb;
        color: white;
    }

    .secondary-action {
        background: #f1f5f9;
        color: #334155;
    }

    .primary-action:hover {
        background: #1d4ed8;
        color: white;
    }

    .secondary-action:hover {
        background: #e2e8f0;
        color: #334155;
    }

    /* MOBILE */

    @@media (max-width: 700px) {

        .profile-topbar {
            padding: 0 15px;
        }

        .profile-card {
            margin-left: 15px;
            margin-right: 15px;
            padding: 0 20px 30px;
        }

        .profile-info {
            grid-template-columns: 1fr;
        }

        .profile-actions {
            flex-direction: column;
        }

        .primary-action,
        .secondary-action {
            justify-content: center;
        }
    }

</style>
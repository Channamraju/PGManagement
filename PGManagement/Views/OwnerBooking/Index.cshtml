@model IEnumerable<PGManagement.Models.Booking>

@{
    ViewData["Title"] = "Owner Bookings";

    var bookingList = Model?.ToList()
        ?? new List<PGManagement.Models.Booking>();

    var totalBookings = bookingList.Count;

    var pendingBookings = bookingList
        .Count(x => x.Status == "Pending");

    var confirmedBookings = bookingList
        .Count(x => x.Status == "Confirmed");

    var cancelledBookings = bookingList
        .Count(x => x.Status == "Cancelled");

    var completedBookings = bookingList
        .Count(x => x.Status == "Completed");

    var totalAmount = bookingList
        .SelectMany(x => x.Payments ?? new List<PGManagement.Models.Payment>())
        .Where(p => p.Status == "Success")
        .Sum(p => p.Amount);

    var totalSuccessfulPayments = bookingList
        .SelectMany(x => x.Payments ?? new List<PGManagement.Models.Payment>())
        .Count(p => p.Status == "Success");

    var monthlyBookings = bookingList
        .Count(x => x.StayType == "Monthly");

    var dailyBookings = bookingList
        .Count(x => x.StayType == "Daily");
}


<link rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">


<div class="container-fluid py-4 owner-bookings-page">

    <!-- ========================================================= -->
    <!-- HEADER -->
    <!-- ========================================================= -->

    <div class="page-header mb-4">

        <div class="page-title">

            <div class="title-icon">
                <i class="bi bi-calendar2-check"></i>
            </div>

            <div>

                <h2 class="fw-bold mb-1">
                    Booking Management
                </h2>

                <p class="text-muted mb-0">
                    View, approve, manage and checkout tenants for your PGs.
                </p>

            </div>

        </div>


        <div class="header-actions">

            <a asp-controller="Owner"
               asp-action="Dashboard"
               class="btn dashboard-btn">

                <i class="bi bi-speedometer2"></i>
                Dashboard

            </a>

        </div>

    </div>


    <!-- ========================================================= -->
    <!-- ALERTS -->
    <!-- ========================================================= -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success custom-alert alert-dismissible fade show">

            <div class="alert-content">

                <i class="bi bi-check-circle-fill"></i>

                <span>
                    @TempData["Success"]
                </span>

            </div>

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger custom-alert alert-dismissible fade show">

            <div class="alert-content">

                <i class="bi bi-exclamation-triangle-fill"></i>

                <span>
                    @TempData["Error"]
                </span>

            </div>

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    <!-- ========================================================= -->
    <!-- PENDING APPROVAL ALERT -->
    <!-- ========================================================= -->
    @if (pendingBookings > 0)
    {
        <div class="approval-alert mb-4">

            <div class="approval-alert-left">

                <div class="approval-alert-icon">
                    <i class="bi bi-hourglass-split"></i>
                </div>

                <div>

                    <h5 class="mb-1">
                        Booking approval required
                    </h5>

                    <p class="mb-0">
                        You have
                        <strong>@pendingBookings pending booking(s)</strong>
                        waiting for your approval.
                    </p>

                </div>

            </div>


            <a href="#bookingTable"
               class="btn approval-alert-btn">

                <i class="bi bi-arrow-down-circle"></i>
                Review Requests

            </a>

        </div>
    }


    <!-- ========================================================= -->
    <!-- SUMMARY CARDS -->
    <!-- ========================================================= -->

    <div class="row g-4 mb-4">


        <!-- TOTAL -->

        <div class="col-xl-3 col-md-6">

            <div class="stat-card">

                <div class="stat-content">

                    <span class="stat-label">
                        Total Bookings
                    </span>

                    <h2>
                        @totalBookings
                    </h2>

                    <small>
                        All booking requests
                    </small>

                </div>

                <div class="stat-icon total-icon">
                    <i class="bi bi-calendar-check"></i>
                </div>

            </div>

        </div>


        <!-- PENDING -->

        <div class="col-xl-3 col-md-6">

            <div class="stat-card pending-card">

                <div class="stat-content">

                    <span class="stat-label">
                        Pending
                    </span>

                    <h2>
                        @pendingBookings
                    </h2>

                    <small>
                        Waiting for approval
                    </small>

                </div>

                <div class="stat-icon pending-icon">
                    <i class="bi bi-hourglass-split"></i>
                </div>

            </div>

        </div>


        <!-- CONFIRMED -->

        <div class="col-xl-3 col-md-6">

            <div class="stat-card">

                <div class="stat-content">

                    <span class="stat-label">
                        Confirmed
                    </span>

                    <h2>
                        @confirmedBookings
                    </h2>

                    <small>
                        Active bookings
                    </small>

                </div>

                <div class="stat-icon confirmed-icon">
                    <i class="bi bi-check-circle"></i>
                </div>

            </div>

        </div>


        <!-- COMPLETED -->

        <div class="col-xl-3 col-md-6">

            <div class="stat-card">

                <div class="stat-content">

                    <span class="stat-label">
                        Completed
                    </span>

                    <h2>
                        @completedBookings
                    </h2>

                    <small>
                        Completed stays
                    </small>

                </div>

                <div class="stat-icon completed-icon">
                    <i class="bi bi-check2-all"></i>
                </div>

            </div>

        </div>

    </div>


    <!-- ========================================================= -->
    <!-- SECOND SUMMARY ROW -->
    <!-- ========================================================= -->

    <div class="row g-4 mb-4">


        <!-- CANCELLED -->

        <div class="col-xl-3 col-md-6">

            <div class="mini-stat-card">

                <div class="mini-stat-icon cancelled-mini">
                    <i class="bi bi-x-circle"></i>
                </div>

                <div>

                    <span>
                        Cancelled
                    </span>

                    <strong>
                        @cancelledBookings
                    </strong>

                </div>

            </div>

        </div>


        <!-- MONTHLY -->

        <div class="col-xl-3 col-md-6">

            <div class="mini-stat-card">

                <div class="mini-stat-icon monthly-mini">
                    <i class="bi bi-calendar-month"></i>
                </div>

                <div>

                    <span>
                        Monthly Stays
                    </span>

                    <strong>
                        @monthlyBookings
                    </strong>

                </div>

            </div>

        </div>


        <!-- DAILY -->

        <div class="col-xl-3 col-md-6">

            <div class="mini-stat-card">

                <div class="mini-stat-icon daily-mini">
                    <i class="bi bi-calendar-day"></i>
                </div>

                <div>

                    <span>
                        Daily Stays
                    </span>

                    <strong>
                        @dailyBookings
                    </strong>

                </div>

            </div>

        </div>


        <!-- PAYMENTS -->

        <div class="col-xl-3 col-md-6">

            <div class="mini-stat-card">

                <div class="mini-stat-icon payment-mini">
                    <i class="bi bi-credit-card"></i>
                </div>

                <div>

                    <span>
                        Transactions
                    </span>

                    <strong>
                        @totalSuccessfulPayments
                    </strong>

                </div>

            </div>

        </div>

    </div>


    <!-- ========================================================= -->
    <!-- PAYMENT SUMMARY -->
    <!-- ========================================================= -->

    <div class="row g-4 mb-4">


        <!-- TOTAL MONEY -->

        <div class="col-lg-6">

            <div class="payment-card">

                <div>

                    <span class="payment-label">
                        Total Successful Payments
                    </span>

                    <h3>
                        ₹@totalAmount.ToString("N2")
                    </h3>

                    <small>
                        Total money received from tenants
                    </small>

                </div>

                <div class="payment-icon green-payment">
                    <i class="bi bi-cash-stack"></i>
                </div>

            </div>

        </div>


        <!-- TRANSACTIONS -->

        <div class="col-lg-6">

            <div class="payment-card">

                <div>

                    <span class="payment-label">
                        Successful Transactions
                    </span>

                    <h3 class="blue-text">
                        @totalSuccessfulPayments
                    </h3>

                    <small>
                        Completed payment records
                    </small>

                </div>

                <div class="payment-icon blue-payment">
                    <i class="bi bi-credit-card-2-front"></i>
                </div>

            </div>

        </div>

    </div>


    <!-- ========================================================= -->
    <!-- EMPTY STATE -->
    <!-- ========================================================= -->
    @if (!bookingList.Any())
    {

        <div class="empty-card">

            <div class="empty-icon">

                <i class="bi bi-calendar-x"></i>

            </div>

            <h3>
                No Bookings Found
            </h3>

            <p>
                No users have booked rooms or beds in your PGs yet.
            </p>

            <a asp-controller="Owner"
               asp-action="Dashboard"
               class="btn btn-primary px-4">

                <i class="bi bi-speedometer2"></i>

                Back to Dashboard

            </a>

        </div>

    }
    else
    {

        <!-- ===================================================== -->
        <!-- BOOKING MANAGEMENT CARD -->
        <!-- ===================================================== -->

        <div class="booking-card" id="bookingTable">


            <!-- ================================================= -->
            <!-- TABLE HEADER -->
            <!-- ================================================= -->

            <div class="booking-card-header">

                <div>

                    <h5 class="mb-1">

                        <i class="bi bi-list-check"></i>

                        All Bookings

                    </h5>

                    <small>
                        @totalBookings booking(s) found
                    </small>

                </div>


                <div class="header-summary">

                    <span class="pending-summary">

                        <i class="bi bi-hourglass-split"></i>

                        @pendingBookings Pending

                    </span>


                    <span class="confirmed-summary">

                        <i class="bi bi-check-circle"></i>

                        @confirmedBookings Confirmed

                    </span>

                </div>

            </div>


            <!-- ================================================= -->
            <!-- SEARCH / FILTER -->
            <!-- ================================================= -->

            <div class="filter-panel">

                <div class="filter-title">

                    <i class="bi bi-funnel"></i>

                    Search & Filter

                </div>


                <div class="row g-3">


                    <!-- SEARCH -->

                    <div class="col-lg-5 col-md-6">

                        <label class="filter-label">
                            Search
                        </label>

                        <div class="search-box">

                            <i class="bi bi-search"></i>

                            <input type="text"
                                   id="bookingSearch"
                                   class="form-control"
                                   placeholder="Search tenant, PG, room, bed or booking ID..."
                                   autocomplete="off" />

                        </div>

                    </div>


                    <!-- STATUS -->

                    <div class="col-lg-2 col-md-6">

                        <label class="filter-label">
                            Status
                        </label>

                        <select id="statusFilter"
                                class="form-select">

                            <option value="All">
                                All Status
                            </option>

                            <option value="Pending">
                                Pending
                            </option>

                            <option value="Confirmed">
                                Confirmed
                            </option>

                            <option value="Completed">
                                Completed
                            </option>

                            <option value="Cancelled">
                                Cancelled
                            </option>

                        </select>

                    </div>


                    <!-- STAY -->

                    <div class="col-lg-2 col-md-6">

                        <label class="filter-label">
                            Stay Type
                        </label>

                        <select id="stayFilter"
                                class="form-select">

                            <option value="All">
                                All Stays
                            </option>

                            <option value="Monthly">
                                Monthly
                            </option>

                            <option value="Daily">
                                Daily
                            </option>

                        </select>

                    </div>


                    <!-- CLEAR -->

                    <div class="col-lg-3 col-md-6 d-flex align-items-end">

                        <button type="button"
                                id="clearFilters"
                                class="btn clear-filter-btn w-100">

                            <i class="bi bi-arrow-counterclockwise"></i>

                            Clear Filters

                        </button>

                    </div>

                </div>


                <div class="filter-result mt-3">

                    <i class="bi bi-info-circle"></i>

                    Showing
                    <strong id="visibleCount">
                        @totalBookings
                    </strong>
                    of
                    <strong>
                        @totalBookings
                    </strong>
                    bookings

                </div>

            </div>


            <!-- ================================================= -->
            <!-- TABLE -->
            <!-- ================================================= -->

            <div class="table-responsive">

                <table class="table booking-table mb-0 align-middle">

                    <thead>

                        <tr>

                            <th>#</th>

                            <th>Booking</th>

                            <th>Tenant</th>

                            <th>PG</th>

                            <th>Room / Bed</th>

                            <th>Stay</th>

                            <th>Booking Date</th>

                            <th>Amount</th>

                            <th>Payment</th>

                            <th>Status</th>

                            <th>Action</th>

                        </tr>

                    </thead>


                    <tbody id="bookingTableBody">

                        @{
                            int count = 1;
                        }


                        @foreach (var booking in bookingList)
                        {

                            var payments = booking.Payments?
                                .Where(p => p.Status == "Success")
                                .OrderByDescending(p => p.PaymentDate)
                                .ToList()
                                ?? new List<PGManagement.Models.Payment>();

                            var successfulPaymentCount =
                                payments.Count;

                            var totalPaid =
                                payments.Sum(p => p.Amount);

                            var latestPayment =
                                payments.FirstOrDefault();


                            var tenantName =
                                string.IsNullOrWhiteSpace(
                                    booking.User?.FullName)
                                    ? "User"
                                    : booking.User.FullName.Trim();


                            var tenantInitial =
                                string.IsNullOrWhiteSpace(tenantName)
                                    ? "U"
                                    : tenantName.Substring(0, 1).ToUpper();


                            var pgName =
                                booking.PG?.PGName ?? "-";

                            var city =
                                booking.PG?.City ?? "-";

                            var roomNumber =
                                booking.Room?.RoomNumber ?? "-";

                            var bedNumber =
                                booking.Bed?.BedNumber ?? "-";


                            <tr class="booking-row"
                                data-search="@($"{booking.BookingId} {tenantName} {pgName} {city} {roomNumber} {bedNumber}")"
                                data-status="@booking.Status"
                                data-stay="@booking.StayType">


                                <!-- ================================= -->
                                <!-- NUMBER -->
                                <!-- ================================= -->

                                <td>

                                    <span class="row-number">
                                        @count
                                    </span>

                                </td>


                                <!-- ================================= -->
                                <!-- BOOKING -->
                                <!-- ================================= -->

                                <td>

                                    <div class="booking-info">

                                        <strong>
                                            #@booking.BookingId
                                        </strong>

                                        <small>
                                            Booking ID
                                        </small>

                                    </div>

                                </td>


                                <!-- ================================= -->
                                <!-- TENANT -->
                                <!-- ================================= -->

                                <td>

                                    <div class="tenant-info">

                                        <div class="tenant-avatar">

                                            @tenantInitial

                                        </div>

                                        <div class="tenant-details">

                                            <strong>
                                                @tenantName
                                            </strong>

                                            @if (booking.User != null)
                                            {
                                                <small>

                                                    <i class="bi bi-telephone"></i>

                                                    @(string.IsNullOrWhiteSpace(booking.User.Phone)
                                                        ? "Phone not provided"
                                                        : booking.User.Phone)

                                                </small>
                                            }

                                        </div>

                                    </div>

                                </td>


                                <!-- ================================= -->
                                <!-- PG -->
                                <!-- ================================= -->

                                <td>

                                    @if (booking.PG != null)
                                    {

                                        <div class="pg-info">

                                            <strong>
                                                @booking.PG.PGName
                                            </strong>

                                            <small>

                                                <i class="bi bi-geo-alt"></i>

                                                @booking.PG.City

                                            </small>

                                        </div>

                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            -
                                        </span>
                                    }

                                </td>


                                <!-- ================================= -->
                                <!-- ROOM / BED -->
                                <!-- ================================= -->

                                <td>

                                    <div class="room-info">

                                        <div>

                                            <i class="bi bi-door-open"></i>

                                            Room

                                            <strong>
                                                @roomNumber
                                            </strong>

                                        </div>

                                        <div>

                                            <i class="bi bi-bed"></i>

                                            Bed

                                            <strong>
                                                @bedNumber
                                            </strong>

                                        </div>

                                    </div>

                                </td>


                                <!-- ================================= -->
                                <!-- STAY -->
                                <!-- ================================= -->

                                <td>

                                    @if (booking.StayType == "Daily")
                                    {

                                        <span class="stay-badge daily">

                                            <i class="bi bi-calendar-day"></i>

                                            Daily

                                        </span>

                                        <div class="stay-date">

                                            @booking.StartDate.ToString("dd MMM yyyy")

                                            @if (booking.EndDate.HasValue)
                                            {
                                                <span>

                                                    →

                                                    @booking.EndDate.Value.ToString("dd MMM yyyy")

                                                </span>
                                            }

                                        </div>

                                    }
                                    else
                                    {

                                        <span class="stay-badge monthly">

                                            <i class="bi bi-calendar-month"></i>

                                            Monthly

                                        </span>

                                        <div class="stay-date">

                                            From
                                            @booking.StartDate.ToString("dd MMM yyyy")

                                        </div>

                                    }

                                </td>


                                <!-- ================================= -->
                                <!-- BOOKING DATE -->
                                <!-- ================================= -->

                                <td>

                                    <div class="date-info">

                                        <strong>

                                            @booking.BookingDate.ToString("dd MMM yyyy")

                                        </strong>

                                        <small>

                                            @booking.BookingDate.ToString("hh:mm tt")

                                        </small>

                                    </div>

                                </td>


                                <!-- ================================= -->
                                <!-- AMOUNT -->
                                <!-- ================================= -->

                                <td>

                                    @if (successfulPaymentCount > 0)
                                    {

                                        <div class="amount-info">

                                            <strong class="paid-amount">

                                                ₹@totalPaid.ToString("N2")

                                            </strong>

                                            <small>

                                                @successfulPaymentCount
                                                payment(s)

                                            </small>

                                        </div>

                                    }
                                    else if (booking.Room != null)
                                    {

                                        <div class="amount-info">

                                            @if (booking.StayType == "Daily")
                                            {

                                                <strong>

                                                    ₹@booking.TotalAmount.ToString("N2")

                                                </strong>

                                                <small>
                                                    Booking total
                                                </small>

                                            }
                                            else
                                            {

                                                <strong>

                                                    ₹@booking.Room.MonthlyRent.ToString("N2")

                                                </strong>

                                                <small>
                                                    Monthly rent
                                                </small>

                                            }

                                        </div>

                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            -
                                        </span>
                                    }

                                </td>


                                <!-- ================================= -->
                                <!-- PAYMENT -->
                                <!-- ================================= -->

                                <td>

                                    @if (successfulPaymentCount > 0)
                                    {

                                        <span class="payment-status paid">

                                            <i class="bi bi-check-circle-fill"></i>

                                            Paid

                                        </span>

                                        <small class="payment-count">

                                            @successfulPaymentCount
                                            transaction(s)

                                        </small>


                                        @if (latestPayment != null)
                                        {

                                            <small class="payment-date">

                                                Last:
                                                @latestPayment.PaymentDate.ToString("dd MMM yyyy")

                                            </small>

                                        }

                                    }
                                    else
                                    {

                                        <span class="payment-status unpaid">

                                            <i class="bi bi-clock-fill"></i>

                                            Not Paid

                                        </span>

                                        <small class="payment-count">

                                            No successful payment

                                        </small>

                                    }

                                </td>


                                <!-- ================================= -->
                                <!-- STATUS -->
                                <!-- ================================= -->

                                <td>

                                    @if (booking.Status == "Confirmed")
                                    {

                                        <span class="status-badge confirmed">

                                            <i class="bi bi-check-circle-fill"></i>

                                            Confirmed

                                        </span>

                                    }
                                    else if (booking.Status == "Pending")
                                    {

                                        <span class="status-badge pending">

                                            <i class="bi bi-hourglass-split"></i>

                                            Pending

                                        </span>

                                    }
                                    else if (booking.Status == "Cancelled")
                                    {

                                        <span class="status-badge cancelled">

                                            <i class="bi bi-x-circle-fill"></i>

                                            Cancelled

                                        </span>

                                    }
                                    else if (booking.Status == "Completed")
                                    {

                                        <span class="status-badge completed">

                                            <i class="bi bi-check2-all"></i>

                                            Completed

                                        </span>

                                    }
                                    else
                                    {

                                        <span class="status-badge other">

                                            @booking.Status

                                        </span>

                                    }

                                </td>


                                <!-- ================================= -->
                                <!-- ACTION -->
                                <!-- ================================= -->

                                <td>

                                    <div class="action-buttons">


                                        <!-- VIEW -->

                                        <a asp-controller="OwnerBooking"
                                           asp-action="Details"
                                           asp-route-id="@booking.BookingId"
                                           class="action-btn view-btn"
                                           title="View Details">

                                            <i class="bi bi-eye"></i>

                                        </a>


                                        <!-- APPROVE -->
                                        @if (booking.Status == "Pending")
                                        {

                                            <form asp-controller="OwnerBooking"
                                                  asp-action="Approve"
                                                  asp-route-id="@booking.BookingId"
                                                  method="post"
                                                  class="action-form"
                                                  onsubmit="return confirm('Are you sure you want to approve this booking?');">

                                                @Html.AntiForgeryToken()

                                                <button type="submit"
                                                        class="action-btn approve-btn"
                                                        title="Approve Booking">

                                                    <i class="bi bi-check-lg"></i>

                                                </button>

                                            </form>


                                            <!-- REJECT -->

                                            <form asp-controller="OwnerBooking"
                                                  asp-action="Reject"
                                                  asp-route-id="@booking.BookingId"
                                                  method="post"
                                                  class="action-form"
                                                  onsubmit="return confirm('Are you sure you want to reject this booking?');">

                                                @Html.AntiForgeryToken()

                                                <button type="submit"
                                                        class="action-btn reject-btn"
                                                        title="Reject Booking">

                                                    <i class="bi bi-x-lg"></i>

                                                </button>

                                            </form>

                                        }


                                        <!-- CHECKOUT -->
                                        @if (booking.Status == "Confirmed")
                                        {

                                            <form asp-controller="OwnerBooking"
                                                  asp-action="Checkout"
                                                  asp-route-id="@booking.BookingId"
                                                  method="post"
                                                  class="action-form"
                                                  onsubmit="return confirm('Are you sure you want to checkout this tenant? This will complete the booking and make the bed available again.');">

                                                @Html.AntiForgeryToken()

                                                <button type="submit"
                                                        class="action-btn checkout-btn"
                                                        title="Checkout Tenant">

                                                    <i class="bi bi-box-arrow-right"></i>

                                                </button>

                                            </form>

                                        }

                                    </div>

                                </td>

                            </tr>

                            count++;

                        }

                    </tbody>

                </table>

            </div>


            <!-- ================================================= -->
            <!-- NO FILTER RESULT -->
            <!-- ================================================= -->

            <div id="noFilterResults"
                 class="no-filter-results d-none">

                <div class="no-filter-icon">

                    <i class="bi bi-search"></i>

                </div>

                <h5>
                    No matching bookings
                </h5>

                <p>
                    Try changing your search or filter.
                </p>

                <button type="button"
                        id="resetFiltersButton"
                        class="btn btn-primary">

                    <i class="bi bi-arrow-counterclockwise"></i>

                    Reset Filters

                </button>

            </div>

        </div>

    }

</div>


<!-- ============================================================= -->
<!-- CSS -->
<!-- ============================================================= -->

<style>

    body {
        background: #f6f8fb;
    }


    .owner-bookings-page {
        max-width: 1800px;
        margin: auto;
    }


    /* ========================================================= */
    /* HEADER */
    /* ========================================================= */

    .page-header {

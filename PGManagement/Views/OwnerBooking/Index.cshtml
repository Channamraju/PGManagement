<script>

    document.addEventListener("DOMContentLoaded", function() {

        const searchInput =
            document.getElementById("bookingSearch");

        const statusFilter =
            document.getElementById("statusFilter");

        const stayFilter =
            document.getElementById("stayFilter");

        const clearFilters =
            document.getElementById("clearFilters");

        const resetFiltersButton =
            document.getElementById("resetFiltersButton");

        const rows =
            document.querySelectorAll(".booking-row");

        const visibleCount =
            document.getElementById("visibleCount");

        const noFilterResults =
            document.getElementById("noFilterResults");


        function filterBookings() {

            const search =
                (searchInput?.value || "")
                    .toLowerCase()
                    .trim();

            const selectedStatus =
                statusFilter?.value || "All";

            const selectedStay =
                stayFilter?.value || "All";


            let visible = 0;


            rows.forEach(function(row) {

                const rowSearch =
                    (row.dataset.search || "")
                        .toLowerCase();

                const rowStatus =
                    row.dataset.status || "";

                const rowStay =
                    row.dataset.stay || "";


                const matchesSearch =
                    search === "" ||
                    rowSearch.includes(search);

                const matchesStatus =
                    selectedStatus === "All" ||
                    rowStatus === selectedStatus;

                const matchesStay =
                    selectedStay === "All" ||
                    rowStay === selectedStay;


                if (
                    matchesSearch &&
                    matchesStatus &&
                    matchesStay
                ) {

                    row.style.display = "";

                    visible++;

                }
                else {

                    row.style.display = "none";

                }

            });


            if (visibleCount) {
                visibleCount.textContent = visible;
            }


            if (noFilterResults) {

                if (visible === 0) {

                    noFilterResults.classList.remove("d-none");

                }
                else {

                    noFilterResults.classList.add("d-none");

                }

            }

        }


        function resetAllFilters() {

            if (searchInput) {
                searchInput.value = "";
            }

            if (statusFilter) {
                statusFilter.value = "All";
            }

            if (stayFilter) {
                stayFilter.value = "All";
            }

            filterBookings();

        }


        if (searchInput) {

            searchInput.addEventListener(
                "input",
                filterBookings
            );

        }


        if (statusFilter) {

            statusFilter.addEventListener(
                "change",
                filterBookings
            );

        }


        if (stayFilter) {

            stayFilter.addEventListener(
                "change",
                filterBookings
            );

        }


        if (clearFilters) {

            clearFilters.addEventListener(
                "click",
                resetAllFilters
            );

        }


        if (resetFiltersButton) {

            resetFiltersButton.addEventListener(
                "click",
                resetAllFilters
            );

        }

    });

</script>
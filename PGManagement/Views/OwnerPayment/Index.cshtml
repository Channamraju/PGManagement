@model IEnumerable<PGManagement.Models.Payment>

@{
    ViewData["Title"] = "Payment Management";

    var payments = Model?.ToList()
        ?? new List<PGManagement.Models.Payment>();

    var successfulPayments = payments
        .Where(p => p.Status == "Success")
        .ToList();

    var totalAmount = successfulPayments.Sum(p => p.Amount);

    var monthlyAmount = successfulPayments
        .Where(p => p.PaymentType == "Monthly")
        .Sum(p => p.Amount);

    var dailyAmount = successfulPayments
        .Where(p => p.PaymentType == "Daily")
        .Sum(p => p.Amount);

    var todayAmount = successfulPayments
        .Where(p => p.PaymentDate.Date == DateTime.Today)
        .Sum(p => p.Amount);

    var successfulCount = successfulPayments.Count;

    var failedCount = payments.Count(p => p.Status != "Success");
}

<div class="container-fluid payment-page">

    <!-- HEADER -->
    <div class="page-header">

        <div>
            <span class="page-label">
                <i class="bi bi-wallet2"></i>
                FINANCIAL MANAGEMENT
            </span>

            <h2>
                Payment Management
            </h2>

            <p>
                Track tenant payments and PG collections.
            </p>
        </div>

        <a asp-controller="Owner"
           asp-action="Dashboard"
           class="dashboard-btn">

            <i class="bi bi-grid-1x2"></i>
            Dashboard

        </a>

    </div>


    <!-- SUMMARY CARDS -->
    <div class="summary-grid">

        <!-- TOTAL COLLECTION -->
        <div class="summary-card collection-card">

            <div class="summary-icon">
                <i class="bi bi-currency-rupee"></i>
            </div>

            <div class="summary-content">

                <span>Total Collection</span>

                <h3>
                    ₹@totalAmount.ToString("N2")
                </h3>

                <small>
                    Successful payments
                </small>

            </div>

        </div>


        <!-- MONTHLY -->
        <div class="summary-card">

            <div class="summary-icon monthly-icon">
                <i class="bi bi-calendar-month"></i>
            </div>

            <div class="summary-content">

                <span>Monthly Collection</span>

                <h3>
                    ₹@monthlyAmount.ToString("N2")
                </h3>

                <small>
                    Monthly rent payments
                </small>

            </div>

        </div>


        <!-- DAILY -->
        <div class="summary-card">

            <div class="summary-icon daily-icon">
                <i class="bi bi-calendar-day"></i>
            </div>

            <div class="summary-content">

                <span>Daily Collection</span>

                <h3>
                    ₹@dailyAmount.ToString("N2")
                </h3>

                <small>
                    Daily stay payments
                </small>

            </div>

        </div>


        <!-- TODAY -->
        <div class="summary-card">

            <div class="summary-icon today-icon">
                <i class="bi bi-calendar-check"></i>
            </div>

            <div class="summary-content">

                <span>Today's Collection</span>

                <h3>
                    ₹@todayAmount.ToString("N2")
                </h3>

                <small>
                    Payments received today
                </small>

            </div>

        </div>

    </div>


    <!-- TRANSACTION STATS -->
    <div class="transaction-stats">

        <div>
            <i class="bi bi-receipt"></i>

            <span>Total Transactions</span>

            <strong>
                @payments.Count
            </strong>
        </div>


        <div>
            <i class="bi bi-check-circle"></i>

            <span>Successful</span>

            <strong class="success-text">
                @successfulCount
            </strong>
        </div>


        <div>
            <i class="bi bi-x-circle"></i>

            <span>Failed</span>

            <strong class="danger-text">
                @failedCount
            </strong>
        </div>

    </div>


    <!-- PAYMENT TABLE -->
    <div class="payment-section">

        <div class="section-header">

            <div>
                <h3>
                    <i class="bi bi-credit-card"></i>
                    Payment Transactions
                </h3>

                <p>
                    Complete payment history for your PGs
                </p>
            </div>

            <div class="payment-count">
                @payments.Count Transactions
            </div>

        </div>


        @if (!payments.Any())
        {
            <div class="empty-state">

                <div class="empty-icon">
                    <i class="bi bi-receipt"></i>
                </div>

                <h4>
                    No Payments Found
                </h4>

                <p>
                    No tenant payments have been received yet.
                </p>

                <a asp-controller="OwnerBooking"
                   asp-action="Index"
                   class="btn btn-primary">

                    <i class="bi bi-calendar-check"></i>
                    View Bookings

                </a>

            </div>
        }
        else
        {
            <!-- SEARCH / FILTER -->
            <div class="filter-bar">

                <div class="search-box">

                    <i class="bi bi-search"></i>

                    <input type="text"
                           id="paymentSearch"
                           placeholder="Search tenant, PG, room or transaction..." />

                </div>


                <select id="paymentTypeFilter"
                        class="filter-select">

                    <option value="all">
                        All Payment Types
                    </option>

                    <option value="monthly">
                        Monthly
                    </option>

                    <option value="daily">
                        Daily
                    </option>

                </select>


                <select id="paymentStatusFilter"
                        class="filter-select">

                    <option value="all">
                        All Status
                    </option>

                    <option value="success">
                        Success
                    </option>

                    <option value="failed">
                        Failed
                    </option>

                </select>

            </div>


            <div class="table-wrapper">

                <table class="payment-table"
                       id="paymentTable">

                    <thead>

                        <tr>

                            <th>#</th>

                            <th>Transaction</th>

                            <th>Tenant</th>

                            <th>PG / Room</th>

                            <th>Bed</th>

                            <th>Payment Type</th>

                            <th>Billing Period</th>

                            <th>Amount</th>

                            <th>Method</th>

                            <th>Payment Date</th>

                            <th>Status</th>

                            <th>Action</th>

                        </tr>

                    </thead>


                    <tbody>

                        @{
                            int count = 1;
                        }

                        @foreach (var payment in payments)
                        {
                            var tenantName =
                                payment.User?.FullName ?? "Unknown Tenant";

                            var pgName =
                                payment.Booking?.PG?.PGName ?? "N/A";

                            var roomNumber =
                                payment.Booking?.Room?.RoomNumber ?? "N/A";

                            var bedNumber =
                                payment.Booking?.Bed?.BedNumber ?? "N/A";

                            var type =
                                payment.PaymentType ?? "";

                            var status =
                                payment.Status ?? "";

                            <tr class="payment-row"
                                data-search="@($"{tenantName} {pgName} {roomNumber} {bedNumber} {payment.TransactionId}".ToLower())"
                                data-type="@type.ToLower()"
                                data-status="@status.ToLower()">

                                <!-- NUMBER -->
                                <td>
                                    <span class="row-number">
                                        @count
                                    </span>
                                </td>


                                <!-- TRANSACTION -->
                                <td>

                                    <div class="transaction-cell">

                                        <div class="transaction-icon">
                                            <i class="bi bi-receipt"></i>
                                        </div>

                                        <div>

                                            <strong>
                                                @payment.TransactionId
                                            </strong>

                                            <small>
                                                Payment #@payment.PaymentId
                                            </small>

                                        </div>

                                    </div>

                                </td>


                                <!-- TENANT -->
                                <td>

                                    <div class="tenant-cell">

                                        <div class="tenant-avatar">
                                            @{
                                                var initials =
                                                    string.Join("",
                                                        tenantName
                                                            .Split(
                                                                ' ',
                                                                StringSplitOptions.RemoveEmptyEntries)
                                                            .Take(2)
                                                            .Select(x => x[0]))
                                                    .ToUpper();
                                            }

                                            @initials
                                        </div>

                                        <div>

                                            <strong>
                                                @tenantName
                                            </strong>

                                            <small>
                                                @(payment.User?.Phone ?? "")
                                            </small>

                                        </div>

                                    </div>

                                </td>


                                <!-- PG / ROOM -->
                                <td>

                                    <div class="pg-cell">

                                        <strong>
                                            @pgName
                                        </strong>

                                        <small>
                                            <i class="bi bi-door-open"></i>
                                            Room @roomNumber
                                        </small>

                                    </div>

                                </td>


                                <!-- BED -->
                                <td>

                                    <span class="bed-badge">

                                        <i class="bi bi-bed"></i>

                                        @bedNumber

                                    </span>

                                </td>


                                <!-- PAYMENT TYPE -->
                                <td>

                                    @if (payment.PaymentType == "Monthly")
                                    {
                                        <span class="type-badge monthly">

                                            <i class="bi bi-calendar-month"></i>
                                            Monthly

                                        </span>
                                    }
                                    else if (payment.PaymentType == "Daily")
                                    {
                                        <span class="type-badge daily">

                                            <i class="bi bi-calendar-day"></i>
                                            Daily

                                        </span>
                                    }
                                    else
                                    {
                                        <span class="type-badge">

                                            @payment.PaymentType

                                        </span>
                                    }

                                </td>


                                <!-- BILLING PERIOD -->
                                <td>

                                    @if (payment.PaymentType == "Monthly"
                                   && payment.BillingMonth.HasValue)
                                    {
                                        <div class="billing-period">

                                            <strong>
                                                @payment.BillingMonth.Value
                                                .ToString("MMMM yyyy")
                                            </strong>

                                            <small>
                                                Monthly billing
                                            </small>

                                        </div>
                                    }
                                    else if (payment.FromDate.HasValue)
                                    {
                                        <div class="billing-period">

                                            <strong>
                                                @payment.FromDate.Value
                                                .ToString("dd MMM yyyy")
                                            </strong>

                                            @if (payment.ToDate.HasValue)
                                            {
                                                <small>
                                                    to
                                                    @payment.ToDate.Value
                                                    .ToString("dd MMM yyyy")
                                                </small>
                                            }

                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            -
                                        </span>
                                    }

                                </td>


                                <!-- AMOUNT -->
                                <td>

                                    <strong class="amount">

                                        ₹@payment.Amount.ToString("N2")

                                    </strong>

                                </td>


                                <!-- METHOD -->
                                <td>

                                    <span class="method-badge">

                                        <i class="bi bi-wallet2"></i>

                                        @payment.PaymentMethod

                                    </span>

                                </td>


                                <!-- PAYMENT DATE -->
                                <td>

                                    <div class="date-cell">

                                        <strong>
                                            @payment.PaymentDate
                                            .ToString("dd MMM yyyy")
                                        </strong>

                                        <small>
                                            @payment.PaymentDate
                                            .ToString("hh:mm tt")
                                        </small>

                                    </div>

                                </td>


                                <!-- STATUS -->
                                <td>

                                    @if (payment.Status == "Success")
                                    {
                                        <span class="status-badge success">

                                            <i class="bi bi-check-circle-fill"></i>
                                            Success

                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status-badge failed">

                                            <i class="bi bi-x-circle-fill"></i>
                                            @payment.Status

                                        </span>
                                    }

                                </td>


                                <!-- ACTION -->
                                <td>

                                    <a asp-controller="OwnerPayment"
                                       asp-action="Details"
                                       asp-route-id="@payment.PaymentId"
                                       class="details-btn"
                                       title="View payment details">

                                        <i class="bi bi-eye"></i>

                                    </a>

                                </td>

                            </tr>

                            count++;
                        }

                    </tbody>

                </table>

            </div>


            <div id="noResults"
                 class="no-results"
                 style="display:none;">

                <i class="bi bi-search"></i>

                <h5>
                    No matching payments
                </h5>

                <p>
                    Try changing your search or filters.
                </p>

            </div>
        }

    </div>

</div>


<!-- ============================= -->
<!-- JAVASCRIPT -->
<!-- ============================= -->

<script>

    const searchInput =
        document.getElementById("paymentSearch");

    const typeFilter =
        document.getElementById("paymentTypeFilter");

    const statusFilter =
        document.getElementById("paymentStatusFilter");

    const rows =
        document.querySelectorAll(".payment-row");

    const noResults =
        document.getElementById("noResults");


    function filterPayments() {

        const search =
            searchInput?.value.toLowerCase().trim() || "";

        const type =
            typeFilter?.value.toLowerCase() || "all";

        const status =
            statusFilter?.value.toLowerCase() || "all";

        let visible = 0;


        rows.forEach(row => {

            const rowSearch =
                row.dataset.search || "";

            const rowType =
                row.dataset.type || "";

            const rowStatus =
                row.dataset.status || "";


            const searchMatch =
                rowSearch.includes(search);

            const typeMatch =
                type === "all" ||
                rowType === type;

            const statusMatch =
                status === "all" ||
                (status === "failed"
                    ? rowStatus !== "success"
                    : rowStatus === status);


            if (
                searchMatch &&
                typeMatch &&
                statusMatch
            ) {

                row.style.display = "";

                visible++;

            }
            else {

                row.style.display = "none";

            }

        });


        if (noResults) {

            noResults.style.display =
                visible === 0 ? "block" : "none";

        }

    }


    searchInput?.addEventListener(
        "input",
        filterPayments
    );

    typeFilter?.addEventListener(
        "change",
        filterPayments
    );

    statusFilter?.addEventListener(
        "change",
        filterPayments
    );

</script>



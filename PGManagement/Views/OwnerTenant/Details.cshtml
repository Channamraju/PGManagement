@model PGManagement.Models.Booking

@{
    ViewData["Title"] = "Tenant Details";

    var tenantName = Model.User?.FullName ?? "Unknown Tenant";
    var initials = string.Join("",
        tenantName
            .Split(' ', StringSplitOptions.RemoveEmptyEntries)
            .Take(2)
            .Select(x => x[0]))
        .ToUpper();

    var statusClass = Model.Status switch
    {
        "Confirmed" => "status-confirmed",
        "Completed" => "status-completed",
        "Cancelled" => "status-cancelled",
        _ => "status-pending"
    };

    var payments = Model.Payments?
        .Where(p => p.Status == "Success")
        .OrderByDescending(p => p.PaymentDate)
        .ToList()
        ?? new List<PGManagement.Models.Payment>();

    var totalPaid = payments.Sum(p => p.Amount);
    var paymentCount = payments.Count;
    var latestPayment = payments.FirstOrDefault();

    // ---------------------------------------------
    // NEXT PAYMENT CALCULATION
    // ---------------------------------------------

    int paidMonths = payments.Count(
        p => p.PaymentType == "Monthly");

    DateTime? nextPaymentDate = null;
    decimal nextPaymentAmount = 0;

    if (Model.Status == "Confirmed")
    {
        if (Model.StayType == "Monthly")
        {
            nextPaymentDate =
                Model.StartDate.AddMonths(paidMonths);

            nextPaymentAmount =
                Model.Room?.MonthlyRent ?? 0;
        }
        else if (Model.StayType == "Daily")
        {
            var dailyPaymentExists =
                payments.Any(p => p.PaymentType == "Daily");

            if (!dailyPaymentExists)
            {
                nextPaymentDate = Model.StartDate;
                nextPaymentAmount = Model.TotalAmount;
            }
        }
    }

    bool paymentDue =
        nextPaymentDate.HasValue &&
        DateTime.Today >= nextPaymentDate.Value;

    string nextPaymentPeriod = "";

    if (nextPaymentDate.HasValue)
    {
        if (Model.StayType == "Monthly")
        {
            nextPaymentPeriod =
                nextPaymentDate.Value.ToString("MMMM yyyy");
        }
        else
        {
            nextPaymentPeriod =
                $"{Model.StartDate:dd MMM yyyy} - {Model.EndDate:dd MMM yyyy}";
        }
    }
}

<div class="container-fluid tenant-details-page">

    <!-- HEADER -->
    <div class="page-header">

        <div>
            <a asp-action="Index"
               class="back-link">
                <i class="bi bi-arrow-left"></i>
                Back to Tenants
            </a>

            <h2>
                <i class="bi bi-person-vcard"></i>
                Tenant Details
            </h2>

            <p>
                View tenant, booking and payment information
            </p>
        </div>

        <div class="header-status @statusClass">
            @if (Model.Status == "Confirmed")
            {
                <i class="bi bi-check-circle-fill"></i>
            }
            else if (Model.Status == "Completed")
            {
                <i class="bi bi-check2-all"></i>
            }
            else if (Model.Status == "Cancelled")
            {
                <i class="bi bi-x-circle-fill"></i>
            }
            else
            {
                <i class="bi bi-clock-fill"></i>
            }

            @Model.Status
        </div>

    </div>


    <!-- TENANT PROFILE -->
    <div class="profile-card">

        <div class="profile-left">

            <div class="profile-avatar">
                @initials
            </div>

            <div>
                <h3>@tenantName</h3>

                <div class="profile-meta">
                    <span>
                        <i class="bi bi-envelope"></i>
                        @Model.User?.Email
                    </span>

                    <span>
                        <i class="bi bi-telephone"></i>
                        @Model.User?.Phone
                    </span>
                </div>
            </div>

        </div>

        <div class="profile-id">
            <span>Booking ID</span>
            <strong>#@Model.BookingId</strong>
        </div>

    </div>


    <!-- MAIN GRID -->
    <div class="details-grid">

        <!-- PERSONAL INFORMATION -->
        <div class="info-card">

            <div class="card-title">
                <div class="title-icon">
                    <i class="bi bi-person"></i>
                </div>

                <div>
                    <h4>Personal Information</h4>
                    <span>Tenant contact details</span>
                </div>
            </div>

            <div class="info-list">

                <div class="info-row">
                    <span>
                        <i class="bi bi-person"></i>
                        Full Name
                    </span>

                    <strong>
                        @Model.User?.FullName
                    </strong>
                </div>

                <div class="info-row">
                    <span>
                        <i class="bi bi-envelope"></i>
                        Email
                    </span>

                    <strong>
                        @Model.User?.Email
                    </strong>
                </div>

                <div class="info-row">
                    <span>
                        <i class="bi bi-phone"></i>
                        Phone
                    </span>

                    <strong>
                        @Model.User?.Phone
                    </strong>
                </div>

                <div class="info-row">
                    <span>
                        <i class="bi bi-geo-alt"></i>
                        Address
                    </span>

                    <strong>
                        @Model.User?.Address
                    </strong>
                </div>

            </div>

        </div>


        <!-- BOOKING INFORMATION -->
        <div class="info-card">

            <div class="card-title">
                <div class="title-icon">
                    <i class="bi bi-calendar-check"></i>
                </div>

                <div>
                    <h4>Booking Information</h4>
                    <span>Stay and booking details</span>
                </div>
            </div>

            <div class="info-list">

                <div class="info-row">
                    <span>
                        <i class="bi bi-hash"></i>
                        Booking ID
                    </span>

                    <strong>
                        #@Model.BookingId
                    </strong>
                </div>

                <div class="info-row">
                    <span>
                        <i class="bi bi-calendar-plus"></i>
                        Booking Date
                    </span>

                    <strong>
                        @Model.BookingDate.ToString("dd MMM yyyy")
                    </strong>
                </div>

                <div class="info-row">
                    <span>
                        <i class="bi bi-house"></i>
                        Stay Type
                    </span>

                    <strong>
                        @Model.StayType
                    </strong>
                </div>

                <div class="info-row">
                    <span>
                        <i class="bi bi-calendar-event"></i>
                        Start Date
                    </span>

                    <strong>
                        @Model.StartDate.ToString("dd MMM yyyy")
                    </strong>
                </div>

                @if (Model.StayType == "Daily" && Model.EndDate.HasValue)
                {
                    <div class="info-row">
                        <span>
                            <i class="bi bi-calendar-x"></i>
                            End Date
                        </span>

                        <strong>
                            @Model.EndDate.Value.ToString("dd MMM yyyy")
                        </strong>
                    </div>
                }

            </div>

        </div>


        <!-- PG / ROOM -->
        <div class="info-card">

            <div class="card-title">
                <div class="title-icon">
                    <i class="bi bi-building"></i>
                </div>

                <div>
                    <h4>PG & Room</h4>
                    <span>Accommodation details</span>
                </div>
            </div>

            <div class="location-box">

                <div class="location-icon">
                    <i class="bi bi-building-fill"></i>
                </div>

                <div>
                    <span>PG</span>
                    <strong>
                        @Model.PG?.PGName
                    </strong>
                </div>

            </div>

            <div class="room-grid">

                <div>
                    <span>Room</span>
                    <strong>
                        @Model.Room?.RoomNumber
                    </strong>
                </div>

                <div>
                    <span>Room Type</span>
                    <strong>
                        @Model.Room?.RoomType
                    </strong>
                </div>

                <div>
                    <span>Sharing</span>
                    <strong>
                        @Model.Room?.SharingType
                    </strong>
                </div>

                <div>
                    <span>Bed</span>
                    <strong>
                        @Model.Bed?.BedNumber
                    </strong>
                </div>

            </div>

        </div>


        <!-- RENT SUMMARY -->
        <div class="info-card">

            <div class="card-title">
                <div class="title-icon">
                    <i class="bi bi-cash-stack"></i>
                </div>

                <div>
                    <h4>Rent Summary</h4>
                    <span>Booking amount details</span>
                </div>
            </div>

            @if (Model.StayType == "Monthly")
            {
                <div class="rent-highlight">

                    <div>
                        <span>Monthly Rent</span>

                        <strong>
                            ₹@((Model.Room?.MonthlyRent ?? 0).ToString("N2"))
                        </strong>
                    </div>

                    <i class="bi bi-calendar-month"></i>

                </div>
            }
            else
            {
                <div class="rent-highlight">

                    <div>
                        <span>Daily Rent</span>

                        <strong>
                            ₹@((Model.Room?.DailyRent ?? 0).ToString("N2"))
                        </strong>
                    </div>

                    <i class="bi bi-calendar-day"></i>

                </div>

                <div class="total-box">

                    <span>Total Booking Amount</span>

                    <strong>
                        ₹@Model.TotalAmount.ToString("N2")
                    </strong>

                </div>
            }

        </div>

    </div>


    <!-- PAYMENT SUMMARY -->
    <div class="section-title">
        <div>
            <h3>
                <i class="bi bi-credit-card"></i>
                Payment Overview
            </h3>

            <p>
                Payment status and next payment information
            </p>
        </div>
    </div>

    <div class="payment-summary-grid">

        <div class="payment-stat">
            <div class="payment-stat-icon">
                <i class="bi bi-wallet2"></i>
            </div>

            <div>
                <span>Total Paid</span>

                <strong>
                    ₹@totalPaid.ToString("N2")
                </strong>
            </div>
        </div>


        <div class="payment-stat">
            <div class="payment-stat-icon">
                <i class="bi bi-receipt"></i>
            </div>

            <div>
                <span>Successful Payments</span>

                <strong>
                    @paymentCount
                </strong>
            </div>
        </div>


        <div class="payment-stat">
            <div class="payment-stat-icon">
                <i class="bi bi-calendar-check"></i>
            </div>

            <div>
                <span>Stay Type</span>

                <strong>
                    @Model.StayType
                </strong>
            </div>
        </div>


        <div class="payment-stat">
            <div class="payment-stat-icon">
                <i class="bi bi-currency-rupee"></i>
            </div>

            <div>
                <span>Booking Amount</span>

                <strong>
                    ₹@Model.TotalAmount.ToString("N2")
                </strong>
            </div>
        </div>

    </div>


    <!-- NEXT PAYMENT -->
    @if (Model.Status == "Confirmed" && nextPaymentDate.HasValue)
    {
        <div class="next-payment-card @(paymentDue ? "payment-due" : "")">

            <div class="next-payment-icon">
                @if (paymentDue)
                {
                    <i class="bi bi-exclamation-circle-fill"></i>
                }
                else
                {
                    <i class="bi bi-calendar-check-fill"></i>
                }
            </div>

            <div class="next-payment-content">

                <span class="small-label">
                    @(paymentDue ? "PAYMENT DUE" : "NEXT PAYMENT")
                </span>

                <h3>
                    ₹@nextPaymentAmount.ToString("N2")
                </h3>

                <p>
                    @if (Model.StayType == "Monthly")
                    {
                        <text>
                            Monthly rent for
                            <strong>@nextPaymentPeriod</strong>
                        </text>
                    }
                    else
                    {
                        <text>
                            Daily stay payment for
                            <strong>@nextPaymentPeriod</strong>
                        </text>
                    }
                </p>

            </div>

            <div class="next-payment-date">

                <span>
                    Payment Date
                </span>

                <strong>
                    @nextPaymentDate.Value.ToString("dd MMM yyyy")
                </strong>

                @if (paymentDue)
                {
                    <small>
                        Due now
                    </small>
                }
                else
                {
                    <small>
                        Upcoming
                    </small>
                }

            </div>

        </div>
    }


    <!-- PAYMENT HISTORY -->
    <div class="section-title payment-history-title">

        <div>
            <h3>
                <i class="bi bi-clock-history"></i>
                Payment History
            </h3>

            <p>
                All successful payments made by this tenant
            </p>
        </div>

        <span class="payment-count">
            @paymentCount Payments
        </span>

    </div>


    @if (payments.Any())
    {
        <div class="payment-table-card">

            <div class="table-responsive">

                <table class="payment-table">

                    <thead>
                        <tr>
                            <th>Payment</th>
                            <th>Type</th>
                            <th>Billing Period</th>
                            <th>Amount</th>
                            <th>Method</th>
                            <th>Transaction ID</th>
                            <th>Date</th>
                            <th>Status</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var payment in payments)
                        {
                            <tr>

                                <td>
                                    <div class="payment-id">
                                        <i class="bi bi-receipt"></i>
                                        #@payment.PaymentId
                                    </div>
                                </td>

                                <td>

                                    @if (payment.PaymentType == "Monthly")
                                    {
                                        <span class="type-badge monthly">
                                            <i class="bi bi-calendar-month"></i>
                                            Monthly
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="type-badge daily">
                                            <i class="bi bi-calendar-day"></i>
                                            Daily
                                        </span>
                                    }

                                </td>

                                <td>

                                    @if (payment.PaymentType == "Monthly"
                                    && payment.BillingMonth.HasValue)
                                    {
                                        <strong>
                                            @payment.BillingMonth.Value
                                            .ToString("MMMM yyyy")
                                        </strong>
                                    }
                                    else if (payment.FromDate.HasValue)
                                    {
                                        <span>
                                            @payment.FromDate.Value
                                            .ToString("dd MMM yyyy")

                                            @if (payment.ToDate.HasValue)
                                            {
                                                <text>
                                                    -
                                                    @payment.ToDate.Value
                                                    .ToString("dd MMM yyyy")
                                                </text>
                                            }
                                        </span>
                                    }
                                    else
                                    {
                                        <span>-</span>
                                    }

                                </td>

                                <td>
                                    <strong class="amount">
                                        ₹@payment.Amount.ToString("N2")
                                    </strong>
                                </td>

                                <td>
                                    <span class="method">
                                        @payment.PaymentMethod
                                    </span>
                                </td>

                                <td>
                                    <code>
                                        @payment.TransactionId
                                    </code>
                                </td>

                                <td>
                                    @payment.PaymentDate
                                    .ToString("dd MMM yyyy")
                                    <small>
                                        @payment.PaymentDate
                                        .ToString("hh:mm tt")
                                    </small>
                                </td>

                                <td>
                                    <span class="success-badge">
                                        <i class="bi bi-check-circle-fill"></i>
                                        Paid
                                    </span>
                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>
    }
    else
    {
        <div class="empty-payment">

            <div class="empty-icon">
                <i class="bi bi-credit-card-2-front"></i>
            </div>

            <h4>No Payments Yet</h4>

            <p>
                This tenant has not made any successful payments.
            </p>

        </div>
    }


    <!-- OWNER ACTIONS -->
    <div class="action-section">

        <div>
            <h3>
                <i class="bi bi-lightning-charge"></i>
                Booking Actions
            </h3>

            <p>
                Manage this tenant's booking
            </p>
        </div>

        <div class="action-buttons">

            @if (Model.Status == "Pending")
            {
                <form asp-action="Approve"
                      method="post"
                      class="action-form">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           name="id"
                           value="@Model.BookingId" />

                    <button type="submit"
                            class="btn-action approve"
                            onclick="return confirm('Approve this booking?');">

                        <i class="bi bi-check-circle"></i>
                        Approve Booking

                    </button>

                </form>

                <form asp-action="Reject"
                      method="post"
                      class="action-form">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           name="id"
                           value="@Model.BookingId" />

                    <button type="submit"
                            class="btn-action reject"
                            onclick="return confirm('Reject this booking?');">

                        <i class="bi bi-x-circle"></i>
                        Reject Booking

                    </button>

                </form>
            }

            @if (Model.Status == "Confirmed")
            {
                <form asp-action="Checkout"
                      method="post"
                      class="action-form">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           name="id"
                           value="@Model.BookingId" />

                    <button type="submit"
                            class="btn-action checkout"
                            onclick="return confirm('Checkout this tenant?');">

                        <i class="bi bi-box-arrow-right"></i>
                        Checkout Tenant

                    </button>

                </form>
            }

            <a asp-action="Index"
               class="btn-action back">

                <i class="bi bi-arrow-left"></i>
                Back

            </a>

        </div>

    </div>

</div>



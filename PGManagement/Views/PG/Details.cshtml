@model PGManagement.Models.PG

@{
    ViewData["Title"] = "PG Details";
}

<div class="container py-4">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">@Model.PGName</h2>
            <p class="text-muted mb-0">
                <i class="bi bi-geo-alt"></i>
                @Model.City
            </p>
        </div>

        <a asp-controller="UserPG"
           asp-action="Index"
           class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i>
            Back to PGs
        </a>
    </div>

    <!-- PG Information -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">
                <i class="bi bi-building"></i>
                PG Information
            </h5>
        </div>

        <div class="card-body">

            <div class="row g-4">

                <div class="col-md-6">
                    <label class="text-muted">PG Name</label>
                    <div class="fw-semibold">
                        @Model.PGName
                    </div>
                </div>

                <div class="col-md-6">
                    <label class="text-muted">Address</label>
                    <div class="fw-semibold">
                        @Model.Address
                    </div>
                </div>

                <div class="col-md-6">
                    <label class="text-muted">City</label>
                    <div class="fw-semibold">
                        @Model.City
                    </div>
                </div>

                <div class="col-md-6">
                    <label class="text-muted">Gender Type</label>
                    <div class="fw-semibold">
                        @Model.GenderType
                    </div>
                </div>

                <div class="col-md-12">
                    <label class="text-muted">Description</label>
                    <div class="fw-semibold">
                        @Model.Description
                    </div>
                </div>

                <div class="col-md-6">
                    <label class="text-muted">Status</label>
                    <div>
                        <span class="badge bg-success">
                            @Model.Status
                        </span>
                    </div>
                </div>

            </div>

        </div>
    </div>

    <!-- Owner Information -->
    @if (Model.Owner != null)
    {
        <div class="card shadow-sm border-0 mb-4">

            <div class="card-header bg-dark text-white">
                <h5 class="mb-0">
                    <i class="bi bi-person-circle"></i>
                    Owner Information
                </h5>
            </div>

            <div class="card-body">

                <div class="row g-3">

                    <div class="col-md-6">
                        <strong>Name</strong>
                        <div class="text-muted">
                            @Model.Owner.FullName
                        </div>
                    </div>

                    <div class="col-md-6">
                        <strong>Email</strong>
                        <div class="text-muted">
                            @Model.Owner.Email
                        </div>
                    </div>

                    <div class="col-md-6">
                        <strong>Phone</strong>
                        <div class="text-muted">
                            @Model.Owner.Phone
                        </div>
                    </div>

                    <div class="col-md-6">
                        <strong>Address</strong>
                        <div class="text-muted">
                            @Model.Owner.Address
                        </div>
                    </div>

                </div>

            </div>
        </div>
    }

    <!-- Rooms -->
    <div class="card shadow-sm border-0">

        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">
                <i class="bi bi-door-open"></i>
                Available Rooms
            </h5>
        </div>

        <div class="card-body">

            @if (Model.Rooms != null && Model.Rooms.Any())
            {
                foreach (var room in Model.Rooms)
                {
                    var availableBeds = room.Beds?
                        .Where(b => b.Status == "Available")
                        .ToList()
                        ?? new List<PGManagement.Models.Bed>();

                    <div class="border rounded-3 p-4 mb-4">

                        <!-- Room Header -->
                        <div class="d-flex justify-content-between align-items-center mb-3">

                            <div>
                                <h5 class="fw-bold mb-1">
                                    <i class="bi bi-door-open"></i>
                                    Room @room.RoomNumber
                                </h5>

                                <div class="text-muted">
                                    @room.RoomType |
                                    @room.SharingType
                                </div>
                            </div>

                            <span class="badge bg-success">
                                @availableBeds.Count Available
                            </span>

                        </div>

                        <!-- Rent -->
                        <div class="row g-3 mb-4">

                            <div class="col-md-6">
                                <div class="bg-light rounded p-3">
                                    <small class="text-muted">
                                        Monthly Rent
                                    </small>

                                    <h5 class="mb-0">
                                        ₹@room.MonthlyRent
                                    </h5>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="bg-light rounded p-3">
                                    <small class="text-muted">
                                        Daily Rent
                                    </small>

                                    <h5 class="mb-0">
                                        ₹@room.DailyRent
                                    </h5>
                                </div>
                            </div>

                        </div>

                        <!-- Available Beds -->
                        @if (availableBeds.Any())
                        {
                            <h6 class="fw-bold mb-3">
                                Select Bed
                            </h6>

                            foreach (var bed in availableBeds)
                            {
                                <div class="border rounded-3 p-3 mb-3">

                                    <div class="row align-items-center g-3">

                                        <!-- Bed -->
                                        <div class="col-md-3">

                                            <div class="fw-bold">
                                                <i class="bi bi-house-door"></i>
                                                Bed @bed.BedNumber
                                            </div>

                                            <span class="badge bg-success">
                                                Available
                                            </span>

                                        </div>

                                        <!-- Stay Type -->
                                        <div class="col-md-3">

                                            <label class="form-label fw-semibold">
                                                Stay Type
                                            </label>

                                            <select class="form-select stay-type"
                                                    data-room="@room.RoomId"
                                                    data-bed="@bed.BedId">

                                                <option value="">
                                                    Select Monthly or Daily
                                                </option>

                                                <option value="Monthly">
                                                    Monthly
                                                </option>

                                                <option value="Daily">
                                                    Daily
                                                </option>

                                            </select>

                                            <div class="text-danger small mt-1 stay-error d-none">
                                                Please select Monthly or Daily stay.
                                            </div>

                                        </div>

                                        <!-- Start Date -->
                                        <div class="col-md-2">

                                            <label class="form-label fw-semibold">
                                                Start Date
                                            </label>

                                            <input type="date"
                                                   class="form-control start-date"
                                                   value="@DateTime.Today.ToString("yyyy-MM-dd")" />

                                        </div>

                                        <!-- End Date -->
                                        <div class="col-md-2 daily-date-container d-none">

                                            <label class="form-label fw-semibold">
                                                End Date
                                            </label>

                                            <input type="date"
                                                   class="form-control end-date" />

                                        </div>

                                        <!-- Book -->
                                        <div class="col-md-2">

                                            <button type="button"
                                                    class="btn btn-primary w-100 book-btn"
                                                    data-pg="@Model.PGId"
                                                    data-room="@room.RoomId"
                                                    data-bed="@bed.BedId">

                                                <i class="bi bi-calendar-check"></i>
                                                Book

                                            </button>

                                        </div>

                                    </div>

                                </div>
                            }
                        }
                        else
                        {
                            <div class="alert alert-warning mb-0">
                                <i class="bi bi-exclamation-triangle"></i>
                                No beds are currently available.
                            </div>
                        }

                    </div>
                }
            }
            else
            {
                <div class="alert alert-info">
                    No rooms available in this PG.
                </div>
            }

        </div>
    </div>

</div>


@section Scripts
{
    <script>

        document.querySelectorAll(".stay-type").forEach(function(select) {

            select.addEventListener("change", function() {

                const row = this.closest(".border");

                const dailyContainer =
                    row.querySelector(".daily-date-container");

                const error =
                    row.querySelector(".stay-error");

                if (this.value === "Daily") {

                    dailyContainer.classList.remove("d-none");

                }
                else {

                    dailyContainer.classList.add("d-none");

                }

                error.classList.add("d-none");

            });

        });


        document.querySelectorAll(".book-btn").forEach(function(button) {

            button.addEventListener("click", function() {

                const row = this.closest(".border");

                const stayType =
                    row.querySelector(".stay-type").value;

                const startDate =
                    row.querySelector(".start-date").value;

                const endDateInput =
                    row.querySelector(".end-date");

                const endDate =
                    endDateInput ? endDateInput.value : "";

                const error =
                    row.querySelector(".stay-error");


                // =========================================
                // VALIDATE STAY TYPE
                // =========================================

                if (!stayType) {

                    error.classList.remove("d-none");

                    return;
                }


                // =========================================
                // VALIDATE START DATE
                // =========================================

                if (!startDate) {

                    alert("Please select start date.");

                    return;
                }


                // =========================================
                // DAILY VALIDATION
                // =========================================

                if (stayType === "Daily") {

                    if (!endDate) {

                        alert("Please select end date.");

                        return;
                    }

                    if (endDate < startDate) {

                        alert(
                            "End date cannot be before start date."
                        );

                        return;
                    }

                }


                // =========================================
                // BUILD BOOKING URL
                // =========================================

                const pgId =
                    button.dataset.pg;

                const roomId =
                    button.dataset.room;

                const bedId =
                    button.dataset.bed;


                const url =
                    `/Booking/Create` +
                    `?pgId=${pgId}` +
                    `&roomId=${roomId}` +
                    `&bedId=${bedId}` +
                    `&stayType=${encodeURIComponent(stayType)}` +
                    `&startDate=${encodeURIComponent(startDate)}` +
                    (endDate
                        ? `&endDate=${encodeURIComponent(endDate)}`
                        : "");


                window.location.href = url;

            });

        });

    </script>
}
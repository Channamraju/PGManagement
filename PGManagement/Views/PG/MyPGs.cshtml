@model IEnumerable<PGManagement.Models.PG>

@{
    ViewData["Title"] = "My PGs";
}

<div class="container mt-4">

    <!-- ============================== -->
    <!-- HEADER -->
    <!-- ============================== -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-buildings"></i>
                My PGs
            </h2>

            <p class="text-muted mb-0">
                Manage your PG properties.
            </p>
        </div>

        <a asp-controller="PG"
           asp-action="Create"
           class="btn btn-primary">

            <i class="bi bi-plus-lg"></i>
            Add New PG

        </a>

    </div>


    <!-- ============================== -->
    <!-- SUCCESS MESSAGE -->
    <!-- ============================== -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">

            <i class="bi bi-check-circle"></i>

            @TempData["Success"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    <!-- ============================== -->
    <!-- ERROR MESSAGE -->
    <!-- ============================== -->
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">

            <i class="bi bi-exclamation-triangle"></i>

            @TempData["Error"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    <!-- ============================== -->
    <!-- NO PG -->
    <!-- ============================== -->
    @if (Model == null || !Model.Any())
    {
        <div class="card shadow-sm border-0">

            <div class="card-body text-center p-5">

                <i class="bi bi-building text-muted"
                   style="font-size:70px;">
                </i>

                <h4 class="mt-3">
                    No PGs Found
                </h4>

                <p class="text-muted">
                    You have not added any PG yet.
                </p>

                <a asp-controller="PG"
                   asp-action="Create"
                   class="btn btn-primary">

                    <i class="bi bi-plus-lg"></i>
                    Add New PG

                </a>

            </div>

        </div>
    }
    else
    {
        <!-- ============================== -->
        <!-- PG CARDS -->
        <!-- ============================== -->

        <div class="row g-4">

            @foreach (var pg in Model)
            {
                <div class="col-md-6 col-lg-4">

                    <div class="card shadow-sm border-0 h-100">

                        <!-- ====================== -->
                        <!-- PG IMAGE -->
                        <!-- ====================== -->
                        @if (!string.IsNullOrEmpty(pg.ImagePath))
                        {
                            <img src="@pg.ImagePath"
                                 alt="@pg.PGName"
                                 class="card-img-top"
                                 style="
                            height:220px;
                            object-fit:cover;
                            " />
                        }
                        else
                        {
                            <div class="d-flex justify-content-center align-items-center bg-light"
                                 style="height:220px;">

                                <div class="text-center">

                                    <i class="bi bi-building text-muted"
                                       style="font-size:70px;">
                                    </i>

                                    <p class="text-muted mb-0 mt-2">
                                        No PG image uploaded
                                    </p>

                                </div>

                            </div>
                        }


                        <!-- ====================== -->
                        <!-- PG DETAILS -->
                        <!-- ====================== -->

                        <div class="card-body">

                            <!-- PG NAME -->

                            <h4 class="fw-bold mb-3">
                                @pg.PGName
                            </h4>


                            <!-- CITY -->

                            <p class="mb-2">

                                <i class="bi bi-geo-alt text-primary"></i>

                                <strong>
                                    City:
                                </strong>

                                @pg.City

                            </p>


                            <!-- ADDRESS -->

                            <p class="mb-2">

                                <i class="bi bi-pin-map text-primary"></i>

                                <strong>
                                    Address:
                                </strong>

                                @pg.Address

                            </p>


                            <!-- GENDER -->

                            <p class="mb-2">

                                <i class="bi bi-people text-primary"></i>

                                <strong>
                                    Gender:
                                </strong>

                                @pg.GenderType

                            </p>


                            <!-- STATUS -->

                            <p class="mb-3">

                                <i class="bi bi-check-circle text-primary"></i>

                                <strong>
                                    Status:
                                </strong>

                                @if (pg.Status == "Approved")
                                {
                                    <span class="badge bg-success">
                                        Approved
                                    </span>
                                }
                                else if (pg.Status == "Rejected")
                                {
                                    <span class="badge bg-danger">
                                        Rejected
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">
                                        @pg.Status
                                    </span>
                                }

                            </p>


                            <!-- VIEW DETAILS -->

                            <a asp-controller="PG"
                               asp-action="Details"
                               asp-route-id="@pg.PGId"
                               class="btn btn-outline-primary w-100">

                                <i class="bi bi-eye"></i>
                                View Details

                            </a>

                        </div>

                    </div>

                </div>
            }

        </div>
    }

</div>
@model PGManagement.Models.Booking

@{
    ViewData["Title"] = "Make Payment";

    decimal amount = ViewBag.Amount ?? 0;

    string paymentType = ViewBag.PaymentType ?? Model.StayType ?? "Monthly";

    DateTime? fromDate = ViewBag.FromDate;
    DateTime? toDate = ViewBag.ToDate;
    DateTime? billingMonth = ViewBag.BillingMonth;
}

<link rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<div class="payment-page">

    <div class="container py-5">

        <div class="row justify-content-center">

            <div class="col-xl-8 col-lg-9">

                <!-- MAIN CARD -->
                <div class="payment-card">

                    <!-- HEADER -->
                    <div class="payment-header">

                        <div class="header-icon">
                            <i class="bi bi-shield-check"></i>
                        </div>

                        <div>
                            <h2 class="mb-1">
                                Make Payment
                            </h2>

                            <p class="mb-0">
                                Complete your confirmed booking payment securely
                            </p>
                        </div>

                    </div>


                    <div class="card-body-custom">

                        <!-- PAYMENT TYPE -->
                        <div class="stay-banner">

                            <div class="stay-icon">
                                @if (paymentType == "Daily")
                                {
                                    <i class="bi bi-calendar-day"></i>
                                }
                                else
                                {
                                    <i class="bi bi-calendar-month"></i>
                                }
                            </div>

                            <div class="stay-content">

                                <small>Payment Type</small>

                                <strong>
                                    @paymentType Stay
                                </strong>

                                @if (paymentType == "Monthly" && billingMonth.HasValue)
                                {
                                    <span>
                                        Billing Month:
                                        @billingMonth.Value.ToString("MMMM yyyy")
                                    </span>
                                }

                            </div>

                        </div>


                        <!-- BOOKING DETAILS -->
                        <div class="section-title">

                            <i class="bi bi-house-door"></i>

                            Booking Details

                        </div>


                        <div class="row g-3">

                            <div class="col-md-6">

                                <div class="info-card">

                                    <div class="info-icon">
                                        <i class="bi bi-building"></i>
                                    </div>

                                    <div>
                                        <small>PG</small>

                                        <strong>
                                            @(ViewBag.PGName ?? "N/A")
                                        </strong>
                                    </div>

                                </div>

                            </div>


                            <div class="col-md-3">

                                <div class="info-card">

                                    <div class="info-icon">
                                        <i class="bi bi-door-open"></i>
                                    </div>

                                    <div>
                                        <small>Room</small>

                                        <strong>
                                            @(ViewBag.RoomNumber ?? "-")
                                        </strong>
                                    </div>

                                </div>

                            </div>


                            <div class="col-md-3">

                                <div class="info-card">

                                    <div class="info-icon">
                                        <i class="bi bi-grid-3x3-gap"></i>
                                    </div>

                                    <div>
                                        <small>Bed</small>

                                        <strong>
                                            @(ViewBag.BedNumber ?? "-")
                                        </strong>
                                    </div>

                                </div>

                            </div>

                        </div>


                        <!-- BILLING PERIOD -->
                        @if (fromDate.HasValue && toDate.HasValue)
                        {
                            <div class="billing-box mt-4">

                                <div class="billing-icon">
                                    <i class="bi bi-calendar-range"></i>
                                </div>

                                <div class="billing-content">

                                    <small>Billing Period</small>

                                    <strong>
                                        @fromDate.Value.ToString("dd MMM yyyy")
                                        -
                                        @toDate.Value.ToString("dd MMM yyyy")
                                    </strong>

                                    @if (paymentType == "Daily")
                                    {
                                        int days =
                                            (toDate.Value.Date - fromDate.Value.Date).Days + 1;

                                        <span>
                                            @days day@(days == 1 ? "" : "s") stay
                                        </span>
                                    }
                                    else
                                    {
                                        <span>
                                            One month payment
                                        </span>
                                    }

                                </div>

                            </div>
                        }


                        <!-- AMOUNT -->
                        <div class="amount-box mt-4">

                            <div class="amount-label">
                                Amount to Pay
                            </div>

                            <div class="amount">
                                <span>₹</span>@amount.ToString("N2")
                            </div>

                            <div class="amount-note">

                                @if (paymentType == "Monthly")
                                {
                                    <span>
                                        Monthly rent payment
                                    </span>
                                }
                                else
                                {
                                    <span>
                                        Daily rent for selected stay period
                                    </span>
                                }

                            </div>

                        </div>


                        <hr class="my-4" />


                        <!-- PAYMENT FORM -->
                        <form asp-controller="Payment"
                              asp-action="Create"
                              method="post"
                              id="paymentForm">

                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="bookingId"
                                   value="@Model.BookingId" />


                            <div class="section-title">

                                <i class="bi bi-wallet2"></i>

                                Select Payment Method

                            </div>


                            <div class="payment-methods">

                                <!-- UPI -->
                                <label class="payment-option">

                                    <input type="radio"
                                           name="paymentMethod"
                                           value="UPI"
                                           required />

                                    <div class="payment-option-content">

                                        <div class="method-icon upi">
                                            <i class="bi bi-phone"></i>
                                        </div>

                                        <div>
                                            <strong>UPI</strong>
                                            <small>Google Pay, PhonePe, Paytm</small>
                                        </div>

                                        <i class="bi bi-check-circle-fill check-icon"></i>

                                    </div>

                                </label>


                                <!-- DEBIT CARD -->
                                <label class="payment-option">

                                    <input type="radio"
                                           name="paymentMethod"
                                           value="Debit Card" />

                                    <div class="payment-option-content">

                                        <div class="method-icon">
                                            <i class="bi bi-credit-card"></i>
                                        </div>

                                        <div>
                                            <strong>Debit Card</strong>
                                            <small>Pay using your debit card</small>
                                        </div>

                                        <i class="bi bi-check-circle-fill check-icon"></i>

                                    </div>

                                </label>


                                <!-- CREDIT CARD -->
                                <label class="payment-option">

                                    <input type="radio"
                                           name="paymentMethod"
                                           value="Credit Card" />

                                    <div class="payment-option-content">

                                        <div class="method-icon">
                                            <i class="bi bi-credit-card-2-front"></i>
                                        </div>

                                        <div>
                                            <strong>Credit Card</strong>
                                            <small>Pay using your credit card</small>
                                        </div>

                                        <i class="bi bi-check-circle-fill check-icon"></i>

                                    </div>

                                </label>


                                <!-- NET BANKING -->
                                <label class="payment-option">

                                    <input type="radio"
                                           name="paymentMethod"
                                           value="Net Banking" />

                                    <div class="payment-option-content">

                                        <div class="method-icon">
                                            <i class="bi bi-bank"></i>
                                        </div>

                                        <div>
                                            <strong>Net Banking</strong>
                                            <small>Pay directly from your bank</small>
                                        </div>

                                        <i class="bi bi-check-circle-fill check-icon"></i>

                                    </div>

                                </label>

                            </div>


                            <!-- DEMO PAYMENT -->
                            <div class="demo-alert mt-4">

                                <div class="demo-icon">
                                    <i class="bi bi-info-circle-fill"></i>
                                </div>

                                <div>

                                    <strong>
                                        Demo Payment
                                    </strong>

                                    <p class="mb-0">
                                        This is a demo payment system.
                                        Your selected payment will be recorded
                                        as successful without processing a real transaction.
                                    </p>

                                </div>

                            </div>


                            <!-- ACTIONS -->
                            <div class="payment-actions mt-4">

                                <a asp-controller="Booking"
                                   asp-action="MyBookings"
                                   class="btn btn-outline-secondary btn-lg">

                                    <i class="bi bi-arrow-left"></i>

                                    Back

                                </a>


                                <button type="submit"
                                        class="btn btn-success btn-lg pay-button">

                                    <i class="bi bi-lock-fill"></i>

                                    Pay ₹@amount.ToString("N2")

                                </button>

                            </div>

                        </form>

                    </div>

                </div>


                <!-- SECURITY -->
                <div class="security-note">

                    <i class="bi bi-shield-lock-fill"></i>

                    <span>
                        Your payment information is handled securely.
                    </span>

                </div>

            </div>

        </div>

    </div>

</div>


<style>

    body {
        background: #f4f7fb;
    }

    .payment-page {
        min-height: 100vh;
    }

    .payment-card {
        background: #ffffff;
        border-radius: 24px;
        overflow: hidden;
        border: 1px solid #e9ecef;
        box-shadow: 0 15px 45px rgba(0,0,0,.08);
    }

    /* HEADER */

    .payment-header {
        background: linear-gradient(135deg, #0d6efd, #4f46e5);
        color: white;
        padding: 30px;
        display: flex;
        align-items: center;
        gap: 18px;
    }

        .payment-header h2 {
            font-weight: 700;
        }

        .payment-header p {
            opacity: .9;
        }

    .header-icon {
        width: 58px;
        height: 58px;
        border-radius: 16px;
        background: rgba(255,255,255,.18);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 28px;
    }

    .card-body-custom {
        padding: 30px;
    }

    /* STAY TYPE */

    .stay-banner {
        display: flex;
        align-items: center;
        gap: 15px;
        padding: 18px;
        border-radius: 16px;
        background: #f0f7ff;
        border: 1px solid #dbeafe;
        margin-bottom: 28px;
    }

    .stay-icon {
        width: 50px;
        height: 50px;
        border-radius: 14px;
        background: #0d6efd;
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 22px;
    }

    .stay-content small {
        display: block;
        color: #6c757d;
        font-size: 12px;
    }

    .stay-content strong {
        display: block;
        font-size: 19px;
    }

    .stay-content span {
        display: block;
        color: #6c757d;
        font-size: 13px;
        margin-top: 2px;
    }

    /* SECTION TITLE */

    .section-title {
        font-size: 18px;
        font-weight: 700;
        margin-bottom: 15px;
        color: #212529;
    }

        .section-title i {
            color: #0d6efd;
            margin-right: 7px;
        }

    /* INFO */

    .info-card {
        background: #f8f9fa;
        border: 1px solid #e9ecef;
        border-radius: 15px;
        padding: 16px;
        display: flex;
        align-items: center;
        gap: 12px;
        height: 100%;
    }

    .info-icon {
        width: 42px;
        height: 42px;
        flex-shrink: 0;
        border-radius: 12px;
        background: #e8f1ff;
        color: #0d6efd;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 18px;
    }

    .info-card small {
        display: block;
        color: #6c757d;
        font-size: 12px;
    }

    .info-card strong {
        display: block;
        font-size: 16px;
        margin-top: 2px;
        word-break: break-word;
    }

    /* BILLING */

    .billing-box {
        display: flex;
        align-items: center;
        gap: 15px;
        background: #fff8e6;
        border: 1px solid #ffe8a1;
        border-radius: 15px;
        padding: 17px;
    }

    .billing-icon {
        width: 45px;
        height: 45px;
        border-radius: 12px;
        background: #ffc107;
        color: #212529;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
    }

    .billing-content small {
        display: block;
        color: #856404;
        font-size: 12px;
    }

    .billing-content strong {
        display: block;
        font-size: 17px;
    }

    .billing-content span {
        display: block;
        color: #6c757d;
        font-size: 13px;
        margin-top: 2px;
    }

    /* AMOUNT */

    .amount-box {
        text-align: center;
        background: linear-gradient(135deg, #f0f7ff, #f5f3ff);
        border-radius: 20px;
        padding: 28px 20px;
        border: 1px solid #e2e8ff;
    }

    .amount-label {
        color: #6c757d;
        font-size: 14px;
        font-weight: 600;
    }

    .amount {
        color: #0d6efd;
        font-size: 46px;
        font-weight: 800;
        line-height: 1.2;
        margin-top: 5px;
    }

        .amount span {
            font-size: 30px;
            vertical-align: 5px;
        }

    .amount-note {
        color: #6c757d;
        font-size: 13px;
        margin-top: 5px;
    }

    /* PAYMENT METHODS */

    .payment-methods {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
    }

    .payment-option {
        cursor: pointer;
        margin: 0;
    }

        .payment-option input {
            display: none;
        }

    .payment-option-content {
        min-height: 78px;
        border: 2px solid #e9ecef;
        border-radius: 15px;
        padding: 13px;
        display: flex;
        align-items: center;
        gap: 12px;
        transition: all .2s ease;
        position: relative;
    }

    .payment-option:hover .payment-option-content {
        border-color: #9ec5fe;
        background: #f8fbff;
    }

    .payment-option input:checked + .payment-option-content {
        border-color: #0d6efd;
        background: #f0f7ff;
    }

    .method-icon {
        width: 42px;
        height: 42px;
        flex-shrink: 0;
        border-radius: 11px;
        background: #eef2f7;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 19px;
        color: #495057;
    }

        .method-icon.upi {
            background: #e8f7ee;
            color: #198754;
        }

    .payment-option-content strong {
        display: block;
        font-size: 15px;
    }

    .payment-option-content small {
        display: block;
        color: #6c757d;
        font-size: 11px;
        margin-top: 2px;
    }

    .check-icon {
        color: #0d6efd;
        position: absolute;
        right: 12px;
        top: 12px;
        opacity: 0;
        transition: .2s;
    }

    .payment-option input:checked + .payment-option-content
    .check-icon {
        opacity: 1;
    }

    /* DEMO */

    .demo-alert {
        display: flex;
        gap: 12px;
        padding: 15px;
        background: #e8f7ff;
        border: 1px solid #b6e2ff;
        border-radius: 14px;
        color: #055160;
    }

    .demo-icon {
        font-size: 20px;
    }

    .demo-alert strong {
        display: block;
        margin-bottom: 3px;
    }

    .demo-alert p {
        font-size: 13px;
    }

    /* ACTIONS */

    .payment-actions {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
    }

    .pay-button {
        min-width: 210px;
        font-weight: 700;
        box-shadow: 0 7px 18px rgba(25,135,84,.2);
    }

    /* SECURITY */

    .security-note {
        text-align: center;
        color: #6c757d;
        font-size: 13px;
        padding: 18px;
    }

        .security-note i {
            color: #198754;
            margin-right: 5px;
        }

    /* RESPONSIVE */

    @@media (max-width: 768px) {

        .card-body-custom {
            padding: 20px;
        }

        .payment-header {
            padding: 22px;
        }

            .payment-header h2 {
                font-size: 22px;
            }

        .payment-methods {
            grid-template-columns: 1fr;
        }

        .amount {
            font-size: 38px;
        }

        .payment-actions {
            flex-direction: column-reverse;
            align-items: stretch;
        }

            .payment-actions a,
            .pay-button {
                width: 100%;
            }
    }

</style>
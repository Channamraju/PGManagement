@model PGManagement.Models.Room

@{
    ViewData["Title"] = "Room Details";

    var beds = Model.Beds?
        .OrderBy(x => x.BedId)
        .ToList()
        ?? new List<PGManagement.Models.Bed>();

    var totalBeds = beds.Count;
    var availableBeds = beds.Count(x => x.Status == "Available");
    var occupiedBeds = beds.Count(x => x.Status == "Occupied");

    var occupancyPercentage = totalBeds > 0
        ? (occupiedBeds * 100 / totalBeds)
        : 0;
}

<div class="container py-4">

    <!-- ========================================================= -->
    <!-- HEADER -->
    <!-- ========================================================= -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <div class="text-muted small mb-1">
                <i class="bi bi-buildings"></i>
                @(Model.PG?.PGName ?? "PG")
            </div>

            <h2 class="fw-bold mb-1">

                <i class="bi bi-door-open text-primary"></i>

                Room @Model.RoomNumber

            </h2>

            <p class="text-muted mb-0">
                Room details and bed availability
            </p>

        </div>


        <div class="d-flex gap-2">

            <a asp-controller="Room"
               asp-action="Edit"
               asp-route-id="@Model.RoomId"
               class="btn btn-primary">

                <i class="bi bi-pencil-square"></i>
                Edit

            </a>


            <a asp-controller="Room"
               asp-action="Index"
               asp-route-pgId="@Model.PGId"
               class="btn btn-outline-secondary">

                <i class="bi bi-arrow-left"></i>
                Back

            </a>

        </div>

    </div>


    <!-- ========================================================= -->
    <!-- ROOM HERO -->
    <!-- ========================================================= -->

    <div class="card border-0 shadow-sm room-hero mb-4">

        <div class="card-body p-4">

            <div class="row align-items-center">

                <div class="col-lg-8">

                    <div class="d-flex align-items-center gap-3">

                        <div class="room-icon">

                            <i class="bi bi-door-open-fill"></i>

                        </div>


                        <div>

                            <h3 class="fw-bold mb-1">
                                Room @Model.RoomNumber
                            </h3>

                            <div class="text-muted">

                                @(Model.PG?.PGName ?? "Unknown PG")

                                @if (!string.IsNullOrWhiteSpace(Model.PG?.City))
                                {
                                    <span>
                                        · @Model.PG.City
                                    </span>
                                }

                            </div>

                        </div>

                    </div>

                </div>


                <div class="col-lg-4 text-lg-end mt-3 mt-lg-0">

                    @if (availableBeds > 0)
                    {
                        <span class="status-badge available">

                            <i class="bi bi-check-circle-fill"></i>

                            Available

                        </span>
                    }
                    else
                    {
                        <span class="status-badge full">

                            <i class="bi bi-x-circle-fill"></i>

                            Full

                        </span>
                    }

                </div>

            </div>

        </div>

    </div>


    <!-- ========================================================= -->
    <!-- STATISTICS -->
    <!-- ========================================================= -->

    <div class="row g-3 mb-4">


        <!-- Total Beds -->

        <div class="col-md-4">

            <div class="stat-card">

                <div class="stat-icon total">

                    <i class="bi bi-grid-3x3-gap-fill"></i>

                </div>

                <div>

                    <small>Total Beds</small>

                    <h3>
                        @totalBeds
                    </h3>

                </div>

            </div>

        </div>


        <!-- Available -->

        <div class="col-md-4">

            <div class="stat-card">

                <div class="stat-icon available">

                    <i class="bi bi-check-circle-fill"></i>

                </div>

                <div>

                    <small>Available Beds</small>

                    <h3>
                        @availableBeds
                    </h3>

                </div>

            </div>

        </div>


        <!-- Occupied -->

        <div class="col-md-4">

            <div class="stat-card">

                <div class="stat-icon occupied">

                    <i class="bi bi-person-fill"></i>

                </div>

                <div>

                    <small>Occupied Beds</small>

                    <h3>
                        @occupiedBeds
                    </h3>

                </div>

            </div>

        </div>

    </div>


    <div class="row g-4">


        <!-- ===================================================== -->
        <!-- ROOM INFORMATION -->
        <!-- ===================================================== -->

        <div class="col-lg-5">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-header bg-white border-0 p-4">

                    <h5 class="fw-bold mb-0">

                        <i class="bi bi-info-circle text-primary"></i>

                        Room Information

                    </h5>

                </div>


                <div class="card-body px-4 pt-0">


                    <div class="info-row">

                        <span>
                            <i class="bi bi-door-closed"></i>
                            Room Number
                        </span>

                        <strong>
                            @Model.RoomNumber
                        </strong>

                    </div>


                    <div class="info-row">

                        <span>
                            <i class="bi bi-snow"></i>
                            Room Type
                        </span>

                        <strong>
                            @Model.RoomType
                        </strong>

                    </div>


                    <div class="info-row">

                        <span>
                            <i class="bi bi-people"></i>
                            Sharing Type
                        </span>

                        <strong>
                            @Model.SharingType
                        </strong>

                    </div>


                    <div class="info-row">

                        <span>
                            <i class="bi bi-grid"></i>
                            Capacity
                        </span>

                        <strong>
                            @Model.Capacity
                        </strong>

                    </div>


                    <div class="info-row">

                        <span>
                            <i class="bi bi-calendar-month"></i>
                            Monthly Rent
                        </span>

                        <strong class="rent-value">

                            ₹@Model.MonthlyRent.ToString("N2")

                        </strong>

                    </div>


                    <div class="info-row">

                        <span>
                            <i class="bi bi-calendar-day"></i>
                            Daily Rent
                        </span>

                        <strong class="rent-value">

                            ₹@Model.DailyRent.ToString("N2")

                        </strong>

                    </div>


                    <div class="info-row">

                        <span>
                            <i class="bi bi-activity"></i>
                            Status
                        </span>

                        @if (availableBeds > 0)
                        {
                            <span class="badge bg-success">
                                Available
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-danger">
                                Full
                            </span>
                        }

                    </div>

                </div>

            </div>

        </div>


        <!-- ===================================================== -->
        <!-- BED STATUS -->
        <!-- ===================================================== -->

        <div class="col-lg-7">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-header bg-white border-0 p-4">

                    <div class="d-flex justify-content-between align-items-center">

                        <h5 class="fw-bold mb-0">

                            <i class="bi bi-grid-3x3-gap text-primary"></i>

                            Bed Status

                        </h5>


                        <span class="text-muted small">

                            @occupiedBeds / @totalBeds occupied

                        </span>

                    </div>

                </div>


                <div class="card-body px-4 pt-0">


                    <!-- Occupancy Progress -->

                    <div class="mb-4">

                        <div class="d-flex justify-content-between mb-2">

                            <span class="small text-muted">
                                Occupancy
                            </span>

                            <strong class="small">
                                @occupancyPercentage%
                            </strong>

                        </div>


                        <div class="progress"
                             style="height: 9px;">

                            <div class="progress-bar"
                                 role="progressbar"
                                 style="width: @occupancyPercentage%;"
                                 aria-valuenow="@occupancyPercentage"
                                 aria-valuemin="0"
                                 aria-valuemax="100">
                            </div>

                        </div>

                    </div>


                    @if (beds.Any())
                    {
                        <div class="beds-grid">

                            @foreach (var bed in beds)
                            {
                                var occupied =
                                    bed.Status == "Occupied";

                                <div class="bed-box
                                    @(occupied
                                        ? "occupied"
                                        : "available")">

                                    <div class="bed-box-icon">

                                        <i class="bi bi-bed-fill"></i>

                                    </div>


                                    <div class="bed-box-content">

                                        <strong>
                                            @bed.BedNumber
                                        </strong>

                                        @if (occupied)
                                        {
                                            <span class="bed-label occupied-label">

                                                <i class="bi bi-person-fill"></i>

                                                Occupied

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="bed-label available-label">

                                                <i class="bi bi-check-circle-fill"></i>

                                                Available

                                            </span>
                                        }

                                    </div>

                                </div>
                            }

                        </div>
                    }
                    else
                    {
                        <div class="empty-state">

                            <i class="bi bi-bed"></i>

                            <h6>
                                No beds found
                            </h6>

                            <p>
                                This room currently has no beds.
                            </p>

                        </div>
                    }

                </div>

            </div>

        </div>

    </div>


    <!-- ========================================================= -->
    <!-- QUICK ACTIONS -->
    <!-- ========================================================= -->

    <div class="card border-0 shadow-sm mt-4">

        <div class="card-body p-4">

            <h5 class="fw-bold mb-3">

                <i class="bi bi-lightning-charge text-warning"></i>

                Quick Actions

            </h5>


            <div class="d-flex flex-wrap gap-2">


                <a asp-controller="Room"
                   asp-action="Edit"
                   asp-route-id="@Model.RoomId"
                   class="btn btn-primary">

                    <i class="bi bi-pencil-square"></i>

                    Edit Room

                </a>


                <a asp-controller="Bed"
                   asp-action="Index"
                   asp-route-roomId="@Model.RoomId"
                   class="btn btn-outline-primary">

                    <i class="bi bi-grid-3x3-gap"></i>

                    Manage Beds

                </a>


                <a asp-controller="OwnerBooking"
                   asp-action="Index"
                   class="btn btn-outline-dark">

                    <i class="bi bi-calendar-check"></i>

                    View Bookings

                </a>


                <a asp-controller="Room"
                   asp-action="Index"
                   asp-route-pgId="@Model.PGId"
                   class="btn btn-light">

                    <i class="bi bi-list"></i>

                    All Rooms

                </a>

            </div>

        </div>

    </div>

</div>


<style>

    .room-hero {
        border-radius: 18px;
        overflow: hidden;
        background: linear-gradient( 135deg, #f5f9ff, #ffffff );
    }


    .room-icon {
        width: 65px;
        height: 65px;
        border-radius: 17px;
        background: #e7f1ff;
        color: #0d6efd;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 29px;
        flex-shrink: 0;
    }


    .status-badge {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 9px 15px;
        border-radius: 30px;
        font-size: 13px;
        font-weight: 600;
    }


        .status-badge.available {
            background: #e8f7ee;
            color: #198754;
        }


        .status-badge.full {
            background: #fff0f0;
            color: #dc3545;
        }


    /* Statistics */

    .stat-card {
        display: flex;
        align-items: center;
        gap: 15px;
        padding: 20px;
        background: white;
        border-radius: 16px;
        box-shadow: 0 3px 15px rgba(0,0,0,.06);
        height: 100%;
    }


        .stat-card small {
            display: block;
            color: #6c757d;
            margin-bottom: 3px;
        }


        .stat-card h3 {
            margin: 0;
            font-weight: 700;
        }


    .stat-icon {
        width: 50px;
        height: 50px;
        border-radius: 13px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 22px;
    }


        .stat-icon.total {
            background: #e7f1ff;
            color: #0d6efd;
        }


        .stat-icon.available {
            background: #e8f7ee;
            color: #198754;
        }


        .stat-icon.occupied {
            background: #fff0f0;
            color: #dc3545;
        }


    /* Information */

    .info-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 13px 0;
        border-bottom: 1px solid #f0f0f0;
        gap: 15px;
    }


        .info-row:last-child {
            border-bottom: 0;
        }


        .info-row span:first-child {
            color: #6c757d;
            display: flex;
            align-items: center;
            gap: 8px;
        }


            .info-row span:first-child i {
                color: #0d6efd;
            }


    .rent-value {
        color: #198754;
    }


    /* Beds */

    .beds-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 12px;
    }


    .bed-box {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 14px;
        border-radius: 13px;
        border: 1px solid;
        transition: .2s;
    }


        .bed-box:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(0,0,0,.06);
        }


        .bed-box.available {
            background: #f7fcf9;
            border-color: #d9f0e2;
        }


        .bed-box.occupied {
            background: #fff8f8;
            border-color: #ffd7d7;
        }


    .bed-box-icon {
        width: 42px;
        height: 42px;
        border-radius: 11px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #f1f3f5;
        color: #495057;
    }


    .bed-box-content {
        flex: 1;
    }


        .bed-box-content strong {
            display: block;
            margin-bottom: 3px;
        }


    .bed-label {
        font-size: 11px;
        font-weight: 600;
    }


    .available-label {
        color: #198754;
    }


    .occupied-label {
        color: #dc3545;
    }


    /* Progress */

    .progress {
        background: #edf0f2;
        border-radius: 20px;
        overflow: hidden;
    }


    .progress-bar {
        border-radius: 20px;
    }


    /* Empty */

    .empty-state {
        text-align: center;
        padding: 35px 15px;
        color: #6c757d;
    }


        .empty-state i {
            font-size: 40px;
            display: block;
            margin-bottom: 10px;
            color: #adb5bd;
        }


        .empty-state h6 {
            color: #495057;
            margin-bottom: 5px;
        }


        .empty-state p {
            margin: 0;
            font-size: 14px;
        }


    @@media (max-width: 768px) {

        .beds-grid {
            grid-template-columns: 1fr;
        }
    }


    @@media (max-width: 576px) {

        .container {
            padding-left: 15px;
            padding-right: 15px;
        }

        .room-icon {
            width: 52px;
            height: 52px;
            font-size: 23px;
        }

        .room-hero .card-body {
            padding: 20px !important;
        }

        .info-row {
            align-items: flex-start;
            flex-direction: column;
            gap: 4px;
        }
    }

</style>
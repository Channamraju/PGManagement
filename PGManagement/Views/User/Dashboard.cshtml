    }


    .quick-card:nth-child(3) .quick-icon {
        background: #f0eaff;
        color: #7651d9;
    }


    .quick-card:nth-child(4) .quick-icon {
        background: #fff4d8;
        color: #b77c00;
    }


    .quick-content {
        min-width: 0;
    }


        .quick-content h5 {
            margin: 0 0 4px;
            color: #172033;
            font-size: 13px;
            font-weight: 800;
        }


        .quick-content p {
            margin: 0;
            color: #8c96a6;
            font-size: 10px;
            line-height: 1.45;
        }


    .quick-arrow {
        margin-left: auto;
        color: #adb5c2;
        font-size: 15px;
    }


    /* =========================================================
           FOOTER
        ========================================================= */

    .dashboard-footer {
        margin-top: 35px;
        padding-top: 18px;
        border-top: 1px solid #e4e8ef;
        text-align: center;
        color: #9ba4b2;
        font-size: 10px;
    }


    /* =========================================================
           TABLET
        ========================================================= */

    @@media (max-width: 1200px) {

        .nav-link-custom {
            padding: 9px 8px;
        }

            .nav-link-custom span {
                display: none;
            }

        .stats-grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .quick-grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .stay-details {
            grid-template-columns: repeat(2, 1fr);
        }

        .stay-detail:nth-child(2) {
            border-right: 0;
        }

        .stay-detail:nth-child(-n+2) {
            border-bottom: 1px solid #edf0f5;
        }
    }


    /* =========================================================
           MOBILE
        ========================================================= */

    @@media (max-width: 768px) {

        .top-navbar {
            position: relative;
        }

        .nav-container {
            padding: 12px 16px;
            flex-wrap: wrap;
            min-height: auto;
        }

        .main-nav {
            order: 3;
            width: 100%;
            overflow-x: auto;
            justify-content: flex-start;
            padding-bottom: 3px;
        }

        .nav-link-custom {
            flex-shrink: 0;
            padding: 8px 12px;
        }

            .nav-link-custom span {
                display: inline;
            }

        .profile-info {
            display: none;
        }

        .dashboard-container {
            padding: 24px 16px 40px;
        }

        .page-title {
            font-size: 24px;
        }

        .welcome-banner {
            min-height: 245px;
            padding: 27px 23px;
            flex-direction: column;
            align-items: flex-start;
            justify-content: flex-start;
        }

        .welcome-title {
            font-size: 25px;
        }

        .find-pg-button {
            margin-top: 15px;
        }

        .stats-grid {
            grid-template-columns: repeat(2, 1fr);
            gap: 12px;
        }

        .stat-card {
            padding: 16px;
        }

        .stat-value {
            font-size: 22px;
        }

        .quick-grid {
            grid-template-columns: 1fr;
        }

        .stay-header {
            padding: 19px;
        }

        .stay-details {
            grid-template-columns: 1fr;
        }

        .stay-detail {
            border-right: 0 !important;
            border-bottom: 1px solid #edf0f5;
        }

            .stay-detail:last-child {
                border-bottom: 0;
            }
        /* MOBILE LOGOUT */

        .logout-button span {
            display: none;
        }

        .logout-button {
            width: 38px;
            height: 38px;
            padding: 0;
            justify-content: center;
        }
    }


    /* =========================================================
           SMALL MOBILE
        ========================================================= */

    @@media (max-width: 480px) {

        .brand-subtitle {
            display: none;
        }

        .nav-icon-btn {
            width: 35px;
            height: 35px;
        }

        .profile-avatar {
            width: 35px;
            height: 35px;
        }

        .logout-button {
            width: 35px;
            height: 35px;
        }

        .welcome-banner {
            border-radius: 17px;
        }

        .welcome-title {
            font-size: 22px;
        }

        .welcome-text {
            font-size: 11px;
        }

        .welcome-features {
            flex-direction: column;
            align-items: flex-start;
            gap: 6px;
        }

        .stay-header {
            align-items: flex-start;
            gap: 10px;
        }

        .stay-name {
            font-size: 16px;
        }

        .stay-type {
            padding: 6px 9px;
            font-size: 8px;
        }

        .payment-alert {
            flex-direction: column;
            align-items: stretch;
        }

        .pay-now-button {
            width: 100%;
            text-align: center;
        }
    }

</style>


<!-- =========================================================
     NAVBAR
========================================================= -->

<nav class="top-navbar">

    <div class="nav-container">


        <!-- BRAND -->

        <a asp-controller="User"
           asp-action="Dashboard"
           class="brand">

            <div class="brand-icon">

                <i class="bi bi-buildings-fill"></i>

            </div>

            <div>

                <span class="brand-title">
                    PG Manager
                </span>

                <span class="brand-subtitle">
                    User Portal
                </span>

            </div>

        </a>


        <!-- =================================================
             NAVIGATION
        ================================================= -->

        <div class="main-nav">


            <!-- DASHBOARD -->

            <a asp-controller="User"
               asp-action="Dashboard"
               class="nav-link-custom active">

                <i class="bi bi-grid-1x2-fill"></i>

                <span>
                    Dashboard
                </span>

            </a>


            <!-- FIND PG -->

            <a asp-controller="UserPG"
               asp-action="Index"
               class="nav-link-custom">

                <i class="bi bi-search"></i>

                <span>
                    Find PG
                </span>

            </a>


            <!-- BOOKINGS -->

            <a asp-controller="Booking"
               asp-action="MyBookings"
               class="nav-link-custom">

                <i class="bi bi-calendar-check"></i>

                <span>
                    My Bookings
                </span>

            </a>


            <!-- PAYMENTS -->

            <a asp-controller="Payment"
               asp-action="History"
               class="nav-link-custom">

                <i class="bi bi-credit-card"></i>

                <span>
                    Payments
                </span>

            </a>


            <!-- FOOD MENU -->

            <a asp-controller="FoodMenu"
               asp-action="Index"
               class="nav-link-custom">

                <i class="bi bi-egg-fried"></i>

                <span>
                    Food Menu
                </span>

            </a>


            <!-- PROFILE -->

            <a asp-controller="User"
               asp-action="Profile"
               class="nav-link-custom">

                <i class="bi bi-person"></i>

                <span>
                    Profile
                </span>

            </a>

        </div>


        <!-- =================================================
             RIGHT NAV
        ================================================= -->

        <div class="nav-right">


            <!-- SEARCH -->

            <a asp-controller="UserPG"
               asp-action="Index"
               class="nav-icon-btn"
               title="Find PG">

                <i class="bi bi-search"></i>

            </a>


            <!-- NOTIFICATIONS -->

            <button type="button"
                    class="nav-icon-btn"
                    title="Notifications">

                <i class="bi bi-bell"></i>

            </button>


            <!-- PROFILE -->

            <a asp-controller="User"
               asp-action="Profile"

<!-- =========================================================
     MAIN DASHBOARD
========================================================= -->

<main class="dashboard-container">


    <!-- PAGE HEADER -->

    <div class="page-header">

        <div class="page-label">
            USER PORTAL
        </div>

        <h1 class="page-title">
            Dashboard
        </h1>

        <div class="page-description">
            Manage your stay, bookings, payments and food menu.
        </div>

    </div>



    <!-- =====================================================
         WELCOME
    ===================================================== -->

    <section class="welcome-banner">


        <div class="welcome-content">

            <div class="welcome-small">
                GOOD DAY 👋
            </div>


            <h2 class="welcome-title">
                Welcome back, @firstName!
            </h2>


            <p class="welcome-text">

                Everything you need to manage your PG stay,
                bookings, payments and daily food menu is right here.

            </p>


            <div class="welcome-features">

                <div class="welcome-feature">

                    <i class="bi bi-shield-check"></i>

                    Secure account

                </div>


                <div class="welcome-feature">

                    <i class="bi bi-check-circle"></i>

                    Easy management

                </div>


                <div class="welcome-feature">

                    <i class="bi bi-egg-fried"></i>

                    Food menu

                </div>

            </div>

        </div>


        <a asp-controller="UserPG"
           asp-action="Index"
           class="find-pg-button">

            <i class="bi bi-search"></i>

            Find a PG

            <i class="bi bi-arrow-right"></i>

        </a>


        <div class="welcome-circle-one"></div>

        <div class="welcome-circle-two"></div>

    </section>



    <!-- =====================================================
         STATISTICS
    ===================================================== -->

    <section class="stats-grid">


        <!-- TOTAL -->

        <a asp-controller="Booking"
           asp-action="MyBookings"
           class="stat-card">

            <div class="stat-top">

                <span class="stat-label">
                    Total Bookings
                </span>

                <div class="stat-icon icon-blue">

                    <i class="bi bi-calendar-check"></i>

                </div>

            </div>


            <div class="stat-value">
                @totalBookings
            </div>


            <div class="stat-bottom">

                <span>
                    All bookings
                </span>

                <i class="bi bi-arrow-up-right"></i>

            </div>

        </a>



        <!-- CONFIRMED -->

        <a asp-controller="Booking"
           asp-action="MyBookings"
           class="stat-card">

            <div class="stat-top">

                <span class="stat-label">
                    Confirmed
                </span>

                <div class="stat-icon icon-green">

                    <i class="bi bi-check-circle-fill"></i>

                </div>

            </div>


            <div class="stat-value">
                @confirmedBookings
            </div>


            <div class="stat-bottom">

                <span>
                    Active bookings
                </span>

                <i class="bi bi-arrow-up-right"></i>

            </div>

        </a>



        <!-- PENDING -->

        <a asp-controller="Booking"
           asp-action="MyBookings"
           class="stat-card">

            <div class="stat-top">

                <span class="stat-label">
                    Pending
                </span>

                <div class="stat-icon icon-yellow">

                    <i class="bi bi-hourglass-split"></i>

                </div>

            </div>


            <div class="stat-value">
                @pendingBookings
            </div>


            <div class="stat-bottom">

                <span>
                    Awaiting approval
                </span>

                <i class="bi bi-arrow-up-right"></i>

            </div>

        </a>



        <!-- TOTAL PAID -->

        <a asp-controller="Payment"
           asp-action="History"
           class="stat-card">

            <div class="stat-top">

                <span class="stat-label">
                    Total Paid
                </span>

                <div class="stat-icon icon-purple">

                    <i class="bi bi-wallet2"></i>

                </div>

            </div>


            <div class="stat-value">

                ₹@totalPaid.ToString("N0")

            </div>


            <div class="stat-bottom">

                <span>
                    Successful payments
                </span>

                <i class="bi bi-arrow-up-right"></i>

            </div>

        </a>

    </section>



    <!-- =====================================================
         CURRENT STAY
    ===================================================== -->

    <section class="section-card">

        @if (hasCurrentStay)
        {

            <!-- HEADER -->

            <div class="stay-header">

                <div class="stay-title-area">

                    <div class="stay-icon">

                        <i class="bi bi-house-heart-fill"></i>

                    </div>


                    <div>

                        <div class="stay-label">
                            CURRENT STAY
                        </div>


                        <h3 class="stay-name">
                            @pgName
                        </h3>


                        <div class="stay-location">

                            <span>

                                <i class="bi bi-door-open"></i>

                                Room @roomNumber

                            </span>


                            <span>

                                <i class="bi bi-grid-3x3-gap"></i>

                                Bed @bedNumber

                            </span>

                        </div>

                    </div>

                </div>


                <div class="stay-type">

                    @if (isMonthly)
                    {
                        <i class="bi bi-calendar-month"></i>

                        <span>
                            Monthly
                        </span>
                    }
                    else
                    {
                        <i class="bi bi-calendar-event"></i>

                        <span>
                            Daily
                        </span>
                    }

                </div>

            </div>



            <!-- DETAILS -->

            <div class="stay-details">


                <!-- START DATE -->

                <div class="stay-detail">

                    <div class="detail-icon">

                        <i class="bi bi-calendar-plus"></i>

                    </div>


                    <div>

                        <span class="detail-label">
                            Start Date
                        </span>


                        <span class="detail-value">

                            @if (startDate.HasValue)
                            {
                                @startDate.Value.ToString("dd MMM yyyy")
                            }
                            else
                            {
                                <text>-</text>
                            }

                        </span>

                    </div>

                </div>



                <!-- END DATE -->

                <div class="stay-detail">

                    <div class="detail-icon yellow">

                        <i class="bi bi-calendar-x"></i>

                    </div>


                    <div>

                        <span class="detail-label">

                            @if (isMonthly)
                            {
                                <text>Stay Type</text>
                            }
                            else
                            {
                                <text>End Date</text>
                            }

                        </span>


                        <span class="detail-value">

                            @if (isMonthly)
                            {
                                <text>Monthly</text>
                            }
                            else if (endDate.HasValue)
                            {
                                @endDate.Value.ToString("dd MMM yyyy")
                            }
                            else
                            {
                                <text>-</text>
                            }

                        </span>

                    </div>

                </div>



                <!-- RENT -->

                <div class="stay-detail">

                    <div class="detail-icon green">

                        <i class="bi bi-currency-rupee"></i>

                    </div>


                    <div>

                        <span class="detail-label">

                            @if (isMonthly)
                            {
                                <text>Monthly Rent</text>
                            }
                            else
                            {
                                <text>Daily Rent</text>
                            }

                        </span>


                        <span class="detail-value">

                            ₹@rentAmount.ToString("N0")

                        </span>

                    </div>

                </div>



                <!-- PAYMENT -->

                <div class="stay-detail">

                    <div class="detail-icon purple">

                        <i class="bi bi-credit-card"></i>

                    </div>


                    <div>

                        <span class="detail-label">

                            @if (canPayNow)
                            {
                                <text>Next Payment</text>
                            }
                            else
                            {
                                <text>Payment Status</text>
                            }

                        </span>


                        <span class="detail-value @(canPayNow ? "" : "success")">

                            @if (canPayNow)
                            {
                                <text>
                                    ₹@nextPaymentAmount.ToString("N0")
                                </text>
                            }
                            else
                            {
                                <text>
                                    Paid
                                </text>
                            }

                        </span>

                    </div>

                </div>

            </div>



            <!-- PAYMENT FOOTER -->

            <div class="payment-footer">

                @if (canPayNow)
                {

                    <div class="payment-status"
                         style="color:#ad7900;">

                        <i class="bi bi-exclamation-circle-fill"></i>

                        Payment is due

                    </div>


                    <a asp-controller="Payment"
                       asp-action="Create"
                       asp-route-bookingId="@confirmedBookingId"
                       class="payment-link">

                        Pay ₹@nextPaymentAmount.ToString("N0")

                        →

                    </a>

                }
                else
                {

                    <div class="payment-status">

                        <i class="bi bi-check-circle-fill"></i>

                        Payment is up to date

                    </div>


                    <a asp-controller="Payment"
                       asp-action="History"
                       class="payment-link">

                        View Payment History →

                    </a>

                }

            </div>

        }
        else
        {

            <!-- NO CURRENT STAY -->

            <div class="empty-stay">

                <div class="empty-icon">

                    <i class="bi bi-house-door"></i>

                </div>


                <h4>
                    No Current Stay
                </h4>


                <p>

                    You don't have an active booking right now.
                    Find a PG and book your next stay.

                </p>


                <a asp-controller="UserPG"
                   asp-action="Index"
                   class="empty-button">

                    <i class="bi bi-search"></i>

                    Find a PG

                </a>

            </div>

        }

    </section>



    <!-- =====================================================
         PAYMENT ALERT
    ===================================================== -->
    @if (hasCurrentStay && canPayNow)
    {

        <div class="payment-alert">


            <div class="payment-alert-left">


                <div class="payment-alert-icon">

                    <i class="bi bi-wallet2"></i>

                </div>


                <div>

                    <p class="payment-alert-title">
                        Payment due
                    </p>


                    <p class="payment-alert-text">

                        Your next payment is

                        <strong>
                            ₹@nextPaymentAmount.ToString("N0")
                        </strong>

                        @if (nextPaymentDate.HasValue)
                        {
                            <text>

                                and is due from
                                @nextPaymentDate.Value.ToString("dd MMM yyyy").

                            </text>
                        }

                    </p>

                </div>

            </div>


            <a asp-controller="Payment"
               asp-action="Create"
               asp-route-bookingId="@confirmedBookingId"
               class="pay-now-button">

                Pay Now

            </a>

        </div>

    }



    <!-- =====================================================
         QUICK ACTIONS
    ===================================================== -->

    <section class="quick-section">


        <div class="section-heading">

            <h3>
                Quick Actions
            </h3>

            <span>
                Manage your PG
            </span>

        </div>


        <div class="quick-grid">


            <!-- FIND PG -->

            <a asp-controller="UserPG"
               asp-action="Index"
               class="quick-card">

                <div class="quick-icon">

                    <i class="bi bi-search"></i>

                </div>


                <div class="quick-content">

                    <h5>
                        Find a PG
                    </h5>

                    <p>
                        Search and explore approved PG accommodations.
                    </p>

                </div>


                <i class="bi bi-arrow-up-right quick-arrow"></i>

            </a>



            <!-- BOOKINGS -->

            <a asp-controller="Booking"
               asp-action="MyBookings"
               class="quick-card">

                <div class="quick-icon">

                    <i class="bi bi-calendar-check"></i>

                </div>


                <div class="quick-content">

                    <h5>
                        My Bookings
                    </h5>

                    <p>
                        View bookings and track their approval status.
                    </p>

                </div>


                <i class="bi bi-arrow-up-right quick-arrow"></i>

            </a>



            <!-- PAYMENTS -->

            <a asp-controller="Payment"
               asp-action="History"
               class="quick-card">

                <div class="quick-icon">

                    <i class="bi bi-credit-card"></i>

                </div>


                <div class="quick-content">

                    <h5>
                        Payments
                    </h5>

                    <p>
                        View payment history and transaction receipts.
                    </p>

                </div>


                <i class="bi bi-arrow-up-right quick-arrow"></i>

            </a>



            <!-- FOOD MENU -->

            <a asp-controller="FoodMenu"
               asp-action="Index"
               class="quick-card">

                <div class="quick-icon">

                    <i class="bi bi-egg-fried"></i>

                </div>


                <div class="quick-content">

                    <h5>
                        Food Menu
                    </h5>

                    <p>
                        Check breakfast, lunch, dinner and snacks.
                    </p>

                </div>


                <i class="bi bi-arrow-up-right quick-arrow"></i>

            </a>

        </div>

    </section>



    <!-- =====================================================
         FOOTER
    ===================================================== -->

    <div class="dashboard-footer">

        © @DateTime.Now.Year PG Manager ·
        Your stay, simplified.

    </div>

</main>
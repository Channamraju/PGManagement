        display: flex;
        align-items: center;
        justify-content: space-between;
    }


        .section-heading h3 {
            margin: 0;
            font-size: 17px;
            font-weight: 800;
        }


        .section-heading span {
            color: #929bab;
            font-size: 10px;
        }


    .quick-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 15px;
    }


    .quick-card {
        min-height: 120px;
        padding: 19px;
        background: white;
        border: 1px solid #e4e9f1;
        border-radius: 16px;
        display: flex;
        align-items: center;

@model PGManagement.Models.User

@{
    ViewData["Title"] = "Dashboard";

    // ==============================
    // USER INFORMATION
    // ==============================

    var userName = Model?.FullName;

    if (string.IsNullOrWhiteSpace(userName))
    {
        userName = ViewBag.UserName as string;
    }

    if (string.IsNullOrWhiteSpace(userName))
    {
        userName = "User";
    }

    var userImage = Model?.ProfileImagePath;

    if (string.IsNullOrWhiteSpace(userImage))
    {
        userImage = ViewBag.UserImage as string;
    }

    // ==============================
    // FIRST NAME
    // ==============================

    var firstName = userName;

    var firstNameParts = userName.Split(
        ' ',
        StringSplitOptions.RemoveEmptyEntries);

    if (firstNameParts.Length > 0)
    {
        firstName = firstNameParts[0];
    }

    // ==============================
    // INITIALS
    // ==============================

    var initials = "U";

    var nameParts = userName.Split(
        ' ',
        StringSplitOptions.RemoveEmptyEntries);

    if (nameParts.Length >= 2)
    {
        var firstInitial =
            nameParts[0].Substring(0, 1);

        var lastIndex =
            nameParts.Length - 1;

        var lastInitial =
            nameParts[lastIndex].Substring(0, 1);

        initials =
            (firstInitial + lastInitial).ToUpper();
    }
    else if (nameParts.Length == 1)
    {
        initials =
            nameParts[0].Substring(0, 1).ToUpper();
    }

    // ==============================
    // STATISTICS
    // ==============================

    int totalBookings =
        ViewBag.TotalBookings ?? 0;

    int confirmedBookings =
        ViewBag.ConfirmedBookings ?? 0;

    int pendingBookings =
        ViewBag.PendingBookings ?? 0;

    int completedBookings =
        ViewBag.CompletedBookings ?? 0;

    decimal totalPaid =
        ViewBag.TotalPaid ?? 0m;

    // ==============================
    // CURRENT STAY
    // ==============================

    int confirmedBookingId =
        ViewBag.ConfirmedBookingId ?? 0;

    string pgName =
        ViewBag.PGName ?? "-";

    string roomNumber =
        ViewBag.RoomNumber ?? "-";

    string bedNumber =
        ViewBag.BedNumber ?? "-";

    string stayType =
        ViewBag.StayType ?? "";

    DateTime? startDate =
        ViewBag.StartDate as DateTime?;

    DateTime? endDate =
        ViewBag.EndDate as DateTime?;

    decimal rentAmount =
        ViewBag.RentAmount ?? 0m;

    decimal nextPaymentAmount =
        ViewBag.NextPaymentAmount ?? 0m;

    DateTime? nextPaymentDate =
        ViewBag.NextPaymentDate as DateTime?;

    bool canPayNow =
        ViewBag.CanPayNow ?? false;

    bool hasCurrentStay =
        confirmedBookingId > 0;

    bool isMonthly =
        stayType == "Monthly";

    bool isDaily =
        stayType == "Daily";
}



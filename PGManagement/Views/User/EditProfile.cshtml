@model PGManagement.Models.User

@{
    ViewData["Title"] = "Edit Profile";
}

<style>

    .edit-profile-wrapper {
        max-width: 900px;
        margin: 40px auto;
    }

    .edit-card {
        background: white;
        border-radius: 18px;
        box-shadow: 0 8px 30px rgba(0,0,0,.08);
        overflow: hidden;
    }

    .edit-header {
        background: linear-gradient(135deg, #0d6efd, #4f46e5);
        color: white;
        padding: 30px;
    }

        .edit-header h2 {
            margin-bottom: 5px;
            font-weight: 700;
        }

    .edit-body {
        padding: 35px;
    }

    .form-section {
        margin-bottom: 30px;
    }

    .section-title {
        font-size: 19px;
        font-weight: 700;
        margin-bottom: 20px;
    }

    .current-profile-image {
        width: 110px;
        height: 110px;
        border-radius: 50%;
        object-fit: cover;
        border: 5px solid #fff;
        box-shadow: 0 4px 15px rgba(0,0,0,.15);
    }

    .aadhaar-preview {
        width: 300px;
        max-width: 100%;
        height: 180px;
        object-fit: cover;
        border-radius: 10px;
        border: 1px solid #ddd;
    }

    .sensitive-note {
        background: #fff8e1;
        border: 1px solid #ffe082;
        border-radius: 10px;
        padding: 12px 15px;
        font-size: 13px;
    }

</style>


<div class="container">

    <div class="edit-profile-wrapper">

        <div class="edit-card">

            <!-- HEADER -->

            <div class="edit-header">

                <h2>
                    <i class="bi bi-person-gear"></i>
                    Edit Profile
                </h2>

                <p class="mb-0 opacity-75">
                    Update your personal information.
                </p>

            </div>


            <!-- BODY -->

            <div class="edit-body">

                <form asp-action="EditProfile"
                      method="post"
                      enctype="multipart/form-data">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           asp-for="UserId" />


                    <div asp-validation-summary="ModelOnly"
                         class="alert alert-danger">
                    </div>


                    <!-- ================================= -->
                    <!-- PROFILE PHOTO -->
                    <!-- ================================= -->

                    <div class="form-section">

                        <div class="section-title">

                            <i class="bi bi-person-circle text-primary"></i>
                            Profile Photo

                        </div>


                        <div class="d-flex align-items-center gap-4 flex-wrap">

                            @if (!string.IsNullOrEmpty(Model.ProfileImagePath))
                            {
                                <img src="@Model.ProfileImagePath"
                                     class="current-profile-image"
                                     alt="Profile Photo" />
                            }
                            else
                            {
                                <div class="current-profile-image bg-primary
                                    text-white d-flex align-items-center
                                    justify-content-center"
                                     style="font-size:35px;font-weight:700;">

                                    @Model.FullName.Substring(0, 1).ToUpper()

                                </div>
                            }

                            <div class="flex-grow-1">

                                <label class="form-label fw-bold">
                                    Change Profile Photo
                                </label>

                                <input type="file"
                                       name="profileImage"
                                       class="form-control"
                                       accept=".jpg,.jpeg,.png,.webp" />

                                <small class="text-muted">
                                    JPG, JPEG, PNG or WEBP. Maximum 5 MB.
                                </small>

                            </div>

                        </div>

                    </div>


                    <hr />


                    <!-- ================================= -->
                    <!-- PERSONAL DETAILS -->
                    <!-- ================================= -->

                    <div class="form-section mt-4">

                        <div class="section-title">

                            <i class="bi bi-person-vcard text-primary"></i>
                            Personal Information

                        </div>


                        <!-- NAME -->

                        <div class="mb-3">

                            <label asp-for="FullName"
                                   class="form-label fw-bold">
                                Full Name
                            </label>

                            <input asp-for="FullName"
                                   class="form-control"
                                   placeholder="Enter your full name" />

                            <span asp-validation-for="FullName"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- EMAIL -->

                        <div class="mb-3">

                            <label asp-for="Email"
                                   class="form-label fw-bold">
                                Email Address
                            </label>

                            <input asp-for="Email"
                                   class="form-control"
                                   type="email"
                                   placeholder="Enter email address" />

                            <span asp-validation-for="Email"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- PHONE -->

                        <div class="mb-3">

                            <label asp-for="Phone"
                                   class="form-label fw-bold">
                                Phone Number
                            </label>

                            <input asp-for="Phone"
                                   class="form-control"
                                   placeholder="Enter phone number" />

                        </div>


                        <!-- ADDRESS -->

                        <div class="mb-3">

                            <label asp-for="Address"
                                   class="form-label fw-bold">
                                Address
                            </label>

                            <textarea asp-for="Address"
                                      class="form-control"
                                      rows="3"
                                      placeholder="Enter your address">
                            </textarea>

                        </div>

                    </div>


                    <hr />


                    <!-- ================================= -->
                    <!-- AADHAAR -->
                    <!-- ================================= -->

                    <div class="form-section mt-4">

                        <div class="section-title">

                            <i class="bi bi-card-text text-primary"></i>
                            Aadhaar Details

                        </div>


                        <div class="sensitive-note mb-4">

                            <i class="bi bi-shield-lock"></i>

                            Aadhaar information is sensitive.
                            Keep it private and only upload it when required
                            by your PG management process.

                        </div>


                        <!-- AADHAAR NUMBER -->

                        <div class="mb-3">

                            <label asp-for="AadhaarNumber"
                                   class="form-label fw-bold">

                                Aadhaar Number

                            </label>

                            <input asp-for="AadhaarNumber"
                                   class="form-control"
                                   maxlength="12"
                                   placeholder="Enter 12-digit Aadhaar number" />

                            <small class="text-muted">
                                Enter your 12-digit Aadhaar number.
                            </small>

                            <span asp-validation-for="AadhaarNumber"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- CURRENT AADHAAR IMAGE -->
                        @if (!string.IsNullOrEmpty(Model.AadhaarImagePath))
                        {
                            <div class="mb-3">

                                <label class="form-label fw-bold">
                                    Current Aadhaar Image
                                </label>

                                <br />

                                <img src="@Model.AadhaarImagePath"
                                     class="aadhaar-preview"
                                     alt="Aadhaar" />

                            </div>
                        }


                        <!-- NEW AADHAAR IMAGE -->

                        <div class="mb-3">

                            <label class="form-label fw-bold">

                                @(string.IsNullOrEmpty(Model.AadhaarImagePath)
                                    ? "Upload Aadhaar Image"
                                    : "Change Aadhaar Image")

                            </label>

                            <input type="file"
                                   name="aadhaarImage"
                                   class="form-control"
                                   accept=".jpg,.jpeg,.png,.webp" />

                            <small class="text-muted">
                                JPG, JPEG, PNG or WEBP. Maximum 5 MB.
                            </small>

                        </div>

                    </div>


                    <!-- ================================= -->
                    <!-- BUTTONS -->
                    <!-- ================================= -->

                    <div class="d-flex gap-2 justify-content-end mt-4">

                        <a asp-action="Profile"
                           class="btn btn-outline-secondary">

                            <i class="bi bi-x-circle"></i>
                            Cancel

                        </a>

                        <button type="submit"
                                class="btn btn-primary">

                            <i class="bi bi-check-circle"></i>
                            Save Changes

                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>

@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}
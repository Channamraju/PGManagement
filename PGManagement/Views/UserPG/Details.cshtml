@model PGManagement.Models.PG

@{
    ViewData["Title"] = "PG Details";
}

<link rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<div class="container py-4">

    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">
                @Model.PGName
            </h2>

            <div class="text-muted">
                <i class="bi bi-geo-alt-fill"></i>
                @Model.City
            </div>
        </div>

        <a href="/UserPG/Index"
           class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i>
            Back to PGs
        </a>

    </div>


    <!-- ERROR -->
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">

            <i class="bi bi-exclamation-triangle-fill"></i>

            @TempData["Error"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    <!-- SUCCESS -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">

            <i class="bi bi-check-circle-fill"></i>

            @TempData["Success"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    <!-- ===================================================== -->
    <!-- PG INFORMATION -->
    <!-- ===================================================== -->

    <div class="card border-0 shadow-sm mb-4">

        <div class="card-header bg-primary text-white">

            <h5 class="mb-0">
                <i class="bi bi-building"></i>
                PG Information
            </h5>

        </div>

        <div class="card-body">

            <div class="row g-4">

                <div class="col-md-6">

                    <small class="text-muted">
                        PG Name
                    </small>

                    <h6 class="fw-bold">
                        @Model.PGName
                    </h6>

                </div>


                <div class="col-md-6">

                    <small class="text-muted">
                        Address
                    </small>

                    <h6 class="fw-bold">
                        @Model.Address
                    </h6>

                </div>


                <div class="col-md-6">

                    <small class="text-muted">
                        City
                    </small>

                    <h6 class="fw-bold">
                        @Model.City
                    </h6>

                </div>


                <div class="col-md-6">

                    <small class="text-muted">
                        Gender Type
                    </small>

                    <h6 class="fw-bold">
                        @Model.GenderType
                    </h6>

                </div>


                <div class="col-md-12">

                    <small class="text-muted">
                        Description
                    </small>

                    <p class="mb-0">
                        @(string.IsNullOrWhiteSpace(Model.Description)
                            ? "No description available."
                            : Model.Description)
                    </p>

                </div>


                <div class="col-md-6">

                    <small class="text-muted">
                        Status
                    </small>

                    <div>
                        <span class="badge bg-success px-3 py-2">

                            <i class="bi bi-check-circle"></i>

                            @Model.Status

                        </span>
                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- ===================================================== -->
    <!-- OWNER INFORMATION -->
    <!-- ===================================================== -->
    @if (Model.Owner != null)
    {
        <div class="card border-0 shadow-sm mb-4">

            <div class="card-header bg-dark text-white">

                <h5 class="mb-0">

                    <i class="bi bi-person-circle"></i>

                    Owner Information

                </h5>

            </div>

            <div class="card-body">

                <div class="row g-4">

                    <div class="col-md-6">

                        <small class="text-muted">
                            Name
                        </small>

                        <div class="fw-bold">
                            @Model.Owner.FullName
                        </div>

                    </div>


                    <div class="col-md-6">

                        <small class="text-muted">
                            Email
                        </small>

                        <div class="fw-bold">
                            @Model.Owner.Email
                        </div>

                    </div>


                    <div class="col-md-6">

                        <small class="text-muted">
                            Phone
                        </small>

                        <div class="fw-bold">
                            @Model.Owner.Phone
                        </div>

                    </div>


                    <div class="col-md-6">

                        <small class="text-muted">
                            Address
                        </small>

                        <div class="fw-bold">
                            @Model.Owner.Address
                        </div>

                    </div>

                </div>

            </div>

        </div>
    }


    <!-- ===================================================== -->
    <!-- ROOMS -->
    <!-- ===================================================== -->

    <div class="card border-0 shadow-sm">

        <div class="card-header bg-primary text-white">

            <h5 class="mb-0">

                <i class="bi bi-door-open"></i>

                Available Rooms

            </h5>

        </div>


        <div class="card-body">

            @if (Model.Rooms != null && Model.Rooms.Any())
            {

                foreach (var room in Model.Rooms)
                {

                    var availableBeds =
                        room.Beds?
                            .Where(b => b.Status == "Available")
                            .ToList()
                        ?? new List<PGManagement.Models.Bed>();


                    <!-- ROOM -->
                    <div class="room-card mb-4">


                        <!-- ROOM HEADER -->

                        <div class="d-flex justify-content-between align-items-center mb-4">

                            <div>

                                <h5 class="fw-bold mb-1">

                                    <i class="bi bi-door-open text-primary"></i>

                                    Room @room.RoomNumber

                                </h5>

                                <span class="text-muted">

                                    @room.RoomType

                                    <span class="mx-2">•</span>

                                    @room.SharingType

                                </span>

                            </div>


                            @if (availableBeds.Any())
                            {
                                <span class="badge bg-success px-3 py-2">

                                    @availableBeds.Count Available

                                </span>
                            }
                            else
                            {
                                <span class="badge bg-danger px-3 py-2">

                                    Full

                                </span>
                            }

                        </div>


                        <!-- RENT -->

                        <div class="row g-3 mb-4">

                            <div class="col-md-6">

                                <div class="rent-card">

                                    <small class="text-muted">
                                        Monthly Rent
                                    </small>

                                    <div class="fs-4 fw-bold">
                                        ₹@room.MonthlyRent
                                    </div>

                                    <small class="text-muted">
                                        per month
                                    </small>

                                </div>

                            </div>


                            <div class="col-md-6">

                                <div class="rent-card">

                                    <small class="text-muted">
                                        Daily Rent
                                    </small>

                                    <div class="fs-4 fw-bold">
                                        ₹@room.DailyRent
                                    </div>

                                    <small class="text-muted">
                                        per day
                                    </small>

                                </div>

                            </div>

                        </div>


                        <!-- ================================================= -->
                        <!-- AVAILABLE BEDS -->
                        <!-- ================================================= -->
                        @if (availableBeds.Any())
                        {

                            <h6 class="fw-bold mb-3">

                                <i class="bi bi-bed-fill"></i>

                                Select Bed & Booking Details

                            </h6>


                            foreach (var bed in availableBeds)
                            {

                                <!-- ================================================= -->
                                <!-- IMPORTANT: POST FORM -->
                                <!-- ================================================= -->

                                <form action="/Booking/Create"
                                      method="post"
                                      class="booking-form mb-3">

                                    @Html.AntiForgeryToken()


                                    <!-- PG ID -->

                                    <input type="hidden"
                                           name="pgId"
                                           value="@Model.PGId" />


                                    <!-- ROOM ID -->

                                    <input type="hidden"
                                           name="roomId"
                                           value="@room.RoomId" />


                                    <!-- BED ID -->

                                    <input type="hidden"
                                           name="bedId"
                                           value="@bed.BedId" />


                                    <div class="row g-3 align-items-end">


                                        <!-- BED -->

                                        <div class="col-lg-3 col-md-6">

                                            <label class="form-label">
                                                Bed
                                            </label>

                                            <div class="bed-box">

                                                <i class="bi bi-bed-fill text-primary"></i>

                                                <strong>
                                                    Bed @bed.BedNumber
                                                </strong>

                                                <span class="badge bg-success ms-2">
                                                    Available
                                                </span>

                                            </div>

                                        </div>


                                        <!-- STAY TYPE -->

                                        <div class="col-lg-3 col-md-6">

                                            <label class="form-label fw-semibold">

                                                Stay Type

                                                <span class="text-danger">
                                                    *
                                                </span>

                                            </label>

                                            <select name="stayType"
                                                    class="form-select stay-type"
                                                    required>

                                                <option value="">
                                                    Select Stay Type
                                                </option>

                                                <option value="Monthly">
                                                    Monthly
                                                </option>

                                                <option value="Daily">
                                                    Daily
                                                </option>

                                            </select>

                                        </div>


                                        <!-- START DATE -->

                                        <div class="col-lg-2 col-md-6">

                                            <label class="form-label fw-semibold">

                                                Start Date

                                                <span class="text-danger">
                                                    *
                                                </span>

                                            </label>

                                            <input type="date"
                                                   name="startDate"
                                                   class="form-control start-date"
                                                   required />

                                        </div>


                                        <!-- END DATE -->

                                        <div class="col-lg-2 col-md-6 end-date-container"
                                             style="display:none;">

                                            <label class="form-label fw-semibold">

                                                End Date

                                                <span class="text-danger">
                                                    *
                                                </span>

                                            </label>

                                            <input type="date"
                                                   name="endDate"
                                                   class="form-control end-date" />

                                        </div>


                                        <!-- BOOK -->

                                        <div class="col-lg-2 col-md-12">

                                            <button type="submit"
                                                    class="btn btn-primary w-100">

                                                <i class="bi bi-calendar-check"></i>

                                                Book Now

                                            </button>

                                        </div>

                                    </div>

                                </form>

                            }

                        }
                        else
                        {

                            <div class="alert alert-warning mb-0">

                                <i class="bi bi-exclamation-triangle"></i>

                                No beds are available in this room.

                            </div>

                        }

                    </div>

                }

            }
            else
            {

                <div class="alert alert-info">

                    No rooms are currently available.

                </div>

            }

        </div>

    </div>

</div>


<!-- ========================================================= -->
<!-- CSS -->
<!-- ========================================================= -->

<style>

    body {
        background: #f4f7fb;
    }

    .room-card {
        border: 1px solid #e5e7eb;
        border-radius: 18px;
        padding: 24px;
        background: white;
    }

    .rent-card {
        background: #f8f9fa;
        border: 1px solid #e9ecef;
        border-radius: 12px;
        padding: 16px;
    }

    .booking-form {
        border: 1px solid #e5e7eb;
        border-radius: 14px;
        padding: 18px;
        background: white;
    }

    .bed-box {
        background: #f8f9fa;
        border: 1px solid #e5e7eb;
        border-radius: 10px;
        padding: 11px;
        min-height: 44px;
    }

    .form-control,
    .form-select {
        min-height: 44px;
        border-radius: 9px;
    }

    @@media (max-width: 768px) {

        .room-card {
            padding: 16px;
        }
    }

</style>


<!-- ========================================================= -->
<!-- JAVASCRIPT -->
<!-- ========================================================= -->

<script>

    document.addEventListener("DOMContentLoaded", function() {

        var today =
            new Date().toISOString().split("T")[0];


        document.querySelectorAll(".booking-form")
            .forEach(function(form) {

                var stayType =
                    form.querySelector(".stay-type");

                var startDate =
                    form.querySelector(".start-date");

                var endDateContainer =
                    form.querySelector(".end-date-container");

                var endDate =
                    form.querySelector(".end-date");


                // Set today's date
                startDate.min = today;
                startDate.value = today;


                // Stay type changed
                stayType.addEventListener("change", function() {

                    if (this.value === "Daily") {

                        endDateContainer.style.display = "block";

                        endDate.required = true;

                        endDate.min =
                            startDate.value;

                    }
                    else {

                        endDateContainer.style.display = "none";

                        endDate.required = false;

                        endDate.value = "";

                    }

                });


                // Start date changed
                startDate.addEventListener("change", function() {

                    if (stayType.value === "Daily") {

                        endDate.min =
                            startDate.value;

                    }

                });


                // Submit validation
                form.addEventListener("submit", function(event) {

                    if (stayType.value !== "Monthly" &&
                        stayType.value !== "Daily") {

                        event.preventDefault();

                        alert(
                            "Please select Monthly or Daily stay."
                        );

                        stayType.focus();

                        return;
                    }


                    if (!startDate.value) {

                        event.preventDefault();

                        alert(
                            "Please select a start date."
                        );

                        return;
                    }


                    if (stayType.value === "Daily") {

                        if (!endDate.value) {

                            event.preventDefault();

                            alert(
                                "Please select an end date for Daily stay."
                            );

                            endDate.focus();

                            return;
                        }


                        if (endDate.value < startDate.value) {

                            event.preventDefault();

                            alert(
                                "End date cannot be before start date."
                            );

                            endDate.focus();

                            return;
                        }

                    }

                });

            });

    });

</script>
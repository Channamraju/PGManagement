@model IEnumerable<PGManagement.Models.PG>

@{
    ViewData["Title"] = "Find PG";
}

<div class="container mt-4">

    <!-- ============================== -->
    <!-- HEADER -->
    <!-- ============================== -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h2 class="fw-bold mb-1">
                <i class="bi bi-search"></i>
                Find PG
            </h2>

            <p class="text-muted mb-0">
                Find approved PG accommodations
            </p>

        </div>

        <a asp-controller="User"
           asp-action="Dashboard"
           class="btn btn-outline-secondary">

            <i class="bi bi-speedometer2"></i>
            Dashboard

        </a>

    </div>


    <!-- ============================== -->
    <!-- SEARCH -->
    <!-- ============================== -->

    <div class="card shadow-sm border-0 mb-4">

        <div class="card-body">

            <form asp-action="Index"
                  method="get">

                <div class="row g-2">

                    <div class="col-md-10">

                        <input type="text"
                               name="city"
                               value="@Context.Request.Query["city"]"
                               class="form-control form-control-lg"
                               placeholder="Search PG by city..." />

                    </div>

                    <div class="col-md-2">

                        <button type="submit"
                                class="btn btn-primary btn-lg w-100">

                            <i class="bi bi-search"></i>
                            Search

                        </button>

                    </div>

                </div>

            </form>

        </div>

    </div>


    <!-- ============================== -->
    <!-- PG LIST -->
    <!-- ============================== -->
    @if (Model == null || !Model.Any())
    {
        <div class="card shadow-sm border-0">

            <div class="card-body text-center p-5">

                <i class="bi bi-building text-muted"
                   style="font-size:70px;">
                </i>

                <h4 class="mt-3">
                    No PGs Found
                </h4>

                <p class="text-muted">
                    No approved PGs are available for your search.
                </p>

            </div>

        </div>
    }
    else
    {
        <div class="row g-4">

            @foreach (var pg in Model)
            {
                <div class="col-md-6 col-lg-4">

                    <div class="card shadow-sm border-0 h-100 overflow-hidden">

                        <!-- ========================== -->
                        <!-- PG IMAGE -->
                        <!-- ========================== -->
                        @if (!string.IsNullOrWhiteSpace(pg.ImagePath))
                        {
                            <img src="@pg.ImagePath"
                                 alt="@pg.PGName"
                                 class="card-img-top"
                                 style="
                            height:230px;
                            width:100%;
                            object-fit:cover;
                            " />
                        }
                        else
                        {
                            <div class="d-flex justify-content-center align-items-center bg-light"
                                 style="height:230px;">

                                <div class="text-center">

                                    <i class="bi bi-building text-muted"
                                       style="font-size:70px;">
                                    </i>

                                    <p class="text-muted mb-0 mt-2">
                                        No PG image available
                                    </p>

                                </div>

                            </div>
                        }


                        <!-- ========================== -->
                        <!-- PG DETAILS -->
                        <!-- ========================== -->

                        <div class="card-body">

                            <div class="d-flex justify-content-between align-items-start mb-3">

                                <h4 class="fw-bold mb-0">
                                    @pg.PGName
                                </h4>

                                <span class="badge bg-success">
                                    <i class="bi bi-check-circle"></i>
                                    Approved
                                </span>

                            </div>


                            <hr />


                            <!-- LOCATION -->

                            <p class="mb-2">

                                <i class="bi bi-geo-alt-fill text-primary"></i>

                                <strong>
                                    Location:
                                </strong>

                                @pg.City

                            </p>


                            <!-- ADDRESS -->

                            <p class="mb-2">

                                <i class="bi bi-pin-map-fill text-primary"></i>

                                <strong>
                                    Address:
                                </strong>

                                @pg.Address

                            </p>


                            <!-- GENDER -->

                            <p class="mb-2">

                                <i class="bi bi-people-fill text-primary"></i>

                                <strong>
                                    Gender:
                                </strong>

                                @pg.GenderType

                            </p>


                            <!-- DESCRIPTION -->
                            @if (!string.IsNullOrWhiteSpace(pg.Description))
                            {
                                <p class="text-muted mt-3 mb-3">

                                    @pg.Description

                                </p>
                            }


                            <!-- VIEW DETAILS -->

                            <a asp-controller="UserPG"
                               asp-action="Details"
                               asp-route-id="@pg.PGId"
                               class="btn btn-primary w-100">

                                <i class="bi bi-eye"></i>
                                View Details

                            </a>

                        </div>

                    </div>

                </div>
            }

        </div>
    }

</div>